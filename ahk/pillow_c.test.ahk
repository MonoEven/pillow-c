PillowCInsertJpegXmpApp1(bytes, xmpBytes) {
    AhkTest.AssertTrue(bytes.Length >= 2)
    AhkTest.AssertEqual([0xFF, 0xD8], PillowCArraySlice(bytes, 1, 2))
    header := PillowCTextBytes("http://ns.adobe.com/xap/1.0/")
    header.Push(0)
    segmentLength := header.Length + xmpBytes.Length + 2
    out := [0xFF, 0xD8, 0xFF, 0xE1]
    PillowCAppendBe16(out, segmentLength)
    for value in header
        out.Push(value)
    for value in xmpBytes
        out.Push(value)
    loop bytes.Length - 2
        out.Push(bytes[A_Index + 2])
    return out
}

PillowCInsertJpegCommentSegments(bytes, comments) {
    AhkTest.AssertTrue(bytes.Length >= 4)
    AhkTest.AssertEqual([0xFF, 0xD8], PillowCArraySlice(bytes, 1, 2))
    dqt := PillowCFindJpegSegment(bytes, 0xDB)
    AhkTest.AssertTrue(dqt.Found)
    out := PillowCArraySlice(bytes, 1, dqt.MarkerOffset - 1)
    for comment in comments {
        AhkTest.AssertTrue(comment.Length <= 65533)
        out.Push(0xFF, 0xFE)
        PillowCAppendBe16(out, comment.Length + 2)
        for value in comment
            out.Push(value)
    }
    loop bytes.Length - dqt.MarkerOffset + 1
        out.Push(bytes[dqt.MarkerOffset + A_Index - 1])
    return out
}

PillowCInsertJpegSegmentsBeforeDqt(bytes, segments) {
    AhkTest.AssertTrue(bytes.Length >= 4)
    AhkTest.AssertEqual([0xFF, 0xD8], PillowCArraySlice(bytes, 1, 2))
    dqt := PillowCFindJpegSegment(bytes, 0xDB)
    AhkTest.AssertTrue(dqt.Found)
    out := PillowCArraySlice(bytes, 1, dqt.MarkerOffset - 1)
    for segment in segments {
        AhkTest.AssertTrue(segment.Length >= 4)
        AhkTest.AssertEqual(0xFF, segment[1])
        for value in segment
            out.Push(value)
    }
    loop bytes.Length - dqt.MarkerOffset + 1
        out.Push(bytes[dqt.MarkerOffset + A_Index - 1])
    return out
}

PillowCJpegApp2Segment(payload) {
    segment := [0xFF, 0xE2]
    PillowCAppendBe16(segment, payload.Length + 2)
    for value in payload
        segment.Push(value)
    return segment
}

PillowCJpegIccApp2Segment(sequenceNumber, segmentCount, dataBytes) {
    payload := PillowCTextBytes("ICC_PROFILE")
    payload.Push(0, sequenceNumber, segmentCount)
    for value in dataBytes
        payload.Push(value)
    return PillowCJpegApp2Segment(payload)
}

PillowCInsertJpegSegmentAfterMarker(bytes, marker, segment) {
    found := PillowCFindJpegSegment(bytes, marker)
    AhkTest.AssertTrue(found.Found)
    AhkTest.AssertTrue(found.Length >= 2)
    endOffset := found.MarkerOffset + found.Length + 1
    out := PillowCArraySlice(bytes, 1, endOffset)
    for value in segment
        out.Push(value)
    loop bytes.Length - endOffset
        out.Push(bytes[endOffset + A_Index])
    return out
}

PillowCIcoEntrySizes(path) {
    bytes := PillowCReadFileBytes(path)
    AhkTest.AssertEqual([0, 0, 1, 0], PillowCArraySlice(bytes, 1, 4))
    count := PillowCReadLe16(bytes, 5)
    sizes := []
    loop count {
        entryStart := 7 + (A_Index - 1) * 16
        width := bytes[entryStart] = 0 ? 256 : bytes[entryStart]
        height := bytes[entryStart + 1] = 0 ? 256 : bytes[entryStart + 1]
        payloadOffset := PillowCReadLe32(bytes, entryStart + 12)
        AhkTest.AssertEqual([137, 80, 78, 71, 13, 10, 26, 10], PillowCArraySlice(bytes, payloadOffset + 1, payloadOffset + 8))
        sizes.Push([width, height])
    }
    return sizes
}

PillowCIcoPngEntryPayload(path, expectedWidth, expectedHeight) {
    bytes := PillowCReadFileBytes(path)
    AhkTest.AssertEqual([0, 0, 1, 0], PillowCArraySlice(bytes, 1, 4))
    count := PillowCReadLe16(bytes, 5)
    loop count {
        entryStart := 7 + (A_Index - 1) * 16
        width := bytes[entryStart] = 0 ? 256 : bytes[entryStart]
        height := bytes[entryStart + 1] = 0 ? 256 : bytes[entryStart + 1]
        if width != expectedWidth || height != expectedHeight
            continue
        payloadLength := PillowCReadLe32(bytes, entryStart + 8)
        payloadOffset := PillowCReadLe32(bytes, entryStart + 12)
        AhkTest.AssertEqual([137, 80, 78, 71, 13, 10, 26, 10], PillowCArraySlice(bytes, payloadOffset + 1, payloadOffset + 8))
        return PillowCArraySlice(bytes, payloadOffset + 1, payloadOffset + payloadLength)
    }
    AhkTest.Fail("Expected ICO PNG entry " expectedWidth "x" expectedHeight)
}

PillowCAssertIcoPngEntryFirstPixel(path, expectedWidth, expectedHeight, expectedPixel) {
    pngPath := PillowCTempPngPath("ico-entry-" expectedWidth "x" expectedHeight)
    image := 0
    try {
