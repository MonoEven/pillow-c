PillowCTestImageOpenJpegSegmentedExifConcatenatesAndKeepsFirstOrientation(*) {
    rgb := PillowCCreateImageMode(16, 8, 3)
    sourcePath := PillowCTempJpegPath("segmented-exif-source")
    savePath := PillowCTempJpegPath("segmented-exif-explicit-save")
    handles := []
    try {
        PillowCImageSaveJpeg(rgb, sourcePath)
        firstSegment := PillowCExifOrientationSegment(3)
        secondSegment := PillowCExifOrientationSegment(6)
        firstPayload := PillowCArraySlice(firstSegment, 5, firstSegment.Length)
        secondPayload := PillowCArraySlice(secondSegment, 5, secondSegment.Length)
        combinedExif := PillowCArraySlice(firstPayload, 1, firstPayload.Length)
        loop secondPayload.Length - 6
            combinedExif.Push(secondPayload[A_Index + 6])
        sourceBytes := PillowCInsertJpegSegmentsBeforeDqt(
            PillowCReadFileBytes(sourcePath), [firstSegment, secondSegment])
        PillowCWriteFileBytes(sourcePath, sourceBytes)
        prefix := [0x45, 0x78, 0x69, 0x66, 0, 0]
        sourceSegments := PillowCFindJpegSegments(sourceBytes, 0xE1, prefix)
        AhkTest.AssertEqual(2, sourceSegments.Length)
        sourceDqt := PillowCReadJpegDqtPayloads(sourcePath)

        opened := PillowCImageOpenJpeg(sourcePath)
        handles.Push(opened)
        openedExif := PillowCImageMetadataJpegBlob(
            opened, "pillow_c_image_metadata_jpeg_exif").Bytes
        AhkTest.AssertEqual(combinedExif, openedExif)
        AhkTest.AssertEqual(3, PillowCImageExifOrientation(opened))

        qtables := PillowCImageMetadataJpegQTables(opened)
        subsampling := PillowCImageMetadataJpegSubsampling(opened)
        status := PillowCImageSaveJpegQTablesMetadataEncodeOptionsStatus(
            opened, savePath, -1, 0, 0.0, 0.0,
            [], [], openedExif, qtables, subsampling, -1, -1)
        PillowCAssertStatus(status)
        savedBytes := PillowCReadFileBytes(savePath)
        savedSegments := PillowCFindJpegSegments(savedBytes, 0xE1, prefix)
        AhkTest.AssertEqual(1, savedSegments.Length)
        AhkTest.AssertEqual(combinedExif, PillowCArraySlice(
            savedBytes, savedSegments[1].PayloadOffset,
            savedSegments[1].PayloadOffset + savedSegments[1].PayloadLength - 1))
        savedDqt := PillowCReadJpegDqtPayloads(savePath)
        AhkTest.AssertEqual(sourceDqt[1].Values, savedDqt[1].Values)
        AhkTest.AssertEqual(sourceDqt[2].Values, savedDqt[2].Values)

        loaded := PillowCImageOpenJpeg(savePath)
        handles.Push(loaded)
        AhkTest.AssertEqual(combinedExif, PillowCImageMetadataJpegBlob(
            loaded, "pillow_c_image_metadata_jpeg_exif").Bytes)
        AhkTest.AssertEqual(3, PillowCImageExifOrientation(loaded))
    } finally {
        for handle in handles {
            if handle
                PillowCFreeImage(handle)
        }
        PillowCDeleteFile(savePath)
        PillowCDeleteFile(sourcePath)
        PillowCFreeImage(rgb)
    }
}

AhkTest.Test("pillow_c image open_jpeg segmented EXIF APP1 concatenates payloads and keeps first orientation", PillowCTestImageOpenJpegSegmentedExifConcatenatesAndKeepsFirstOrientation)

