PillowCTestImageQuantizeAlgorithmOptionsUseNativeMethods(*) {
    source := PillowCCreateImageMode(8, 4, 3)
    handles := []
    try {
        PillowCImageSetBytes(source, PillowCQuantizeStressRgbBytes(8, 4))
        median := PillowCImageQuantizeOptions(source, 4, 0, 0, 0)
        maxCoverage := PillowCImageQuantizeOptions(source, 4, 1, 0, 0)
        fastOctree := PillowCImageQuantizeOptions(source, 4, 2, 0, 0)
        refined := PillowCImageQuantizeOptions(source, 4, 0, 2, 0)
        handles := [median, maxCoverage, fastOctree, refined]

        for handle in handles {
            AhkTest.AssertEqual(6, PillowCImageMode(handle))
            AhkTest.AssertEqual([8, 4], [
                PillowCImageInt(handle, "pillow_c_image_width"),
                PillowCImageInt(handle, "pillow_c_image_height"),
            ])
            AhkTest.AssertEqual(32, PillowCImageToArray(handle, 32).Length)
            palette := PillowCImageGetPaletteRgb(handle)
            AhkTest.AssertTrue(palette.Length > 0 && palette.Length <= 12)
        }

        medianPalette := PillowCImageGetPaletteRgb(median)
        maxPalette := PillowCImageGetPaletteRgb(maxCoverage)
        fastPalette := PillowCImageGetPaletteRgb(fastOctree)
        refinedPalette := PillowCImageGetPaletteRgb(refined)
        maxDifferences := 0
        fastDifferences := 0
        refinedDifferences := 0
        for index, value in medianPalette {
            if index <= maxPalette.Length && value != maxPalette[index]
                maxDifferences += 1
            if index <= fastPalette.Length && value != fastPalette[index]
                fastDifferences += 1
            if index <= refinedPalette.Length && value != refinedPalette[index]
                refinedDifferences += 1
        }
        AhkTest.AssertTrue(maxDifferences > 0)
        AhkTest.AssertTrue(fastDifferences > 0)
        AhkTest.AssertTrue(refinedDifferences > 0)
    } finally {
        for handle in handles {
            if handle
                PillowCFreeImage(handle)
        }
        PillowCFreeImage(source)
    }
}

