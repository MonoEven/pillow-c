                "Double", 0.25,
                "Ptr", fixture[3],
                "Int"
            )
            AhkTest.AssertEqual(-3, status)
        }
    } finally {
        if outHandle
            PillowCFreeImage(outHandle)
        for handle in [modeFTarget, modeFRight, modeFLeft, modeITarget, modeIRight, modeILeft] {
