            [first, second], path, [10, 20], 0, [0, 0], -1, -1, 1, 1, comment)

        bytes := PillowCReadFileBytes(path)
        netscapeOffset := PillowCFindBytePattern(bytes, [
            33, 255, 11, 78, 69, 84, 83, 67, 65, 80, 69, 50, 46, 48,
