        50, 56, 32, 49, 50, 58, 51, 52, 58, 53, 54, 0, 255, 255, 255, 255,
        0, 0, 0, 2, 72, 0, 105, 0, 0, 0
    ]
    asciiEntries := [
        [271, "ACME"],
        [305, "pillow-c"],
        [306, "2026:06:28 12:34:56"]
    ]
    intEntries := [
        [256, 123, 4],
        [296, 2, 3],
