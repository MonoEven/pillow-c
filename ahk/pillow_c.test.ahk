        entries := PillowCReadTiffIfd0Entries(bytes)
        AhkTest.AssertEqual(5585, entries[279].Value)
        stripOffset := entries[273].Value + 1
        sliceOffset := stripOffset + 5396
        AhkTest.AssertEqual(expectedBoundarySlice, PillowCArraySlice(bytes, sliceOffset, sliceOffset + expectedBoundarySlice.Length - 1))
    } finally {
        PillowCFreeImage(image)
        PillowCDeleteFile(path)
    }
}

