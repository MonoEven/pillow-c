PillowCMakeInvertLut(channelCount) {
    lut := []
    loop channelCount {
        loop 256
            lut.Push(256 - A_Index)
    }
    return lut
}

PillowCMakeIdentityLut(channelCount) {
    lut := []
    loop channelCount {
        loop 256
            lut.Push(A_Index - 1)
    }
    return lut
}

PillowCConstantArray(count, value) {
    items := []
    loop count
        items.Push(value)
    return items
}

