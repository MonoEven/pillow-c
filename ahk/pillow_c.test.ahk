        "Ptr", pathBytes,
        "Int", width,
        "Int", height,
        "Int", requireRequestedSize,
        "Ptr", 0,
        "UPtr", 0,
        "UPtr*", &required,
        "Int"
    )
    if status != -1
        PillowCAssertStatus(status)
    if required = 0
        return ""
    formatBytes := Buffer(required, 0)
    status := DllCall(
        PillowCDllPath() "\pillow_c_image_ico_payload_format",
