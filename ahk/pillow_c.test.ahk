#Requires AutoHotkey v2.0
#Include <stdlib\ahktest>

PillowCDllPath() {
    static dllPath := ""
    static dllHandle := 0
    if dllPath = "" {
        SplitPath A_LineFile, , &ahkDir
        dllPath := ahkDir "\..\build\x64\Release\pillow_c.dll"
    }
    if !dllHandle {
        dllHandle := DllCall("kernel32\LoadLibraryW", "Str", dllPath, "Ptr")
        if !dllHandle
            throw Error("pillow_c: failed to load DLL " dllPath " (GetLastError " A_LastError ")", -1)
    }
    return dllPath
}

PillowCBuffer(values) {
    buf := Buffer(values.Length, 0)
    for index, value in values
        NumPut("UChar", value, buf, index - 1)
    return buf
}

PillowCBufferToArray(buf) {
    values := []
    loop buf.Size
        values.Push(NumGet(buf, A_Index - 1, "UChar"))
    return values
}

PillowCBytesFromI32(values) {
    buf := Buffer(values.Length * 4, 0)
    for index, value in values
        NumPut("Int", value, buf, (index - 1) * 4)
    return PillowCBufferToArray(buf)
}

PillowCBytesFromF32(values) {
    buf := Buffer(values.Length * 4, 0)
    for index, value in values
        NumPut("Float", value, buf, (index - 1) * 4)
    return PillowCBufferToArray(buf)
}

PillowCTextBytes(text) {
    buf := Buffer(StrPut(text, "UTF-8"), 0)
    StrPut(text, buf, "UTF-8")
    values := []
    loop buf.Size - 1
        values.Push(NumGet(buf, A_Index - 1, "UChar"))
    return values
}

PillowCArraySlice(values, firstIndex, lastIndex) {
    out := []
    loop lastIndex - firstIndex + 1
        out.Push(values[firstIndex + A_Index - 1])
    return out
}

PillowCFindBytePattern(values, pattern, startIndex := 1) {
    if pattern.Length = 0
        return startIndex
    maxStart := values.Length - pattern.Length + 1
    index := startIndex
    while index <= maxStart {
        matched := true
        for patternIndex, value in pattern {
            if values[index + patternIndex - 1] != value {
                matched := false
                break
            }
        }
        if matched
            return index
        index += 1
    }
    return 0
}

PillowCAssertArrayNear(expected, actual, tolerance) {
    AhkTest.AssertEqual(expected.Length, actual.Length)
    for index, expectedValue in expected
        AhkTest.AssertTrue(Abs(expectedValue - actual[index]) <= tolerance)
}

PillowCQuantizeStressRgbBytes(width := 17, height := 17) {
    values := []
    loop height {
        y := A_Index - 1
        loop width {
            x := A_Index - 1
            values.Push(x * 15)
            values.Push(y * 15)
            values.Push(Mod((x * 9 + y * 7) * 3, 256))
        }
    }
    return values
}

PillowCQuantizeStressRgbaBytes(width := 18, height := 18) {
    values := []
    loop height {
        y := A_Index - 1
        loop width {
            x := A_Index - 1
            if (x = 0 && y = 0) || (x = 5 && y = 7) || (x = 17 && y = 17) {
                values.Push(1 + x)
                values.Push(2 + y)
                values.Push(3 + x + y)
                values.Push(0)
            } else {
                values.Push(Mod(x * 13 + y * 5, 256))
                values.Push(Mod(x * 17 + y * 11, 256))
                values.Push(Mod((x * 7 + y * 19) * 3, 256))
                values.Push(Mod(x + y, 5) = 0 ? 1 : 255)
            }
        }
    }
    return values
}

PillowCAssertRgbApproximation(source, actual, maxChannelLimit, maxAverageManhattan) {
    AhkTest.AssertEqual(source.Length, actual.Length)
    maxChannel := 0
    totalManhattan := 0
    pixelCount := source.Length // 3
    loop source.Length // 3 {
        offset := (A_Index - 1) * 3
        manhattan := 0
        loop 3 {
            delta := Abs(source[offset + A_Index] - actual[offset + A_Index])
            if delta > maxChannel
                maxChannel := delta
            manhattan += delta
        }
        totalManhattan += manhattan
    }
    AhkTest.AssertTrue(maxChannel <= maxChannelLimit)
    AhkTest.AssertTrue(totalManhattan <= maxAverageManhattan * pixelCount)
}

PillowCAssertRgbaGifApproximation(source, actual, maxChannelLimit, maxAverageManhattan) {
    AhkTest.AssertEqual((source.Length // 4) * 3, actual.Length)
    maxChannel := 0
    totalManhattan := 0
    comparedPixels := 0
    loop source.Length // 4 {
        sourceOffset := (A_Index - 1) * 4
        actualOffset := (A_Index - 1) * 3
        if source[sourceOffset + 4] = 0
            continue
        manhattan := 0
        loop 3 {
            delta := Abs(source[sourceOffset + A_Index] - actual[actualOffset + A_Index])
            if delta > maxChannel
                maxChannel := delta
            manhattan += delta
        }
        totalManhattan += manhattan
        comparedPixels += 1
    }
    AhkTest.AssertTrue(comparedPixels > 0)
    AhkTest.AssertTrue(maxChannel <= maxChannelLimit)
    AhkTest.AssertTrue(totalManhattan <= maxAverageManhattan * comparedPixels)
}

PillowCWriteFileBytes(path, values) {
    buf := PillowCBuffer(values)
    file := FileOpen(path, "w")
    try {
        file.RawWrite(buf, buf.Size)
    } finally {
        file.Close()
    }
}

PillowCWriteFileText(path, text) {
    buf := Buffer(StrPut(text, "UTF-8"), 0)
    StrPut(text, buf, "UTF-8")
    file := FileOpen(path, "w")
    try {
        file.RawWrite(buf, buf.Size - 1)
    } finally {
        file.Close()
    }
}

PillowCReadFileBytes(path) {
    file := FileOpen(path, "r")
    try {
        buf := Buffer(file.Length, 0)
        file.RawRead(buf, buf.Size)
        return PillowCBufferToArray(buf)
    } finally {
        file.Close()
    }
}

PillowCReadLe32(values, offset) {
    return values[offset]
        | (values[offset + 1] << 8)
        | (values[offset + 2] << 16)
        | (values[offset + 3] << 24)
}

PillowCReadLe16(values, offset) {
    return values[offset] | (values[offset + 1] << 8)
}

PillowCAppendLe16(values, value) {
    values.Push(value & 0xff)
    values.Push((value >> 8) & 0xff)
}

PillowCAppendLe32(values, value) {
    values.Push(value & 0xff)
    values.Push((value >> 8) & 0xff)
    values.Push((value >> 16) & 0xff)
    values.Push((value >> 24) & 0xff)
}

PillowCAppendLe64(values, value) {
    Loop 8 {
        values.Push(value & 0xff)
        value := value >> 8
    }
}

PillowCAppendBe64(values, value) {
    bytes := []
    Loop 8 {
        bytes.Push(value & 0xff)
        value := value >> 8
    }
    Loop 8
        values.Push(bytes[9 - A_Index])
}

PillowCAppendBigTiffEntry(values, entry, littleEndian := true) {
    append16 := littleEndian ? PillowCAppendLe16 : PillowCAppendBe16
    append64 := littleEndian ? PillowCAppendLe64 : PillowCAppendBe64
    append16.Call(values, entry[1])
    append16.Call(values, entry[2])
    append64.Call(values, entry[3])
    if littleEndian {
        append64.Call(values, entry[4])
        return
    }
    if entry[2] = 3 {
        if entry[1] = 258 && entry[3] > 1 {
            Loop entry[3]
                PillowCAppendBe16(values, 8)
            Loop 8 - entry[3] * 2
                values.Push(0)
        } else {
            PillowCAppendBe16(values, entry[4])
            Loop 6
                values.Push(0)
        }
    } else if entry[2] = 4 {
        PillowCAppendBe32(values, entry[4])
        Loop 4
            values.Push(0)
    } else {
        PillowCAppendBe64(values, entry[4])
    }
}

PillowCByteSwapSamples(values, sampleSize) {
    out := []
    sampleCount := values.Length // sampleSize
    Loop sampleCount {
        offset := (A_Index - 1) * sampleSize
        Loop sampleSize
            out.Push(values[offset + sampleSize - A_Index + 1])
    }
    return out
}

PillowCAppendAsciiZ(values, text, padEven := false) {
    loop StrLen(text)
        values.Push(Ord(SubStr(text, A_Index, 1)) & 0xff)
    values.Push(0)
    if padEven && Mod(values.Length, 2)
        values.Push(0)
}

PillowCGifLzwDecodeIndices(data, minCodeSize, expectedCount) {
    clearCode := 1 << minCodeSize
    endCode := clearCode + 1
    codeSize := minCodeSize + 1
    nextCode := endCode + 1
    table := Map()
    loop clearCode
        table[A_Index - 1] := [A_Index - 1]
    bitPos := 0
    previous := []
    hasPrevious := false
    out := []

    loop {
        code := 0
        hasCode := true
        loop codeSize {
            byteIndex := bitPos // 8 + 1
            if byteIndex > data.Length {
                hasCode := false
                break
            }
            code := code | (((data[byteIndex] >> (bitPos & 7)) & 1) << (A_Index - 1))
            bitPos += 1
        }
        if !hasCode
            break
        if code = clearCode {
            table := Map()
            loop clearCode
                table[A_Index - 1] := [A_Index - 1]
            codeSize := minCodeSize + 1
            nextCode := endCode + 1
            previous := []
            hasPrevious := false
            continue
        }
        if code = endCode
            break
        if table.Has(code) {
            entry := table[code].Clone()
        } else if hasPrevious && code = nextCode {
            entry := previous.Clone()
            entry.Push(previous[1])
        } else {
            AhkTest.Fail("Invalid GIF LZW code")
        }
        for value in entry
            out.Push(value)
        if hasPrevious {
            newEntry := previous.Clone()
            newEntry.Push(entry[1])
            table[nextCode] := newEntry
            nextCode += 1
            if (nextCode = (1 << codeSize) && codeSize < 12)
                codeSize += 1
        }
        previous := entry
        hasPrevious := true
        if out.Length >= expectedCount
            break
    }

    decoded := []
    loop Min(expectedCount, out.Length)
        decoded.Push(out[A_Index])
    return decoded
}

PillowCGifFrameDescriptors(path) {
    bytes := PillowCReadFileBytes(path)
    AhkTest.AssertTrue(bytes.Length >= 13)
    AhkTest.AssertEqual([71, 73, 70], PillowCArraySlice(bytes, 1, 3))
    pos := 14
    logicalPacked := bytes[11]
    backgroundIndex := bytes[12]
    globalColorCount := 0
    globalPaletteHead := []
    if logicalPacked & 0x80 {
        globalColorCount := 1 << ((logicalPacked & 0x07) + 1)
        globalPaletteBytes := globalColorCount * 3
        headLength := Min(globalPaletteBytes, 12)
        if headLength > 0
            globalPaletteHead := PillowCArraySlice(bytes, pos, pos + headLength - 1)
        pos += globalPaletteBytes
    }

    frames := []
    pendingGce := { Packed: 0, DurationCs: -1, Disposal: 0, Transparency: -1 }
    while pos <= bytes.Length {
        introducer := bytes[pos]
        pos += 1
        if introducer = 0x3b
            break
        if introducer = 0x21 {
            label := bytes[pos]
            pos += 1
            if label = 0xf9 {
                blockSize := bytes[pos]
                pos += 1
                packed := bytes[pos]
                durationCs := PillowCReadLe16(bytes, pos + 1)
                transparency := (packed & 0x01) ? bytes[pos + 3] : -1
                pendingGce := {
                    Packed: packed,
                    DurationCs: durationCs,
                    Disposal: (packed >> 2) & 0x07,
                    Transparency: transparency
                }
                pos += blockSize
                AhkTest.AssertEqual(0, bytes[pos])
                pos += 1
            } else {
                blockSize := bytes[pos]
                pos += 1 + blockSize
                while pos <= bytes.Length {
                    subBlockSize := bytes[pos]
                    pos += 1
                    if subBlockSize = 0
                        break
                    pos += subBlockSize
                }
            }
            continue
        }

        AhkTest.AssertEqual(0x2c, introducer)
        left := PillowCReadLe16(bytes, pos)
        top := PillowCReadLe16(bytes, pos + 2)
        width := PillowCReadLe16(bytes, pos + 4)
        height := PillowCReadLe16(bytes, pos + 6)
        flags := bytes[pos + 8]
        pos += 9
        localColorCount := 0
        localPaletteHead := []
        if flags & 0x80 {
            localColorCount := 1 << ((flags & 0x07) + 1)
            localPaletteBytes := localColorCount * 3
            headLength := Min(localPaletteBytes, 12)
            if headLength > 0
                localPaletteHead := PillowCArraySlice(bytes, pos, pos + headLength - 1)
            pos += localColorCount * 3
        }
        lzwMin := bytes[pos]
        pos += 1
        dataBytes := 0
        imageData := []
        while pos <= bytes.Length {
            subBlockSize := bytes[pos]
            pos += 1
            if subBlockSize = 0
                break
            dataBytes += subBlockSize
            loop subBlockSize
                imageData.Push(bytes[pos + A_Index - 1])
            pos += subBlockSize
        }
        frames.Push({
            Left: left,
            Top: top,
            Width: width,
            Height: height,
            Flags: flags,
            BackgroundIndex: backgroundIndex,
            GlobalColorCount: globalColorCount,
            GlobalPaletteHead: globalPaletteHead,
            LocalColorCount: localColorCount,
            LocalPaletteHead: localPaletteHead,
            LzwMin: lzwMin,
            DataBytes: dataBytes,
            Indices: PillowCGifLzwDecodeIndices(imageData, lzwMin, width * height),
            Gce: pendingGce
        })
        pendingGce := { Packed: 0, DurationCs: -1, Disposal: 0, Transparency: -1 }
    }
    return frames
}

PillowCReadBe32(values, offset) {
    return (values[offset] << 24)
        | (values[offset + 1] << 16)
        | (values[offset + 2] << 8)
        | values[offset + 3]
}

PillowCReadBe16(values, offset) {
    return (values[offset] << 8) | values[offset + 1]
}

PillowCReadBufferBe32(values, offset) {
    return (NumGet(values, offset, "UChar") << 24)
        | (NumGet(values, offset + 1, "UChar") << 16)
        | (NumGet(values, offset + 2, "UChar") << 8)
        | NumGet(values, offset + 3, "UChar")
}

PillowCReadBufferBe16(values, offset) {
    return (NumGet(values, offset, "UChar") << 8)
        | NumGet(values, offset + 1, "UChar")
}

PillowCAppendBe16(values, value) {
    values.Push((value >> 8) & 0xff)
    values.Push(value & 0xff)
}

PillowCAppendBe32(values, value) {
    values.Push((value >> 24) & 0xff)
    values.Push((value >> 16) & 0xff)
    values.Push((value >> 8) & 0xff)
    values.Push(value & 0xff)
}

PillowCDeflateWriteBits(writer, value, bitCount) {
    loop bitCount {
        bit := (value >> (A_Index - 1)) & 1
        writer.Accumulator := writer.Accumulator | (bit << writer.BitCount)
        writer.BitCount += 1
        if writer.BitCount = 8 {
            writer.Bytes.Push(writer.Accumulator)
            writer.Accumulator := 0
            writer.BitCount := 0
        }
    }
}

PillowCReverseBits(value, bitCount) {
    out := 0
    loop bitCount
        out := (out << 1) | ((value >> (A_Index - 1)) & 1)
    return out
}

PillowCDeflateWriteFixedSymbol(writer, symbol) {
    if symbol <= 143 {
        code := 0x30 + symbol
        bits := 8
    } else if symbol <= 255 {
        code := 0x190 + symbol - 144
        bits := 9
    } else if symbol <= 279 {
        code := symbol - 256
        bits := 7
    } else {
        code := 0xC0 + symbol - 280
        bits := 8
    }
    PillowCDeflateWriteBits(writer, PillowCReverseBits(code, bits), bits)
}

PillowCDeflateFlush(writer) {
    if writer.BitCount > 0 {
        writer.Bytes.Push(writer.Accumulator)
        writer.Accumulator := 0
        writer.BitCount := 0
    }
}

PillowCZlibFixedRepeat(value, count) {
    writer := { Bytes: [], Accumulator: 0, BitCount: 0 }
    PillowCDeflateWriteBits(writer, 0x03, 3)
    PillowCDeflateWriteFixedSymbol(writer, value)
    repeatCount := (count - 1) // 258
    loop repeatCount {
        PillowCDeflateWriteFixedSymbol(writer, 285)
        PillowCDeflateWriteBits(writer, 0, 5)
    }
    PillowCDeflateWriteFixedSymbol(writer, 256)
    PillowCDeflateFlush(writer)

    out := [0x78, 0x01]
    for byte in writer.Bytes
        out.Push(byte)
    adlerA := Mod(1 + count * value, 65521)
    adlerB := Mod(count + value * ((count * (count + 1)) // 2), 65521)
    PillowCAppendBe32(out, (adlerB << 16) | adlerA)
    return out
}

PillowCAppendPngChunkForRobustness(values, typeBytes, payloadBytes) {
    PillowCAppendBe32(values, payloadBytes.Length)
    for byte in typeBytes
        values.Push(byte)
    for byte in payloadBytes
        values.Push(byte)
    PillowCAppendBe32(values, 0)
}

PillowCOversizedCompressedMetadataPngBytes(chunkKind) {
    repeated := 1 + 258 * 4065
    zlib := PillowCZlibFixedRepeat(65, repeated)
    if chunkKind = "zTXt" {
        metadataType := [0x7A, 0x54, 0x58, 0x74]
        payload := [0x4E, 0x6F, 0x74, 0x65, 0, 0]
    } else if chunkKind = "iTXt" {
        metadataType := [0x69, 0x54, 0x58, 0x74]
        payload := [0x43, 0x6F, 0x6D, 0x6D, 0x65, 0x6E, 0x74, 0, 1, 0, 0, 0]
    } else if chunkKind = "iCCP" {
        metadataType := [0x69, 0x43, 0x43, 0x50]
        payload := [0x49, 0x43, 0x43, 0, 0]
    } else {
        AhkTest.Fail("Unknown compressed PNG metadata chunk kind")
    }
    for byte in zlib
        payload.Push(byte)

    out := [137, 80, 78, 71, 13, 10, 26, 10]
    out.Push(
        0, 0, 0, 13, 73, 72, 68, 82,
        0, 0, 0, 1, 0, 0, 0, 1, 8, 0, 0, 0, 0, 58, 126, 155, 85
    )
    PillowCAppendPngChunkForRobustness(out, metadataType, payload)
    out.Push(
        0, 0, 0, 10, 73, 68, 65, 84, 120, 156, 99, 96, 7, 0, 0, 9,
        0, 8, 32, 35, 195, 140,
        0, 0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130
    )
    return out
}

