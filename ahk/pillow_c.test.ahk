PillowCTestImageOpenTiffReadsPaletteColorMapExifTag(*) {
    image := PillowCCreateImageMode(3, 2, 6)
    path := PillowCTempTiffPath("palette-colormap-tag")
    loaded := 0
    pixels := [0, 1, 2, 1, 0, 2]
    palette := [10, 20, 30, 40, 50, 60, 70, 80, 90]
    try {
        PillowCImageSetBytes(image, pixels)
        PillowCImagePutPaletteRgb(image, palette)
        PillowCImageSaveTiff(image, path)

        loaded := PillowCImageOpenTiff(path)
        exif := PillowCImageMetadataTiffExif(loaded)
        colorMap := PillowCExifUshortArrayTagValue(exif.Exif, 320)

        AhkTest.AssertEqual(6, PillowCImageMode(loaded))
        AhkTest.AssertEqual(pixels, PillowCImageToArray(loaded, 6))
        AhkTest.AssertEqual(palette, PillowCArraySlice(PillowCImageGetPaletteRgb(loaded), 1, 9))
        AhkTest.AssertEqual(1, exif.HasExif)
        AhkTest.AssertEqual(768, colorMap.Length)
        AhkTest.AssertEqual([2560, 10240, 17920], PillowCArraySlice(colorMap, 1, 3))
        AhkTest.AssertEqual([5120, 12800, 20480], PillowCArraySlice(colorMap, 257, 259))
        AhkTest.AssertEqual([7680, 15360, 23040], PillowCArraySlice(colorMap, 513, 515))
        AhkTest.AssertEqual([0], PillowCArraySlice(colorMap, 768, 768))
    } finally {
        if loaded
            PillowCFreeImage(loaded)
        PillowCFreeImage(image)
        PillowCDeleteFile(path)
    }
}

