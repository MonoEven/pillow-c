PillowCImageGifComment(path, frame) {
    hasComment := 0
    required := 0
    pathBytes := PillowCUtf8Buffer(path)
    try {
        status := DllCall(
            PillowCDllPath() "\pillow_c_image_gif_comment",
            "Ptr", pathBytes,
            "Int", frame,
            "Int*", &hasComment,
            "Ptr", 0,
            "UPtr", 0,
            "UPtr*", &required,
            "Int"
        )
    } catch Error as err {
        AhkTest.Fail("Expected pillow_c_image_gif_comment export")
        return { Has: 0, Bytes: [] }
    }
    if status != -1
        PillowCAssertStatus(status)
    if !hasComment
        return { Has: 0, Bytes: [] }
    buf := Buffer(required, 0)
    status := DllCall(
        PillowCDllPath() "\pillow_c_image_gif_comment",
        "Ptr", pathBytes,
        "Int", frame,
        "Int*", &hasComment,
        "Ptr", buf,
        "UPtr", buf.Size,
        "UPtr*", &required,
        "Int"
    )
    PillowCAssertStatus(status)
    bytes := []
    loop required
        bytes.Push(NumGet(buf, A_Index - 1, "UChar"))
    return { Has: hasComment, Bytes: bytes }
}

