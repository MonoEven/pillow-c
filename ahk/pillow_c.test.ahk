            PillowCImageSetRawBytes(source, item.Bytes, item.RawMode)
            sourceData := PillowCImageData(source)
            status := DllCall(PillowCDllPath() "\pillow_c_image_copy", "Ptr", source, "Ptr*", &copied, "Int")
            PillowCAssertStatus(status)

            AhkTest.AssertEqual(item.ModeId, PillowCImageMode(copied))
            AhkTest.AssertEqual([3, 2], [PillowCImageInt(copied, "pillow_c_image_width"), PillowCImageInt(copied, "pillow_c_image_height")])
            AhkTest.AssertEqual(item.Bytes, PillowCImageGetRawBytes(copied, item.RawMode))
            AhkTest.AssertTrue(sourceData.Ptr != PillowCImageData(copied).Ptr)

            NumPut(item.PutType, item.Mutation, sourceData.Ptr, 0)
            AhkTest.AssertEqual(item.Bytes, PillowCImageGetRawBytes(copied, item.RawMode))

            PillowCFreeImage(source)
            source := 0
            AhkTest.AssertEqual(item.Bytes, PillowCImageGetRawBytes(copied, item.RawMode))
        } finally {
            if copied
                PillowCFreeImage(copied)
            if source
                PillowCFreeImage(source)
        }
    }
}

