                    AhkTest.AssertEqual(iccProfile,
                        PillowCImageMetadataJpegBlob(loaded, "pillow_c_image_metadata_jpeg_icc_profile").Bytes)
                    AhkTest.AssertEqual(exif,
                        PillowCImageMetadataJpegBlob(loaded, "pillow_c_image_metadata_jpeg_exif").Bytes)
                } else {
                    AhkTest.AssertEqual(0, PillowCImageExifOrientation(loaded))
                    AhkTest.AssertEqual(0,
                        PillowCImageMetadataJpegBlob(loaded, "pillow_c_image_metadata_jpeg_comment").Has)
                    AhkTest.AssertEqual(0,
                        PillowCImageMetadataJpegBlob(loaded, "pillow_c_image_metadata_jpeg_icc_profile").Has)
                    AhkTest.AssertEqual(0,
                        PillowCImageMetadataJpegBlob(loaded, "pillow_c_image_metadata_jpeg_exif").Has)
                }
            }
        }
    } finally {
