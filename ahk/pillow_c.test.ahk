                    AhkTest.AssertTrue(xmpSegment.MarkerOffset < dqtSegment.MarkerOffset)
                }

                restart := PillowCReadJpegProgressiveRestartStructure(path)
                AhkTest.AssertEqual(testCase.DhtCount, restart.DhtPayloadLengths.Length)
                if testCase.Dht.Length
                    AhkTest.AssertEqual(testCase.Dht, restart.DhtPayloadLengths)
                AhkTest.AssertEqual(testCase.Dri, restart.DriValues)
                AhkTest.AssertEqual(testCase.Rst, restart.ScanRestartMarkers)
                AhkTest.AssertEqual(testCase.Sof, PillowCReadJpegSofMarker(path))
                AhkTest.AssertEqual(testCase.Sampling,
                    PillowCReadJpegSofSampling(path, testCase.Sof))
                AhkTest.AssertEqual(testCase.SosCount, PillowCCountJpegSos(path))
                dqt := PillowCReadJpegDqtPayloads(path)
                AhkTest.AssertEqual(2, dqt.Length)
                AhkTest.AssertEqual(PillowCExpectedJpegDqtPayload(cQTable, 75), dqt[1].Values)
                AhkTest.AssertEqual(PillowCExpectedJpegDqtPayload(mykQTable, 75), dqt[2].Values)

                loaded := PillowCImageOpenJpeg(path)
                loadedHandles.Push(loaded)
                AhkTest.AssertEqual(7, PillowCImageMode(loaded))
                PillowCAssertArrayNear(subsampledExpected,
                    PillowCImageToArray(loaded, subsampledExpected.Length), 1)
                AhkTest.AssertEqual(xmp, PillowCImageMetadataXmp(loaded).Bytes)
                resolution := PillowCImageMetadataResolution(loaded)
                AhkTest.AssertEqual(variant.HasDpi, resolution.HasDpi)
                if variant.Core {
                    PillowCAssertFloatClose(testCase.Dpi[1], resolution.DpiX)
                    PillowCAssertFloatClose(testCase.Dpi[2], resolution.DpiY)
                    AhkTest.AssertEqual(testCase.Dpi, resolution.JfifDensity)
                    AhkTest.AssertEqual(6, PillowCImageExifOrientation(loaded))
                    AhkTest.AssertEqual(comment,
