PillowCTestImagePasteMaskedMatchesPillowNumericStorageBytes(*) {
    maskBytes := [0, 64, 128, 192, 255, 32]
    mask := PillowCCreateImageMode(3, 2, 1)
    try {
        PillowCImageSetBytes(mask, maskBytes)
        cases := [
            {
                ModeId: 8,
                RawMode: "I",
                Source: PillowCBytesFromI32([1000, -1000, 300000, -300000, 5, 123456789]),
                Target: PillowCBytesFromI32([-2000, 2000, -100000, 100000, 6, -123456789]),
                Expected: "30f8ffffa2444040a086817f4072bdc005000000d0459bda",
            },
            {
                ModeId: 9,
                RawMode: "F",
                Source: PillowCBytesFromF32([1.25, -2.5, 100.0, -100.0, 5.5, -6.25]),
                Target: PillowCBytesFromF32([-3.75, 4.5, -50.0, 50.0, -7.5, 8.25]),
                Expected: "000070c000007460000088820000a8a20000b04000001d51",
            },
        ]
        for item in cases {
            source := PillowCCreateImageMode(3, 2, item.ModeId)
            target := PillowCCreateImageMode(3, 2, item.ModeId)
            try {
                PillowCImageSetRawBytes(source, item.Source, item.RawMode)
                PillowCImageSetRawBytes(target, item.Target, item.RawMode)
                targetData := PillowCImageData(target).Ptr

                PillowCImagePasteMasked(target, source, 0, 0, mask)

                AhkTest.AssertEqual(targetData, PillowCImageData(target).Ptr)
                AhkTest.AssertEqual(item.ModeId, PillowCImageMode(target))
                AhkTest.AssertEqual([3, 2], [PillowCImageInt(target, "pillow_c_image_width"), PillowCImageInt(target, "pillow_c_image_height")])
                AhkTest.AssertEqual(item.Expected, PillowCBytesHex(PillowCImageGetRawBytes(target, item.RawMode)))
                AhkTest.AssertEqual(item.Source, PillowCImageGetRawBytes(source, item.RawMode))
                AhkTest.AssertEqual(maskBytes, PillowCImageGetRawBytes(mask, "L"))
            } finally {
                PillowCFreeImage(target)
                PillowCFreeImage(source)
            }
        }
    } finally {
        PillowCFreeImage(mask)
    }
}

