                Progressive: 0,
                Optimize: 0,
                Sof: 0xC0,
                Sampling: [67, 2, 1, 0, 77, 1, 1, 0, 89, 1, 1, 0, 75, 1, 1, 0],
                SosCount: 1,
                Bytes: [0, 42, 79, 148, 10, 42, 79, 148],
                Tolerance: 0
