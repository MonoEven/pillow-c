        optimizedDqt := PillowCFindJpegSegment(optimizedBytes, 0xDB)
        optimizedDri := PillowCFindJpegSegment(optimizedBytes, 0xDD)
        AhkTest.AssertTrue(optimizedApp14.Found)
        AhkTest.AssertEqual(0, optimizedBytes[optimizedApp14.PayloadOffset + 11])
        AhkTest.AssertTrue(optimizedApp14.MarkerOffset < optimizedExif.MarkerOffset)
        AhkTest.AssertTrue(optimizedExif.MarkerOffset < optimizedXmp.MarkerOffset)
        AhkTest.AssertTrue(optimizedXmp.MarkerOffset < optimizedIcc.MarkerOffset)
        AhkTest.AssertTrue(optimizedIcc.MarkerOffset < optimizedComment.MarkerOffset)
        AhkTest.AssertTrue(optimizedComment.MarkerOffset < optimizedDqt.MarkerOffset)
        AhkTest.AssertEqual([23, 46], PillowCReadJpegDhtPayloadLengths(optimizedPath))
        AhkTest.AssertEqual(6, PillowCReadBe16(optimizedBytes, optimizedDri.PayloadOffset))
        AhkTest.AssertEqual([0xD0], PillowCReadJpegRestartMarkers(optimizedPath))
        optimizedLoaded := PillowCImageOpenJpeg(optimizedPath)
        loadedHandles.Push(optimizedLoaded)
        AhkTest.AssertEqual(6, PillowCImageExifOrientation(optimizedLoaded))
        AhkTest.AssertEqual(comment,
            PillowCImageMetadataJpegBlob(optimizedLoaded, "pillow_c_image_metadata_jpeg_comment").Bytes)
        AhkTest.AssertEqual(iccProfile,
            PillowCImageMetadataJpegBlob(optimizedLoaded, "pillow_c_image_metadata_jpeg_icc_profile").Bytes)
        AhkTest.AssertEqual(xmp, PillowCImageMetadataXmp(optimizedLoaded).Bytes)

        rQTable := []
        gbQTable := []
        loop 64 {
            i := A_Index - 1
            rQTable.Push(2 + Mod(i, 8))
            gbQTable.Push(3 + Mod(i, 7))
        }
        qtables := [rQTable, gbQTable]
        status := PillowCImageSaveJpegKeepRgbRestartMarkerEncodeOptionsStatus(
            progressive, progressivePath, 75, comment, iccProfile, exif, xmp, qtables, 1, 1, 0, 1)
        PillowCAssertStatus(status)
        progressiveBytes := PillowCReadFileBytes(progressivePath)
        progressiveApp14 := PillowCFindJpegSegment(progressiveBytes, 0xEE, [65, 100, 111, 98, 101])
        AhkTest.AssertTrue(progressiveApp14.Found)
        AhkTest.AssertEqual(0, progressiveBytes[progressiveApp14.PayloadOffset + 11])
        AhkTest.AssertEqual(0xC2, PillowCReadJpegSofMarker(progressivePath))
        AhkTest.AssertEqual([82, 1, 1, 0, 71, 1, 1, 1, 66, 1, 1, 1],
            PillowCReadJpegSofSampling(progressivePath, 0xC2))
        progressiveDqt := PillowCReadJpegDqtPayloads(progressivePath)
        AhkTest.AssertEqual(2, progressiveDqt.Length)
        AhkTest.AssertEqual(PillowCExpectedJpegDqtPayload(rQTable, 75), progressiveDqt[1].Values)
        AhkTest.AssertEqual(PillowCExpectedJpegDqtPayload(gbQTable, 75), progressiveDqt[2].Values)
        progressiveRestart := PillowCReadJpegProgressiveRestartStructure(progressivePath)
        AhkTest.AssertEqual([24, 27, 28, 26, 34, 39, 37, 28, 31, 24, 27, 24, 25],
            progressiveRestart.DhtPayloadLengths)
        AhkTest.AssertEqual([6], progressiveRestart.DriValues)
        expectedScanRestarts := []
        loop 14
            expectedScanRestarts.Push([0xD0, 0xD1, 0xD2])
        AhkTest.AssertEqual(expectedScanRestarts, progressiveRestart.ScanRestartMarkers)
        progressiveLoaded := PillowCImageOpenJpeg(progressivePath)
        loadedHandles.Push(progressiveLoaded)
        AhkTest.AssertEqual(3, PillowCImageMode(progressiveLoaded))
        AhkTest.AssertEqual(4608, PillowCImageSize(progressiveLoaded))
        progressiveDecoded := PillowCImageToArray(progressiveLoaded, 4608)
        progressiveMaxError := 0
        for index, value in progressiveValues
            progressiveMaxError := Max(progressiveMaxError, Abs(value - progressiveDecoded[index]))
        AhkTest.AssertTrue(progressiveMaxError <= 4)
        AhkTest.AssertEqual(6, PillowCImageExifOrientation(progressiveLoaded))
        AhkTest.AssertEqual(comment,
            PillowCImageMetadataJpegBlob(progressiveLoaded, "pillow_c_image_metadata_jpeg_comment").Bytes)
        AhkTest.AssertEqual(iccProfile,
            PillowCImageMetadataJpegBlob(progressiveLoaded, "pillow_c_image_metadata_jpeg_icc_profile").Bytes)
        AhkTest.AssertEqual(xmp, PillowCImageMetadataXmp(progressiveLoaded).Bytes)
    } finally {
        for loaded in loadedHandles
            PillowCFreeImage(loaded)
        PillowCDeleteFile(progressivePath)
        PillowCDeleteFile(optimizedPath)
        PillowCDeleteFile(baselinePath)
        PillowCFreeImage(progressive)
        PillowCFreeImage(optimized)
        PillowCFreeImage(baseline)
    }
}

