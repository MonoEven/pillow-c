PillowCTestImageSaveJpegOpenedRgbQTablesKeepExplicitIntegerSubsamplingRestartStrategiesNativeRoute(*) {
    rgb := PillowCCreateImageMode(48, 32, 3)
    sourcePath := PillowCTempJpegPath("opened-qkeep-integer-subsampling-source")
    baseline444Path := PillowCTempJpegPath("opened-qkeep-integer-subsampling-444")
    optimized422Path := PillowCTempJpegPath("opened-qkeep-integer-subsampling-422")
    progressive420Path := PillowCTempJpegPath("opened-qkeep-integer-subsampling-420")
    outputPaths := [baseline444Path, optimized422Path, progressive420Path]
    handles := []
    try {
        values := []
        loop 32 {
            y := A_Index - 1
            loop 48 {
                x := A_Index - 1
                values.Push(Mod(x * 17 + y * 3, 256))
                values.Push(Mod(x * 5 + y * 29, 256))
                values.Push(Mod(x * 11 + y * 7, 256))
            }
        }
        PillowCImageSetBytes(rgb, values)

        lumaQTable := []
        chromaQTable := []
        loop 64 {
            index := A_Index - 1
            lumaQTable.Push(3 + Mod(index * 7, 57))
            chromaQTable.Push(5 + Mod(index * 11, 61))
        }
        sourceComment := PillowCTextBytes("opened-qkeep-integer-subsampling")
        sourceIcc := PillowCTextBytes("ICC-SOURCE")
        sourceExif := PillowCArraySlice(PillowCExifOrientationSegment(3), 5, 36)
        status := PillowCImageSaveJpegQTablesMetadataEncodeOptionsStatus(
            rgb, sourcePath, -1, 0, 0.0, 0.0,
            sourceComment, sourceIcc, sourceExif, [lumaQTable, chromaQTable], 1, -1, -1)
        PillowCAssertStatus(status)
        sourceDqt := PillowCReadJpegDqtPayloads(sourcePath)

        opened := PillowCImageOpenJpeg(sourcePath)
        handles.Push(opened)
        qtables := PillowCImageMetadataJpegQTables(opened)
        openedComment := PillowCImageMetadataJpegBlob(
            opened, "pillow_c_image_metadata_jpeg_comment").Bytes
        explicitIcc := PillowCTextBytes("ICC-EXPLICIT")
        explicitExif := PillowCArraySlice(PillowCExifOrientationSegment(6), 5, 36)
        nativeCases := [
            { Path: baseline444Path, Subsampling: 0, Progressive: 0, Optimize: 0 },
            { Path: optimized422Path, Subsampling: 1, Progressive: 0, Optimize: 1 },
            { Path: progressive420Path, Subsampling: 2, Progressive: 1, Optimize: 1 }
        ]
        for testCase in nativeCases {
            status := PillowCImageSaveJpegQTablesMetadataRestartMarkerEncodeOptionsStatus(
                opened, testCase.Path, -1, openedComment, explicitIcc, explicitExif, [],
                qtables, testCase.Subsampling, testCase.Progressive,
                testCase.Optimize, 0, 1)
            PillowCAssertStatus(status)
        }

        sampling444 := [1, 1, 1, 0, 2, 1, 1, 1, 3, 1, 1, 1]
        sampling422 := [1, 2, 1, 0, 2, 1, 1, 1, 3, 1, 1, 1]
        sampling420 := [1, 2, 2, 0, 2, 1, 1, 1, 3, 1, 1, 1]
        progressive420Restarts := [
            [0xD0],
            [0xD0, 0xD1, 0xD2],
            [0xD0],
            [0xD0],
            [0xD0, 0xD1, 0xD2],
            [0xD0, 0xD1, 0xD2],
            [0xD0],
            [0xD0],
            [0xD0],
            [0xD0, 0xD1, 0xD2]
        ]
        testCases := [
            { Path: baseline444Path, Sof: 0xC0, Sampling: sampling444,
                Dri: [6], Restarts: [[0xD0, 0xD1, 0xD2]], DhtShape: "standard", SosCount: 1 },
            { Path: optimized422Path, Sof: 0xC0, Sampling: sampling422,
                Dri: [3], Restarts: [[0xD0, 0xD1, 0xD2]], DhtShape: "compact", SosCount: 1 },
            { Path: progressive420Path, Sof: 0xC2, Sampling: sampling420,
                Dri: [3, 6, 3, 6, 3, 6], Restarts: progressive420Restarts,
                DhtShape: "progressive", SosCount: 10 }
        ]
        for testCase in testCases {
            savedDqt := PillowCReadJpegDqtPayloads(testCase.Path)
            AhkTest.AssertEqual(sourceDqt[1].Values, savedDqt[1].Values)
            AhkTest.AssertEqual(sourceDqt[2].Values, savedDqt[2].Values)
            AhkTest.AssertEqual(testCase.Sof, PillowCReadJpegSofMarker(testCase.Path))
            actualSampling := testCase.Sof = 0xC0
                ? PillowCReadJpegSof0Sampling(testCase.Path)
                : PillowCReadJpegSofSampling(testCase.Path, 0xC2)
            AhkTest.AssertEqual(testCase.Sampling, actualSampling)
            AhkTest.AssertEqual(testCase.SosCount, PillowCCountJpegSos(testCase.Path))
            restart := PillowCReadJpegProgressiveRestartStructure(testCase.Path)
            if testCase.DhtShape = "standard" {
                AhkTest.AssertEqual([29, 179, 29, 179], restart.DhtPayloadLengths)
            } else if testCase.DhtShape = "compact" {
                AhkTest.AssertEqual(4, restart.DhtPayloadLengths.Length)
                AhkTest.AssertTrue(restart.DhtPayloadLengths[1] < 29)
                AhkTest.AssertTrue(restart.DhtPayloadLengths[2] < 179)
                AhkTest.AssertTrue(restart.DhtPayloadLengths[3] < 29)
                AhkTest.AssertTrue(restart.DhtPayloadLengths[4] < 179)
            } else {
                AhkTest.AssertEqual(10, restart.DhtPayloadLengths.Length)
            }
            AhkTest.AssertEqual(testCase.Dri, restart.DriValues)
            AhkTest.AssertEqual(testCase.Restarts, restart.ScanRestartMarkers)

            loaded := PillowCImageOpenJpeg(testCase.Path)
            handles.Push(loaded)
            AhkTest.AssertEqual(3, PillowCImageMode(loaded))
            AhkTest.AssertEqual(4608, PillowCImageSize(loaded))
            AhkTest.AssertEqual(6, PillowCImageExifOrientation(loaded))
            AhkTest.AssertEqual(openedComment,
                PillowCImageMetadataJpegBlob(loaded, "pillow_c_image_metadata_jpeg_comment").Bytes)
            AhkTest.AssertEqual(explicitIcc,
                PillowCImageMetadataJpegBlob(loaded, "pillow_c_image_metadata_jpeg_icc_profile").Bytes)
        }
    } finally {
        for handle in handles {
            if handle
                PillowCFreeImage(handle)
        }
        for path in outputPaths
            PillowCDeleteFile(path)
        PillowCDeleteFile(sourcePath)
        PillowCFreeImage(rgb)
    }
}

