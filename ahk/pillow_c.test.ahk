PillowCTestImageOpenJpegIgnoresIccApp2AfterSof0(*) {
    rgb := PillowCCreateImageMode(16, 8, 3)
    sourcePath := PillowCTempJpegPath("icc-after-sof-source")
    savePath := PillowCTempJpegPath("icc-after-sof-explicit")
    handles := []
    try {
        lateIcc := PillowCTextBytes("Late")
        explicitIcc := PillowCTextBytes("Explicit")
        PillowCImageSaveJpeg(rgb, sourcePath)
        sourceBytes := PillowCInsertJpegSegmentAfterMarker(
            PillowCReadFileBytes(sourcePath), 0xC0,
            PillowCJpegIccApp2Segment(1, 1, lateIcc))
        PillowCWriteFileBytes(sourcePath, sourceBytes)
        header := PillowCTextBytes("ICC_PROFILE")
        header.Push(0)
        sof := PillowCFindJpegSegment(sourceBytes, 0xC0)
        sourceSegments := PillowCFindJpegSegments(sourceBytes, 0xE2, header)
        AhkTest.AssertEqual(1, sourceSegments.Length)
        AhkTest.AssertTrue(sourceSegments[1].MarkerOffset > sof.MarkerOffset)

        opened := PillowCImageOpenJpeg(sourcePath)
        handles.Push(opened)
        AhkTest.AssertEqual(0, PillowCImageMetadataJpegBlob(
            opened, "pillow_c_image_metadata_jpeg_icc_profile").Has)

        sourceDqt := PillowCReadJpegDqtPayloads(sourcePath)
        qtables := PillowCImageMetadataJpegQTables(opened)
        subsampling := PillowCImageMetadataJpegSubsampling(opened)
        status := PillowCImageSaveJpegQTablesMetadataEncodeOptionsStatus(
            opened, savePath, -1, 0, 0.0, 0.0,
            [], explicitIcc, [], qtables, subsampling, -1, -1)
        PillowCAssertStatus(status)
        savedBytes := PillowCReadFileBytes(savePath)
        savedSegments := PillowCFindJpegSegments(savedBytes, 0xE2, header)
        savedSof := PillowCFindJpegSegment(savedBytes, 0xC0)
        AhkTest.AssertEqual(1, savedSegments.Length)
        AhkTest.AssertTrue(savedSegments[1].MarkerOffset < savedSof.MarkerOffset)
        AhkTest.AssertEqual([1, 1, 69, 120, 112, 108, 105, 99, 105, 116],
            PillowCArraySlice(
                savedBytes, savedSegments[1].PayloadOffset + header.Length,
                savedSegments[1].PayloadOffset + savedSegments[1].PayloadLength - 1))
        savedDqt := PillowCReadJpegDqtPayloads(savePath)
        AhkTest.AssertEqual(sourceDqt[1].Values, savedDqt[1].Values)
        AhkTest.AssertEqual(sourceDqt[2].Values, savedDqt[2].Values)

        loaded := PillowCImageOpenJpeg(savePath)
        handles.Push(loaded)
        AhkTest.AssertEqual(explicitIcc, PillowCImageMetadataJpegBlob(
            loaded, "pillow_c_image_metadata_jpeg_icc_profile").Bytes)
    } finally {
        for handle in handles {
            if handle
                PillowCFreeImage(handle)
        }
        PillowCDeleteFile(savePath)
        PillowCDeleteFile(sourcePath)
        PillowCFreeImage(rgb)
    }
}

