PillowCTestImageSaveTiffI16BigEndianUncompressedDpiIccXmpArtistCompose(*) {
    pixels := [0, 1, 0, 255, 1, 0, 18, 52]
    icc := [73, 67, 67, 0, 68, 65, 84, 65]
    xmp := PillowCTextBytes(PillowCXmpPacket())
    artist := PillowCTextBytes("Ada")
    artist.Push(0)
    image := PillowCCreateImageMode(2, 2, 12)
    path := PillowCTempTiffPath("i16b-uncompressed-dpi-icc-xmp-artist")
    loaded := 0
    try {
        PillowCImageSetBytes(image, pixels)
        handles := Buffer(A_PtrSize, 0)
        NumPut("Ptr", image, handles)
        status := DllCall(
            PillowCDllPath() "\pillow_c_image_save_tiff_frames_metadata_ascii_options",
            "Ptr", handles, "UPtr", 1, "Ptr", PillowCUtf8Buffer(path),
            "Int", 1, "Double", 300.0, "Double", 150.0, "Int", 1,
            "Ptr", PillowCBuffer(icc), "UPtr", icc.Length,
            "Ptr", PillowCBuffer(xmp), "UPtr", xmp.Length,
            "Int", 315, "Ptr", PillowCBuffer(artist), "UPtr", artist.Length,
            "Int"
        )
        AhkTest.AssertEqual(0, status)
        AhkTest.AssertEqual(12, PillowCImageMode(image))
        AhkTest.AssertEqual(pixels, PillowCImageToArray(image, pixels.Length))

        bytes := PillowCReadFileBytes(path)
        AhkTest.AssertEqual(550, bytes.Length)
        AhkTest.AssertEqual([77, 77, 0, 42], PillowCArraySlice(bytes, 1, 4))
        entries := PillowCReadTiffIfd0EntriesEndian(bytes, false)
        AhkTest.AssertEqual(15, PillowCReadBe16(bytes, PillowCReadBe32(bytes, 5) + 1))
        AhkTest.AssertEqual(2, entries[315].Type)
        AhkTest.AssertEqual(4, entries[315].Count)
        AhkTest.AssertEqual(0x41646100, entries[315].Value)
        AhkTest.AssertEqual(194, entries[282].Value)
        AhkTest.AssertEqual(202, entries[283].Value)
        AhkTest.AssertEqual(210, entries[700].Value)
        AhkTest.AssertEqual(534, entries[34675].Value)
        AhkTest.AssertEqual(542, entries[273].Value)
        AhkTest.AssertEqual(xmp, PillowCArraySlice(bytes, 211, 534))
        AhkTest.AssertEqual(icc, PillowCArraySlice(bytes, 535, 542))
        AhkTest.AssertEqual(pixels, PillowCArraySlice(bytes, 543, 550))

        loaded := PillowCImageOpenTiff(path)
        AhkTest.AssertEqual(12, PillowCImageMode(loaded))
        AhkTest.AssertEqual(pixels, PillowCImageToArray(loaded, pixels.Length))
        resolution := PillowCImageMetadataResolution(loaded)
        PillowCAssertFloatClose(300.0, resolution.DpiX)
        PillowCAssertFloatClose(150.0, resolution.DpiY)
        AhkTest.AssertEqual(icc, PillowCImageMetadataJpegBlob(
            loaded, "pillow_c_image_metadata_tiff_icc_profile"
        ).Bytes)
        AhkTest.AssertEqual(xmp, PillowCImageMetadataXmp(loaded).Bytes)
        exif := PillowCImageMetadataTiffExif(loaded)
        AhkTest.AssertEqual("Ada", PillowCExifAsciiTagValue(exif.Exif, 315))
        AhkTest.AssertEqual(xmp, PillowCExifUndefinedTagValue(exif.Exif, 700))
        AhkTest.AssertEqual(icc, PillowCExifUndefinedTagValue(exif.Exif, 34675))
    } finally {
        if loaded
            PillowCFreeImage(loaded)
        PillowCFreeImage(image)
        PillowCDeleteFile(path)
    }
}

