            "Ptr", profile,
            "Int"
        ))
        references := 1

        required := 0
        PillowCAssertStatus(DllCall(
            PillowCDllPath() "\pillow_c_cms_profile_name",
            "Ptr", profile,
            "Ptr", 0,
            "UPtr", 0,
            "UPtr*", &required,
            "Int"
        ))
        descriptionBytes := Buffer(required, 0)
        PillowCAssertStatus(DllCall(
            PillowCDllPath() "\pillow_c_cms_profile_name",
            "Ptr", profile,
            "Ptr", descriptionBytes,
            "UPtr", descriptionBytes.Size,
            "UPtr*", &required,
            "Int"
        ))
        AhkTest.AssertEqual(
            expectedDescription,
            StrGet(descriptionBytes.Ptr, required - 1, "UTF-8")
        )

        PillowCAssertStatus(DllCall(
