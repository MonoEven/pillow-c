            0xFF, 0xFE, 0x00, 0x08, 0x45, 0x58, 0x54, 0x52, 0x41, 0x21
        ]
        comment := PillowCTextBytes("COMMENT")
        iccProfile := [1, 2, 3, 4, 5, 6, 7, 8]
        exif := PillowCArraySlice(PillowCExifOrientationSegment(6), 5, 36)
        xmp := PillowCTextBytes(PillowCXmpPacket())
        status := PillowCImageSaveJpegMetadataExtraEncodeOptionsStatus(
            rgb, path, 75, 0, 0.0, 0.0, comment, iccProfile, exif, xmp,
            -1, -1, -1, extra)
        PillowCAssertStatus(status)

        bytes := PillowCReadFileBytes(path)
        exifSegment := PillowCFindJpegSegment(bytes, 0xE1, [69, 120, 105, 102, 0, 0])
        app13 := PillowCFindJpegSegment(bytes, 0xED)
        rawComments := PillowCFindJpegSegments(bytes, 0xFE)
        xmpHeader := PillowCTextBytes("http://ns.adobe.com/xap/1.0/")
        xmpHeader.Push(0)
        xmpSegment := PillowCFindJpegSegment(bytes, 0xE1, xmpHeader)
        iccHeader := PillowCTextBytes("ICC_PROFILE")
        iccHeader.Push(0, 1, 1)
        iccSegment := PillowCFindJpegSegment(bytes, 0xE2, iccHeader)
        dqt := PillowCFindJpegSegment(bytes, 0xDB)
        AhkTest.AssertTrue(exifSegment.Found)
        AhkTest.AssertTrue(app13.Found)
        AhkTest.AssertEqual(2, rawComments.Length)
        AhkTest.AssertTrue(xmpSegment.Found)
        AhkTest.AssertTrue(iccSegment.Found)
        AhkTest.AssertTrue(dqt.Found)
        AhkTest.AssertTrue(exifSegment.MarkerOffset < app13.MarkerOffset)
        AhkTest.AssertTrue(app13.MarkerOffset < rawComments[1].MarkerOffset)
        AhkTest.AssertTrue(rawComments[1].MarkerOffset < xmpSegment.MarkerOffset)
        AhkTest.AssertTrue(xmpSegment.MarkerOffset < iccSegment.MarkerOffset)
        AhkTest.AssertTrue(iccSegment.MarkerOffset < rawComments[2].MarkerOffset)
        AhkTest.AssertTrue(rawComments[2].MarkerOffset < dqt.MarkerOffset)
        AhkTest.AssertEqual(exif,
            PillowCArraySlice(bytes, exifSegment.PayloadOffset,
                exifSegment.PayloadOffset + exifSegment.PayloadLength - 1))
        AhkTest.AssertEqual([0x54, 0x45, 0x53, 0x54, 0x01, 0x02],
