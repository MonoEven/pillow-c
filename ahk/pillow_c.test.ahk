PillowCTestImageSaveJpegRestartMarkersExtraBoundedMatrix(*) {
    lumaQTable := []
    chromaQTable := []
    loop 64 {
        index := A_Index - 1
        lumaQTable.Push(2 + Mod(index, 8))
        chromaQTable.Push(3 + Mod(index, 7))
    }
    extra := [0xFF, 0xED, 0x00, 0x0A, 0x45, 0x58, 0x54, 0x52, 0x41, 0x52, 0x53, 0x54]
    metadataComment := PillowCTextBytes("restart-extra-meta")
    metadataIcc := [1, 2, 3, 4, 5, 6, 7, 8]
    metadataExif := PillowCArraySlice(PillowCExifOrientationSegment(6), 5, 36)
    metadataXmp := PillowCTextBytes(PillowCXmpPacket())
    cases := [
        { Name: "l-rows", Mode: 1, Width: 24, Height: 16, QTables: [], Subsampling: -1, Progressive: 0, Optimize: 0, Blocks: 0, Rows: 1, Dri: 3, Sof: 0xC0 },
        { Name: "rgb-progressive", Mode: 3, Width: 32, Height: 32, QTables: [], Subsampling: -1, Progressive: 1, Optimize: 1, Blocks: 1, Rows: 0, Dri: 1, Sof: 0xC2 },
        { Name: "cmyk-baseline", Mode: 7, Width: 32, Height: 16, QTables: [], Subsampling: -1, Progressive: 0, Optimize: 0, Blocks: 3, Rows: 0, Dri: 3, Sof: 0xC0 },
        { Name: "rgb-qtables", Mode: 3, Width: 32, Height: 32, QTables: [lumaQTable, chromaQTable], Subsampling: 0, Progressive: 0, Optimize: 1, Blocks: 1, Rows: 0, Dri: 1, Sof: 0xC0, Comment: metadataComment, Icc: metadataIcc, Exif: metadataExif, Xmp: metadataXmp }
    ]
    for caseInfo in cases {
        image := PillowCCreateImageMode(caseInfo.Width, caseInfo.Height, caseInfo.Mode)
        path := PillowCTempJpegPath("restart-marker-extra-" caseInfo.Name)
        loaded := 0
        try {
            comment := caseInfo.HasOwnProp("Comment") ? caseInfo.Comment : []
            icc := caseInfo.HasOwnProp("Icc") ? caseInfo.Icc : []
            exif := caseInfo.HasOwnProp("Exif") ? caseInfo.Exif : []
            xmp := caseInfo.HasOwnProp("Xmp") ? caseInfo.Xmp : []
            status := PillowCImageSaveJpegMetadataRestartMarkerExtraEncodeOptionsStatus(
                image, path, 75, 0, 0.0, 0.0, comment, icc, exif, xmp, caseInfo.QTables,
                caseInfo.Subsampling, caseInfo.Progressive, caseInfo.Optimize,
                caseInfo.Blocks, caseInfo.Rows, extra)
            PillowCAssertStatus(status)

            bytes := PillowCReadFileBytes(path)
            extraSegment := PillowCFindJpegSegment(bytes, 0xED)
            dqt := PillowCFindJpegSegment(bytes, 0xDB)
            dri := PillowCFindJpegSegment(bytes, 0xDD)
            AhkTest.AssertTrue(extraSegment.Found)
            AhkTest.AssertTrue(dqt.Found)
            AhkTest.AssertTrue(dri.Found)
            AhkTest.AssertTrue(extraSegment.MarkerOffset < dqt.MarkerOffset)
            AhkTest.AssertTrue(dqt.MarkerOffset < dri.MarkerOffset)
            AhkTest.AssertEqual(caseInfo.Dri, PillowCReadBe16(bytes, dri.PayloadOffset))
            AhkTest.AssertEqual(caseInfo.Sof, PillowCReadJpegSofMarker(path))
            if caseInfo.HasOwnProp("Comment") {
                exifSegment := PillowCFindJpegSegment(bytes, 0xE1, [0x45, 0x78, 0x69, 0x66, 0, 0])
                xmpHeader := PillowCTextBytes("http://ns.adobe.com/xap/1.0/")
                xmpHeader.Push(0)
                xmpSegment := PillowCFindJpegSegment(bytes, 0xE1, xmpHeader)
                iccSegment := PillowCFindJpegSegment(bytes, 0xE2, [0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0])
                commentSegment := PillowCFindJpegSegment(bytes, 0xFE)
                AhkTest.AssertTrue(exifSegment.Found)
                AhkTest.AssertTrue(xmpSegment.Found)
                AhkTest.AssertTrue(iccSegment.Found)
                AhkTest.AssertTrue(commentSegment.Found)
                AhkTest.AssertTrue(exifSegment.MarkerOffset < extraSegment.MarkerOffset)
                AhkTest.AssertTrue(extraSegment.MarkerOffset < xmpSegment.MarkerOffset)
                AhkTest.AssertTrue(xmpSegment.MarkerOffset < iccSegment.MarkerOffset)
                AhkTest.AssertTrue(iccSegment.MarkerOffset < commentSegment.MarkerOffset)
                AhkTest.AssertTrue(commentSegment.MarkerOffset < dqt.MarkerOffset)
            }
            if caseInfo.Progressive
                AhkTest.AssertTrue(PillowCCountJpegSos(path) > 1)
            loaded := PillowCImageOpenJpeg(path)
            AhkTest.AssertEqual(caseInfo.Mode, PillowCImageMode(loaded))
            AhkTest.AssertEqual(caseInfo.Width * caseInfo.Height * (caseInfo.Mode = 1 ? 1 : caseInfo.Mode = 3 ? 3 : 4), PillowCImageSize(loaded))
        } finally {
            if loaded
                PillowCFreeImage(loaded)
            PillowCDeleteFile(path)
            PillowCFreeImage(image)
        }
    }
}

