PillowCTestImageOpenTiffReadsBigTiffTiledIccXmpMetadataMatrix(*) {
    cases := [
        { Name: "L", Storage: "L", IccType: 7, XmpType: 1, InlineIcc: false },
        { Name: "RGB", Storage: "RGB", IccType: 7, XmpType: 1, InlineIcc: false },
        { Name: "RGBA", Storage: "RGBA", IccType: 7, XmpType: 1, InlineIcc: false },
        { Name: "LA", Storage: "LA", IccType: 7, XmpType: 1, InlineIcc: false },
        { Name: "L-byte-icc", Storage: "L", IccType: 1, XmpType: 1, InlineIcc: false },
        { Name: "L-undefined-xmp", Storage: "L", IccType: 7, XmpType: 7, InlineIcc: false },
        { Name: "L-inline-icc", Storage: "L", IccType: 7, XmpType: 1, InlineIcc: true },
