PillowCTestSha256Hex(values) {
    data := PillowCBuffer(values)
    algorithm := 0
    hash := 0
    try {
        status := DllCall(
            "Bcrypt\BCryptOpenAlgorithmProvider",
            "Ptr*", &algorithm,
            "WStr", "SHA256",
            "Ptr", 0,
            "UInt", 0,
            "Int"
        )
        AhkTest.AssertEqual(0, status)
        objectLengthBuffer := Buffer(4, 0)
        resultSize := 0
        status := DllCall(
            "Bcrypt\BCryptGetProperty",
            "Ptr", algorithm,
            "WStr", "ObjectLength",
            "Ptr", objectLengthBuffer,
            "UInt", objectLengthBuffer.Size,
            "UInt*", &resultSize,
            "UInt", 0,
            "Int"
        )
        AhkTest.AssertEqual(0, status)
        AhkTest.AssertEqual(4, resultSize)
        hashObject := Buffer(NumGet(objectLengthBuffer, 0, "UInt"), 0)
        status := DllCall(
            "Bcrypt\BCryptCreateHash",
            "Ptr", algorithm,
            "Ptr*", &hash,
            "Ptr", hashObject,
            "UInt", hashObject.Size,
            "Ptr", 0,
            "UInt", 0,
            "UInt", 0,
            "Int"
        )
        AhkTest.AssertEqual(0, status)
        status := DllCall(
            "Bcrypt\BCryptHashData",
            "Ptr", hash,
            "Ptr", data,
            "UInt", data.Size,
            "UInt", 0,
            "Int"
        )
        AhkTest.AssertEqual(0, status)
        digest := Buffer(32, 0)
        status := DllCall(
            "Bcrypt\BCryptFinishHash",
            "Ptr", hash,
            "Ptr", digest,
            "UInt", digest.Size,
            "UInt", 0,
            "Int"
        )
        AhkTest.AssertEqual(0, status)
        hex := ""
        loop digest.Size
            hex .= Format("{:02x}", NumGet(digest, A_Index - 1, "UChar"))
        return hex
    } finally {
        if hash
            DllCall("Bcrypt\BCryptDestroyHash", "Ptr", hash, "Int")
        if algorithm
            DllCall("Bcrypt\BCryptCloseAlgorithmProvider", "Ptr", algorithm, "UInt", 0, "Int")
    }
}

