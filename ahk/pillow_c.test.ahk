PillowCTiffStripWithSubIfdBytes() {
    ; Classic little-endian strip TIFF 2x2 mode-L with IFD0 ExifIFD (34665)
    ; and GPSInfo (34853) sub-IFD pointers, mirroring
    ; oracle/probe_tiff_subifd.py: IFD0 at 8 (11 entries), strip at 146,
    ; Exif sub-IFD at 150, GPS sub-IFD at 192, blobs from 234.
    bytes := [73, 73, 42, 0]
    PillowCAppendLe32(bytes, 8)
    entries := [
        [256, 4, 1, 2],
        [257, 4, 1, 2],
        [258, 3, 1, 8],
        [259, 3, 1, 1],
        [262, 3, 1, 1],
        [273, 4, 1, 146],
        [277, 3, 1, 1],
        [278, 4, 1, 2],
        [279, 4, 1, 4],
        [34665, 4, 1, 150],
        [34853, 4, 1, 192],
    ]
    PillowCAppendLe16(bytes, entries.Length)
    for entry in entries {
        PillowCAppendLe16(bytes, entry[1])
        PillowCAppendLe16(bytes, entry[2])
        PillowCAppendLe32(bytes, entry[3])
        PillowCAppendLe32(bytes, entry[4])
    }
    PillowCAppendLe32(bytes, 0)
    bytes.Push(1, 2, 3, 4)
    exifEntries := [
        [36867, 2, 20, 282],
        [33434, 5, 1, 302],
        [37377, 10, 1, 310],
    ]
    PillowCAppendLe16(bytes, exifEntries.Length)
    for entry in exifEntries {
        PillowCAppendLe16(bytes, entry[1])
        PillowCAppendLe16(bytes, entry[2])
        PillowCAppendLe32(bytes, entry[3])
        PillowCAppendLe32(bytes, entry[4])
    }
    PillowCAppendLe32(bytes, 0)
    gpsEntries := [
        [1, 2, 2, 0x4E],
        [2, 5, 3, 318],
        [3, 2, 1, 0x57],
        [5, 3, 1, 1],
        [6, 5, 1, 374],
        [20, 5, 3, 342],
        [21, 5, 1, 366],
    ]
    PillowCAppendLe16(bytes, gpsEntries.Length)
    for entry in gpsEntries {
        PillowCAppendLe16(bytes, entry[1])
        PillowCAppendLe16(bytes, entry[2])
        PillowCAppendLe32(bytes, entry[3])
        PillowCAppendLe32(bytes, entry[4])
    }
    PillowCAppendLe32(bytes, 0)
    for value in PillowCTextBytes("2024:01:01 00:00:00")
        bytes.Push(value)
    bytes.Push(0)
    PillowCAppendLe32(bytes, 1)
    PillowCAppendLe32(bytes, 125)
    PillowCAppendLe32(bytes, -3)
    PillowCAppendLe32(bytes, 1)
    for pair in [[36, 1], [0, 1], [0, 1], [1, 2], [3, 4], [5, 6], [1, 1], [36, 1]] {
        PillowCAppendLe32(bytes, pair[1])
        PillowCAppendLe32(bytes, pair[2])
    }
    return bytes
}

