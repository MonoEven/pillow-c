                Sampling: [67, 1, 1, 0, 77, 1, 1, 0, 89, 1, 1, 0, 75, 1, 1, 0],
                SosCount: 18,
                Bytes: sourceBytes,
                Tolerance: 1
            },
            {
                Path: progressiveOptimizePath,
                HasDpi: 0,
                Subsampling: -1,
                Progressive: 1,
                Optimize: 1,
                Sof: 0xC2,
                Sampling: [67, 1, 1, 0, 77, 1, 1, 0, 89, 1, 1, 0, 75, 1, 1, 0],
