    rgb := PillowCCreateImage(1, 1, 3)
    image := 0
    try {
        firstXmp := PillowCTextBytes(StrReplace(PillowCXmpPacket(), "Hello", "First"))
        lastXmp := PillowCTextBytes(StrReplace(PillowCXmpPacket(), "Hello", "Second"))
        PillowCImageSaveJpeg(rgb, path)
        bytes := PillowCInsertJpegXmpApp1(PillowCReadFileBytes(path), lastXmp)
        bytes := PillowCInsertJpegXmpApp1(bytes, firstXmp)
        PillowCWriteFileBytes(path, bytes)

        header := PillowCTextBytes("http://ns.adobe.com/xap/1.0/")
        header.Push(0)
        segments := PillowCFindJpegSegments(bytes, 0xE1, header)
        AhkTest.AssertEqual(2, segments.Length)
        AhkTest.AssertEqual(firstXmp, PillowCArraySlice(
            bytes, segments[1].PayloadOffset + header.Length,
            segments[1].PayloadOffset + segments[1].PayloadLength - 1))
        AhkTest.AssertEqual(lastXmp, PillowCArraySlice(
            bytes, segments[2].PayloadOffset + header.Length,
            segments[2].PayloadOffset + segments[2].PayloadLength - 1))

        image := PillowCImageOpenJpeg(path)
        xmp := PillowCImageMetadataXmp(image)
        AhkTest.AssertEqual(1, xmp.Has)
        AhkTest.AssertEqual(lastXmp, xmp.Bytes)
    } finally {
        if image
            PillowCFreeImage(image)
        PillowCFreeImage(rgb)
        PillowCDeleteFile(path)
    }
}

