PillowCFindColor(colors, expectedColor) {
    for entry in colors {
        if entry[2].Length != expectedColor.Length
            continue
        matched := true
        for index, value in expectedColor {
            if entry[2][index] != value {
                matched := false
                break
            }
        }
        if matched
            return entry
    }
    return 0
}

PillowCFindNumericColor(colors, expectedValue, tolerance := 0.0) {
    for entry in colors {
        value := entry[2]
        if tolerance > 0.0 {
            if Abs(value - expectedValue) <= tolerance
                return entry
        } else if value = expectedValue {
            return entry
        }
    }
    return 0
}

