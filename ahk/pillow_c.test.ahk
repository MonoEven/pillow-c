        exifChunk := PillowCFindPngChunk(bytes, [0x65, 0x58, 0x49, 0x66])
        lateC := PillowCFindPngChunk(bytes, chunks[3].Type)
        lateD := PillowCFindPngChunk(bytes, chunks[4].Type)
