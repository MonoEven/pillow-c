PillowCTiffBigTiffCompressedChunkyTiledFixture(storage, compression, littleEndian := true) {
    if storage = "L" {
        channels := 1
        photometric := 1
        extraSamples := 0
        nativeMode := 1
    } else if storage = "RGB" {
        channels := 3
        photometric := 2
        extraSamples := 0
        nativeMode := 3
    } else if storage = "RGBA" {
        channels := 4
        photometric := 2
        extraSamples := 2
        nativeMode := 4
        outputChannels := 4
        hasExtraSamples := true
    } else if storage = "RGBX" {
        channels := 4
        photometric := 2
        extraSamples := 0
        nativeMode := 3
        outputChannels := 3
        hasExtraSamples := true
    } else if storage = "LA" {
        channels := 2
        photometric := 1
        extraSamples := 2
        nativeMode := 2
        outputChannels := 2
        hasExtraSamples := true
    } else {
        throw Error("Unsupported compressed BigTIFF storage " storage, -1)
    }
    if storage = "L" {
        outputChannels := 1
        hasExtraSamples := false
    } else if storage = "RGB" {
        outputChannels := 3
        hasExtraSamples := false
    }
    if compression = "packbits" {
        compressionTag := 32773
    } else if compression = "lzw" {
        compressionTag := 5
    } else if compression = "deflate" {
        compressionTag := 8
    } else {
        throw Error("Unsupported compressed BigTIFF compression " compression, -1)
    }

    tileSize := 2 * 2 * channels
    tilePayloads := []
    Loop 4 {
        tileValues := []
        tileBase := (A_Index - 1) * tileSize
        Loop tileSize
            tileValues.Push(tileBase + A_Index)
        if compression = "packbits"
            tilePayloads.Push(PillowCTiffPackBitsEncodeTile(tileValues))
        else if compression = "lzw"
            tilePayloads.Push(PillowCTiffLzwEncodeTile(tileValues))
        else
            tilePayloads.Push(PillowCTiffDeflateStoredEncodeTile(tileValues))
    }

    bitsCount := channels
    entryCount := hasExtraSamples ? 12 : 11
    ifdEnd := 16 + 8 + entryCount * 20 + 8
    tileOffsetsOffset := ifdEnd
    tileByteCountsOffset := tileOffsetsOffset + 32
    pixelOffset := tileByteCountsOffset + 32
    tileOffsets := []
    tileByteCounts := []
    nextOffset := pixelOffset
    for payload in tilePayloads {
        tileOffsets.Push(nextOffset)
        tileByteCounts.Push(payload.Length)
        nextOffset += payload.Length
    }
    bitsValue := 0
    Loop bitsCount
        bitsValue |= 8 << ((A_Index - 1) * 16)
    bytes := littleEndian ? [73, 73, 43, 0] : [77, 77, 0, 43]
    append16 := littleEndian ? PillowCAppendLe16 : PillowCAppendBe16
    append64 := littleEndian ? PillowCAppendLe64 : PillowCAppendBe64
    append16.Call(bytes, 8)
    append16.Call(bytes, 0)
    append64.Call(bytes, 16)
    entries := [
        [256, 4, 1, 4],
        [257, 4, 1, 3],
        [258, 3, bitsCount, bitsValue],
        [259, 3, 1, compressionTag],
        [262, 3, 1, photometric],
        [277, 3, 1, channels],
        [284, 3, 1, 1],
        [322, 4, 1, 2],
        [323, 4, 1, 2],
        [324, 16, 4, tileOffsetsOffset],
        [325, 16, 4, tileByteCountsOffset]
    ]
    if hasExtraSamples
        entries.Push([338, 3, 1, extraSamples])
    append64.Call(bytes, entries.Length)
    for entry in entries
        PillowCAppendBigTiffEntry(bytes, entry, littleEndian)
    append64.Call(bytes, 0)
    for offset in tileOffsets
        append64.Call(bytes, offset)
    for count in tileByteCounts
        append64.Call(bytes, count)
    for payload in tilePayloads {
        for value in payload
            bytes.Push(value)
    }

    expected := []
    Loop 3 {
        sourceY := A_Index - 1
        Loop 4 {
            sourceX := A_Index - 1
            tileIndex := Floor(sourceY / 2) * 2 + Floor(sourceX / 2)
            localX := Mod(sourceX, 2)
            localY := Mod(sourceY, 2)
            Loop channels {
                if storage = "RGBX" && A_Index = 4
                    continue
                expected.Push(tileIndex * tileSize + localY * 2 * channels + localX * channels + A_Index)
            }
        }
    }
    return { Bytes: bytes, Expected: expected, NativeMode: nativeMode }
}

