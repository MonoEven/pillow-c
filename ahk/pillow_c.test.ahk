PillowCTestImageSaveJpegCmykRestartMarkersComposeBlockAndRowIntervals(*) {
    image := PillowCCreateImageMode(32, 16, 7)
    blockPath := PillowCTempJpegPath("restart-marker-blocks-cmyk")
    rowPath := PillowCTempJpegPath("restart-marker-rows-cmyk")
    loadedHandles := []
    try {
        values := []
        loop 16 {
            y := A_Index - 1
            loop 32 {
                x := A_Index - 1
                blockIndex := Floor(y / 8) * 4 + Floor(x / 8)
                values.Push(Mod(blockIndex * 23 + 5, 256))
                values.Push(Mod(blockIndex * 37 + 17, 256))
                values.Push(Mod(blockIndex * 53 + 29, 256))
                values.Push(Mod(blockIndex * 71 + 43, 256))
            }
        }
        PillowCImageSetBytes(image, values)

        status := PillowCImageSaveJpegRestartMarkerBlocksOptionsStatus(image, blockPath, 95, 3)
        PillowCAssertStatus(status)
        status := PillowCImageSaveJpegRestartMarkerRowsOptionsStatus(image, rowPath, 95, 1)
        PillowCAssertStatus(status)

        testCases := [
            { Path: blockPath, Dri: 3, RestartMarkers: [0xD0, 0xD1] },
            { Path: rowPath, Dri: 4, RestartMarkers: [0xD0] }
        ]
        for testCase in testCases {
            bytes := PillowCReadFileBytes(testCase.Path)
            app14 := PillowCFindJpegSegment(bytes, 0xEE, [65, 100, 111, 98, 101])
            dqt := PillowCFindJpegSegment(bytes, 0xDB)
            sof0 := PillowCFindJpegSegment(bytes, 0xC0)
            dht := PillowCFindJpegSegment(bytes, 0xC4)
            dri := PillowCFindJpegSegment(bytes, 0xDD)
            AhkTest.AssertTrue(app14.Found)
            AhkTest.AssertTrue(dqt.Found)
            AhkTest.AssertTrue(sof0.Found)
            AhkTest.AssertTrue(dht.Found)
            AhkTest.AssertTrue(dri.Found)
            AhkTest.AssertTrue(app14.MarkerOffset < dqt.MarkerOffset)
            AhkTest.AssertTrue(dqt.MarkerOffset < sof0.MarkerOffset)
            AhkTest.AssertTrue(sof0.MarkerOffset < dht.MarkerOffset)
            AhkTest.AssertTrue(dht.MarkerOffset < dri.MarkerOffset)
            AhkTest.AssertEqual(0, bytes[app14.PayloadOffset + 11])
            dqtPayloads := PillowCReadJpegDqtPayloads(testCase.Path)
            AhkTest.AssertEqual(1, dqtPayloads.Length)
            AhkTest.AssertEqual(0, dqtPayloads[1].TableId)
            AhkTest.AssertEqual([67, 1, 1, 0, 77, 1, 1, 0, 89, 1, 1, 0, 75, 1, 1, 0],
                PillowCReadJpegSof0Sampling(testCase.Path))
            AhkTest.AssertEqual([29, 179], PillowCReadJpegDhtPayloadLengths(testCase.Path))
            AhkTest.AssertEqual(testCase.Dri, PillowCReadBe16(bytes, dri.PayloadOffset))
            AhkTest.AssertEqual(testCase.RestartMarkers, PillowCReadJpegRestartMarkers(testCase.Path))
            AhkTest.AssertEqual(1, PillowCCountJpegSos(testCase.Path))

            loaded := PillowCImageOpenJpeg(testCase.Path)
            loadedHandles.Push(loaded)
            AhkTest.AssertEqual(7, PillowCImageMode(loaded))
            AhkTest.AssertEqual(2048, PillowCImageSize(loaded))
            AhkTest.AssertEqual(values, PillowCImageToArray(loaded, values.Length))
        }
    } finally {
        for loaded in loadedHandles
            PillowCFreeImage(loaded)
        PillowCDeleteFile(rowPath)
        PillowCDeleteFile(blockPath)
        PillowCFreeImage(image)
    }
}

AhkTest.Test("pillow_c image save_jpeg CMYK restart markers compose block and row intervals", PillowCTestImageSaveJpegCmykRestartMarkersComposeBlockAndRowIntervals)

