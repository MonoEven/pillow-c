PillowCTestImageSaveJpegMetadataRestartMarkersWriteMetadataAndRestartStructure(*) {
    l := PillowCCreateImageMode(24, 16, 1)
    rgb := PillowCCreateImageMode(48, 32, 3)
    lPath := PillowCTempJpegPath("restart-blocks-metadata-l")
    rgbPath := PillowCTempJpegPath("restart-rows-metadata-rgb")
    lLoaded := 0
    rgbLoaded := 0
    try {
        lValues := []
        loop 16 {
            y := A_Index - 1
            loop 24 {
                x := A_Index - 1
                lValues.Push(Mod(x * 23 + y * 41, 256))
            }
        }
        PillowCImageSetBytes(l, lValues)

        rgbValues := []
        loop 32 {
            y := A_Index - 1
            loop 48 {
                x := A_Index - 1
                rgbValues.Push(Mod(x * 17 + y * 3, 256))
                rgbValues.Push(Mod(x * 5 + y * 29, 256))
                rgbValues.Push(Mod(x * 11 + y * 7, 256))
            }
        }
        PillowCImageSetBytes(rgb, rgbValues)

        lComment := PillowCTextBytes("restart-block-meta")
        status := PillowCImageSaveJpegMetadataRestartMarkerOptionsStatus(
            l, lPath, 75, lComment, [], [], [], 3, 0)
        PillowCAssertStatus(status)
        lBytes := PillowCReadFileBytes(lPath)
        lCommentSegment := PillowCFindJpegSegment(lBytes, 0xFE)
        lDri := PillowCFindJpegSegment(lBytes, 0xDD)
        AhkTest.AssertTrue(lCommentSegment.Found)
        AhkTest.AssertTrue(lDri.Found)
        AhkTest.AssertTrue(lCommentSegment.MarkerOffset < lDri.MarkerOffset)
        AhkTest.AssertEqual(lComment,
            PillowCArraySlice(lBytes, lCommentSegment.PayloadOffset, lCommentSegment.PayloadOffset + lCommentSegment.PayloadLength - 1))
        AhkTest.AssertEqual(3, PillowCReadBe16(lBytes, lDri.PayloadOffset))
        AhkTest.AssertEqual([0xD0], PillowCReadJpegRestartMarkers(lPath))
        lLoaded := PillowCImageOpenJpeg(lPath)
        AhkTest.AssertEqual(1, PillowCImageMode(lLoaded))
        AhkTest.AssertEqual(384, PillowCImageSize(lLoaded))
        lCommentMetadata := PillowCImageMetadataJpegBlob(lLoaded, "pillow_c_image_metadata_jpeg_comment")
        AhkTest.AssertEqual(1, lCommentMetadata.Has)
        AhkTest.AssertEqual(lComment, lCommentMetadata.Bytes)

        comment := PillowCTextBytes("restart-row-meta")
        iccProfile := [1, 2, 3, 4, 5, 6, 7, 8]
        exif := PillowCArraySlice(PillowCExifOrientationSegment(6), 5, 36)
        xmp := PillowCTextBytes(PillowCXmpPacket())
        status := PillowCImageSaveJpegMetadataRestartMarkerOptionsStatus(
            rgb, rgbPath, 75, comment, iccProfile, exif, xmp, 0, 1)
        PillowCAssertStatus(status)

        rgbBytes := PillowCReadFileBytes(rgbPath)
        jfif := PillowCFindJpegSegment(rgbBytes, 0xE0, [0x4A, 0x46, 0x49, 0x46, 0])
        exifSegment := PillowCFindJpegSegment(rgbBytes, 0xE1, [0x45, 0x78, 0x69, 0x66, 0, 0])
        xmpHeader := PillowCTextBytes("http://ns.adobe.com/xap/1.0/")
        xmpHeader.Push(0)
        xmpSegment := PillowCFindJpegSegment(rgbBytes, 0xE1, xmpHeader)
        iccSegment := PillowCFindJpegSegment(rgbBytes, 0xE2, [0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0])
        commentSegment := PillowCFindJpegSegment(rgbBytes, 0xFE)
        dqt := PillowCFindJpegSegment(rgbBytes, 0xDB)
        dri := PillowCFindJpegSegment(rgbBytes, 0xDD)
        segments := [
            { Name: "JFIF", Segment: jfif },
            { Name: "EXIF", Segment: exifSegment },
            { Name: "XMP", Segment: xmpSegment },
            { Name: "ICC", Segment: iccSegment },
            { Name: "COM", Segment: commentSegment },
            { Name: "DQT", Segment: dqt },
            { Name: "DRI", Segment: dri },
        ]
        for item in segments {
            if !item.Segment.Found
                AhkTest.Fail("Missing JPEG segment: " item.Name)
        }
        AhkTest.AssertTrue(jfif.MarkerOffset < exifSegment.MarkerOffset)
        AhkTest.AssertTrue(exifSegment.MarkerOffset < xmpSegment.MarkerOffset)
        AhkTest.AssertTrue(xmpSegment.MarkerOffset < iccSegment.MarkerOffset)
        AhkTest.AssertTrue(iccSegment.MarkerOffset < commentSegment.MarkerOffset)
        AhkTest.AssertTrue(commentSegment.MarkerOffset < dqt.MarkerOffset)
        AhkTest.AssertTrue(dqt.MarkerOffset < dri.MarkerOffset)
        AhkTest.AssertEqual(3, PillowCReadBe16(rgbBytes, dri.PayloadOffset))
        AhkTest.AssertEqual([0xD0], PillowCReadJpegRestartMarkers(rgbPath))
        AhkTest.AssertEqual([29, 179, 29, 179], PillowCReadJpegDhtPayloadLengths(rgbPath))
        AhkTest.AssertEqual(1, PillowCCountJpegSos(rgbPath))

        rgbLoaded := PillowCImageOpenJpeg(rgbPath)
        AhkTest.AssertEqual(3, PillowCImageMode(rgbLoaded))
        AhkTest.AssertEqual(4608, PillowCImageSize(rgbLoaded))
        AhkTest.AssertEqual(6, PillowCImageExifOrientation(rgbLoaded))
        commentMetadata := PillowCImageMetadataJpegBlob(rgbLoaded, "pillow_c_image_metadata_jpeg_comment")
        iccMetadata := PillowCImageMetadataJpegBlob(rgbLoaded, "pillow_c_image_metadata_jpeg_icc_profile")
        exifMetadata := PillowCImageMetadataJpegBlob(rgbLoaded, "pillow_c_image_metadata_jpeg_exif")
