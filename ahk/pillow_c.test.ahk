                0x01, 0x2C, 0x80, 0x00, 0, 1, 0, 2,
                0x00, 0x96, 0x40, 0x00, 0, 3, 0, 4)
            for value in PillowCTextBytes("8BIM")
                payload.Push(value)
            payload.Push(0x03, 0xED, 0, 0, 0, 0, 0,
                caseItem.Data.Length)
            for value in caseItem.Data
