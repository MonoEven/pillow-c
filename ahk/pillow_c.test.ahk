    expectedDescription := "sRGB built-in`n"
    path := A_Temp "\pillow-c-cms-open-profile-path-" A_TickCount "-" Random(1, 1000000) ".icc"
    builtinProfile := 0
    openedProfile := 0
    try {
        PillowCAssertStatus(DllCall(
            PillowCDllPath() "\pillow_c_cms_profile_create_srgb",
            "Ptr*", &builtinProfile,
            "Int"
        ))
        required := 0
        PillowCAssertStatus(DllCall(
            PillowCDllPath() "\pillow_c_cms_profile_bytes",
            "Ptr", builtinProfile,
            "Ptr", 0,
            "UPtr", 0,
            "UPtr*", &required,
            "Int"
        ))
        profileBytes := Buffer(required, 0)
        PillowCAssertStatus(DllCall(
            PillowCDllPath() "\pillow_c_cms_profile_bytes",
            "Ptr", builtinProfile,
            "Ptr", profileBytes,
            "UPtr", profileBytes.Size,
            "UPtr*", &required,
            "Int"
        ))
        file := FileOpen(path, "w")
        try {
            file.RawWrite(profileBytes, profileBytes.Size)
        } finally {
            file.Close()
        }

        PillowCAssertStatus(DllCall(
            PillowCDllPath() "\pillow_c_cms_profile_open_file",
            "AStr", path,
            "Ptr*", &openedProfile,
            "Int"
        ))
        descriptionRequired := 0
        PillowCAssertStatus(DllCall(
            PillowCDllPath() "\pillow_c_cms_profile_name",
            "Ptr", openedProfile,
            "Ptr", 0,
            "UPtr", 0,
            "UPtr*", &descriptionRequired,
            "Int"
        ))
        descriptionBytes := Buffer(descriptionRequired, 0)
        PillowCAssertStatus(DllCall(
            PillowCDllPath() "\pillow_c_cms_profile_name",
            "Ptr", openedProfile,
            "Ptr", descriptionBytes,
            "UPtr", descriptionBytes.Size,
            "UPtr*", &descriptionRequired,
            "Int"
        ))
        AhkTest.AssertEqual(
            expectedDescription,
            StrGet(descriptionBytes.Ptr, descriptionRequired - 1, "UTF-8")
        )

        deleteFailed := false
        try FileDelete(path)
        catch Error {
            deleteFailed := true
        }
        AhkTest.AssertTrue(deleteFailed)

        PillowCAssertStatus(DllCall(
            PillowCDllPath() "\pillow_c_cms_profile_free",
            "Ptr", openedProfile,
            "Int"
        ))
        openedProfile := 0
        FileDelete(path)
        AhkTest.AssertTrue(!FileExist(path))
