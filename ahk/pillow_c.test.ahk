PillowCTestImageSaveJpegExtraMarkerStream(*) {
    rgb := PillowCCreateImageMode(16, 16, 3)
    path := PillowCTempJpegPath("extra-marker-stream")
    opened := 0
    try {
        extra := [
            0xFF, 0xED, 0x00, 0x08, 0x54, 0x45, 0x53, 0x54, 0x01, 0x02,
            0xFF, 0xFE, 0x00, 0x08, 0x45, 0x58, 0x54, 0x52, 0x41, 0x21
        ]
        status := PillowCImageSaveJpegExtraOptionsStatus(
            rgb, path, 75, 0, 0.0, 0.0, -1, -1, -1, extra)
        PillowCAssertStatus(status)

        bytes := PillowCReadFileBytes(path)
        app13 := PillowCFindJpegSegment(bytes, 0xED)
        comment := PillowCFindJpegSegment(bytes, 0xFE)
        dqt := PillowCFindJpegSegment(bytes, 0xDB)
        AhkTest.AssertTrue(app13.Found)
        AhkTest.AssertTrue(comment.Found)
        AhkTest.AssertTrue(dqt.Found)
        AhkTest.AssertEqual([0x54, 0x45, 0x53, 0x54, 0x01, 0x02],
            PillowCArraySlice(bytes, app13.PayloadOffset,
                app13.PayloadOffset + app13.PayloadLength - 1))
        AhkTest.AssertEqual([0x45, 0x58, 0x54, 0x52, 0x41, 0x21],
            PillowCArraySlice(bytes, comment.PayloadOffset,
                comment.PayloadOffset + comment.PayloadLength - 1))
        AhkTest.AssertTrue(app13.MarkerOffset < comment.MarkerOffset)
        AhkTest.AssertTrue(comment.MarkerOffset < dqt.MarkerOffset)

        opened := PillowCImageOpenJpeg(path)
        AhkTest.AssertEqual(3, PillowCImageMode(opened))
    } finally {
        if opened
            PillowCFreeImage(opened)
        PillowCDeleteFile(path)
        PillowCFreeImage(rgb)
    }
}

