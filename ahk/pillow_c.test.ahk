                Dri: [4, 8, 4, 8, 4, 8, 4, 8, 4], Rst: progressiveRst
            }
        ]
        variants := [
            { Name: "xmp-only", HasDpi: 0, Core: false },
            { Name: "dpi-all", HasDpi: 1, Core: true }
        ]

        for variant in variants {
            for testCase in cases {
                path := PillowCTempJpegPath("qtables-restart-cmyk-subsampling-xmp-" variant.Name "-" testCase.Name)
                paths.Push(path)
                status := PillowCImageSaveJpegQTablesMetadataDpiRestartMarkerEncodeOptionsStatus(
                    cmyk,
                    path,
                    75,
                    variant.HasDpi,
                    variant.HasDpi ? testCase.Dpi[1] : 0.0,
                    variant.HasDpi ? testCase.Dpi[2] : 0.0,
                    variant.Core ? comment : [],
                    variant.Core ? iccProfile : [],
                    variant.Core ? exif : [],
                    xmp,
                    qtables,
                    testCase.Subsampling,
                    testCase.Progressive,
                    testCase.Optimize,
                    testCase.Blocks,
                    testCase.Rows)
                PillowCAssertStatus(status)

                bytes := PillowCReadFileBytes(path)
                jfif := PillowCFindJpegSegment(bytes, 0xE0, [0x4A, 0x46, 0x49, 0x46, 0])
                app14 := PillowCFindJpegSegment(bytes, 0xEE, [65, 100, 111, 98, 101])
                exifSegment := PillowCFindJpegSegment(bytes, 0xE1, [0x45, 0x78, 0x69, 0x66, 0, 0])
                xmpHeader := PillowCTextBytes("http://ns.adobe.com/xap/1.0/")
                xmpHeader.Push(0)
                xmpSegment := PillowCFindJpegSegment(bytes, 0xE1, xmpHeader)
                iccSegment := PillowCFindJpegSegment(bytes, 0xE2, [0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0])
                commentSegment := PillowCFindJpegSegment(bytes, 0xFE)
                dqtSegment := PillowCFindJpegSegment(bytes, 0xDB)
                for segment in [app14, xmpSegment, dqtSegment]
                    AhkTest.AssertTrue(segment.Found)
                AhkTest.AssertEqual(variant.HasDpi = 1, jfif.Found)
                AhkTest.AssertEqual(variant.Core, exifSegment.Found)
                AhkTest.AssertEqual(variant.Core, iccSegment.Found)
                AhkTest.AssertEqual(variant.Core, commentSegment.Found)
