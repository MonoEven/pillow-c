    values := []
    subsampledExpected := []
    loop 32 {
        loop 32 {
            values.Push(0, 64, 128, 255, 10, 20, 30, 40)
            subsampledExpected.Push(0, 42, 79, 148, 10, 42, 79, 148)
        }
    }
    cmyk := Pillow.Image.FromBytes("CMYK", [64, 32], PillowTestBuffer(values))
    cQTable := []
    mykQTable := []
    loop 64 {
        i := A_Index - 1
        cQTable.Push(2 + Mod(i, 8))
        mykQTable.Push(3 + Mod(i, 7))
    }
    qtables := [cQTable, mykQTable]
    comment := PillowTestTextBytes("cmyk-aj")
    iccProfile := PillowTestTextBytes("ICC-CMYK-AJ")
    exif := PillowTestArraySlice(PillowTestExifOrientationSegment(6), 5, 36)
    xmp := PillowTestTextBytes(PillowTestXmpPacket())
    loadedImages := []
    paths := []
    try {
        progressiveRst := []
        loop 18
            progressiveRst.Push([0xD0, 0xD1, 0xD2])
        cases := [
            {
                Name: "baseline", Dpi: [300, 150], Subsampling: 1,
                Progressive: false, Optimize: false, Blocks: 3, Rows: 0,
                Sof: 0xC0, SosCount: 1,
                Sampling: [67, 2, 1, 0, 77, 1, 1, 1, 89, 1, 1, 1, 75, 1, 1, 1],
                Dht: [29, 179], DhtCount: 2, Dri: [3],
                Rst: [[0xD0, 0xD1, 0xD2, 0xD3, 0xD4]]
            },
            {
                Name: "optimized", Dpi: [144, 72], Subsampling: 2,
                Progressive: false, Optimize: true, Blocks: 0, Rows: 1,
                Sof: 0xC0, SosCount: 1,
                Sampling: [67, 2, 2, 0, 77, 1, 1, 1, 89, 1, 1, 1, 75, 1, 1, 1],
                Dht: [], DhtCount: 2, Dri: [4], Rst: [[0xD0]]
            },
            {
                Name: "progressive", Dpi: [72, 144], Subsampling: 1,
                Progressive: true, Optimize: true, Blocks: 0, Rows: 1,
                Sof: 0xC2, SosCount: 18,
                Sampling: [67, 2, 1, 0, 77, 1, 1, 1, 89, 1, 1, 1, 75, 1, 1, 1],
                Dht: [], DhtCount: 17,
                Dri: [4, 8, 4, 8, 4, 8, 4, 8, 4], Rst: progressiveRst
            }
        ]
        variants := [
            { Name: "xmp-only", HasDpi: false, Core: false },
            { Name: "dpi-all", HasDpi: true, Core: true }
        ]

        for variant in variants {
            for testCase in cases {
                path := PillowTestTempJpegPath("qtables-restart-cmyk-subsampling-xmp-" variant.Name "-" testCase.Name)
                paths.Push(path)
                options := {
                    quality: 75,
                    qtables: qtables,
                    xmp: PillowTestBuffer(xmp),
                    subsampling: testCase.Subsampling,
                    progressive: testCase.Progressive,
                    optimize: testCase.Optimize
                }
                if variant.HasDpi
                    options.dpi := testCase.Dpi
                if variant.Core {
                    options.comment := "cmyk-aj"
                    options.icc_profile := PillowTestBuffer(iccProfile)
                    options.exif := PillowTestBuffer(exif)
                }
                if testCase.Blocks
                    options.restart_marker_blocks := testCase.Blocks
                if testCase.Rows
                    options.restart_marker_rows := testCase.Rows
                cmyk.Save(path, "JPEG", options)

                bytes := PillowTestReadFileBytes(path)
                jfif := PillowTestFindJpegSegment(bytes, 0xE0, [0x4A, 0x46, 0x49, 0x46, 0])
                app14 := PillowTestFindJpegSegment(bytes, 0xEE, [65, 100, 111, 98, 101])
                exifSegment := PillowTestFindJpegSegment(bytes, 0xE1, [0x45, 0x78, 0x69, 0x66, 0, 0])
                xmpHeader := PillowTestTextBytes("http://ns.adobe.com/xap/1.0/")
                xmpHeader.Push(0)
                xmpSegment := PillowTestFindJpegSegment(bytes, 0xE1, xmpHeader)
                iccSegment := PillowTestFindJpegSegment(bytes, 0xE2, [0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0])
                commentSegment := PillowTestFindJpegSegment(bytes, 0xFE)
                dqtSegment := PillowTestFindJpegSegment(bytes, 0xDB)
                for segment in [app14, xmpSegment, dqtSegment]
                    AhkTest.AssertTrue(segment.Found)
                AhkTest.AssertEqual(variant.HasDpi, jfif.Found)
                AhkTest.AssertEqual(variant.Core, exifSegment.Found)
                AhkTest.AssertEqual(variant.Core, iccSegment.Found)
                AhkTest.AssertEqual(variant.Core, commentSegment.Found)
                if variant.Core {
                    AhkTest.AssertTrue(jfif.MarkerOffset < app14.MarkerOffset)
                    AhkTest.AssertTrue(app14.MarkerOffset < exifSegment.MarkerOffset)
                    AhkTest.AssertTrue(exifSegment.MarkerOffset < xmpSegment.MarkerOffset)
                    AhkTest.AssertTrue(xmpSegment.MarkerOffset < iccSegment.MarkerOffset)
                    AhkTest.AssertTrue(iccSegment.MarkerOffset < commentSegment.MarkerOffset)
                    AhkTest.AssertTrue(commentSegment.MarkerOffset < dqtSegment.MarkerOffset)
                    jfifMetadata := PillowTestReadJpegJfif(path)
                    AhkTest.AssertEqual(1, jfifMetadata.Unit)
                    AhkTest.AssertEqual(testCase.Dpi[1], jfifMetadata.XDensity)
                    AhkTest.AssertEqual(testCase.Dpi[2], jfifMetadata.YDensity)
                } else {
                    AhkTest.AssertTrue(app14.MarkerOffset < xmpSegment.MarkerOffset)
                    AhkTest.AssertTrue(xmpSegment.MarkerOffset < dqtSegment.MarkerOffset)
                }

                restart := PillowTestReadJpegProgressiveRestartStructure(path)
                AhkTest.AssertEqual(testCase.DhtCount, restart.DhtPayloadLengths.Length)
                if testCase.Dht.Length
                    AhkTest.AssertEqual(testCase.Dht, restart.DhtPayloadLengths)
                AhkTest.AssertEqual(testCase.Dri, restart.DriValues)
                AhkTest.AssertEqual(testCase.Rst, restart.ScanRestartMarkers)
                AhkTest.AssertEqual(testCase.Sof, PillowTestReadJpegSofMarker(path))
                AhkTest.AssertEqual(testCase.Sampling,
                    PillowTestReadJpegSofSampling(path, testCase.Sof))
                AhkTest.AssertEqual(testCase.SosCount, PillowTestCountJpegSos(path))
                dqt := PillowTestReadJpegDqtPayloads(path)
                AhkTest.AssertEqual(2, dqt.Length)
                AhkTest.AssertEqual(PillowTestExpectedJpegDqtPayload(cQTable, 75), dqt[1].Values)
                AhkTest.AssertEqual(PillowTestExpectedJpegDqtPayload(mykQTable, 75), dqt[2].Values)

                loaded := Pillow.Image.Open(path, ["JPEG"])
                loadedImages.Push(loaded)
                AhkTest.AssertEqual("CMYK", loaded.Mode)
                PillowTestAssertArrayNear(subsampledExpected,
                    PillowTestBufferToArray(loaded.ToBytes()), 1)
                AhkTest.AssertEqual(xmp, PillowTestBufferToArray(loaded.Info["xmp"]))
                if variant.Core {
                    AhkTest.AssertEqual(testCase.Dpi, loaded.Info["dpi"])
                    AhkTest.AssertEqual(testCase.Dpi, loaded.Info["jfif_density"])
                    AhkTest.AssertEqual(6, loaded.ExifOrientation())
                    AhkTest.AssertEqual(comment, PillowTestBufferToArray(loaded.Info["comment"]))
                    AhkTest.AssertEqual(iccProfile, PillowTestBufferToArray(loaded.Info["icc_profile"]))
                    AhkTest.AssertEqual(exif, PillowTestBufferToArray(loaded.Info["exif"]))
                } else {
                    AhkTest.AssertFalse(loaded.Info.Has("dpi"))
                    AhkTest.AssertFalse(loaded.Info.Has("comment"))
                    AhkTest.AssertFalse(loaded.Info.Has("icc_profile"))
                    AhkTest.AssertFalse(loaded.Info.Has("exif"))
                    AhkTest.AssertEqual(0, loaded.ExifOrientation())
                }
            }
        }
    } finally {
        for loaded in loadedImages
            loaded.Close()
        for path in paths
            PillowTestDeleteFile(path)
        cmyk.Close()
    }
}

AhkTest.Test("Pillow Image.Save JPEG CMYK custom qtables restart real subsampling composes XMP metadata matrix", PillowTestImageSaveJpegCmykCustomQTablesRestartRealSubsamplingXmpMetadataMatrix)

