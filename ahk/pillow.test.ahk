        })
        sourceDqt := PillowTestReadJpegDqtPayloads(sourcePath)
        AhkTest.AssertEqual(2, sourceDqt.Length)

        opened := Pillow.Image.Open(sourcePath, ["JPEG"])
        handles.Push(opened)
        explicitIcc := PillowTestTextBytes("ICC-EXPLICIT")
        explicitExif := PillowTestArraySlice(PillowTestExifOrientationSegment(6), 5, 36)
        commonMetadata := {
            icc_profile: PillowTestBuffer(explicitIcc),
            exif: PillowTestBuffer(explicitExif)
        }
        optimizedKeepOptions := {
            qtables: "keep", subsampling: "keep", optimize: true,
            restart_marker_rows: 1,
            icc_profile: commonMetadata.icc_profile, exif: commonMetadata.exif
        }
        optimizedDefaultOptions := {
            qtables: "keep", optimize: true, restart_marker_rows: 1,
            icc_profile: commonMetadata.icc_profile, exif: commonMetadata.exif
        }
        progressiveKeepOptions := {
            qtables: "keep", subsampling: "keep", progressive: true,
            optimize: true, restart_marker_rows: 1,
            icc_profile: commonMetadata.icc_profile, exif: commonMetadata.exif
        }
        progressiveDefaultOptions := {
            qtables: "keep", progressive: true, optimize: true,
            restart_marker_rows: 1,
            icc_profile: commonMetadata.icc_profile, exif: commonMetadata.exif
        }
        opened.Save(optimizedKeepPath, "JPEG", optimizedKeepOptions)
        opened.Save(optimizedDefaultPath, "JPEG", optimizedDefaultOptions)
        opened.Save(progressiveKeepPath, "JPEG", progressiveKeepOptions)
        opened.Save(progressiveDefaultPath, "JPEG", progressiveDefaultOptions)

        sampling422 := [1, 2, 1, 0, 2, 1, 1, 1, 3, 1, 1, 1]
        sampling420 := [1, 2, 2, 0, 2, 1, 1, 1, 3, 1, 1, 1]
        allThreeRestarts := []
        loop 10
            allThreeRestarts.Push([0xD0, 0xD1, 0xD2])
        defaultProgressiveRestarts := [
            [0xD0],
            [0xD0, 0xD1, 0xD2],
            [0xD0],
            [0xD0],
            [0xD0, 0xD1, 0xD2],
            [0xD0, 0xD1, 0xD2],
            [0xD0],
            [0xD0],
            [0xD0],
            [0xD0, 0xD1, 0xD2]
        ]
        testCases := [
            { Path: optimizedKeepPath, Sof: 0xC0, Sampling: sampling422,
                Dri: [3], Restarts: [[0xD0, 0xD1, 0xD2]], DhtCount: 4, SosCount: 1 },
            { Path: optimizedDefaultPath, Sof: 0xC0, Sampling: sampling420,
                Dri: [3], Restarts: [[0xD0]], DhtCount: 4, SosCount: 1 },
            { Path: progressiveKeepPath, Sof: 0xC2, Sampling: sampling422,
                Dri: [3, 6, 3, 6, 3, 6], Restarts: allThreeRestarts,
                DhtCount: 10, SosCount: 10 },
            { Path: progressiveDefaultPath, Sof: 0xC2, Sampling: sampling420,
                Dri: [3, 6, 3, 6, 3, 6], Restarts: defaultProgressiveRestarts,
                DhtCount: 10, SosCount: 10 }
        ]
        for testCase in testCases {
            savedDqt := PillowTestReadJpegDqtPayloads(testCase.Path)
            AhkTest.AssertEqual(sourceDqt[1].Values, savedDqt[1].Values)
            AhkTest.AssertEqual(sourceDqt[2].Values, savedDqt[2].Values)
            AhkTest.AssertEqual(testCase.Sof, PillowTestReadJpegSofMarker(testCase.Path))
            actualSampling := testCase.Sof = 0xC0
                ? PillowTestReadJpegSof0Sampling(testCase.Path)
                : PillowTestReadJpegSofSampling(testCase.Path, 0xC2)
            AhkTest.AssertEqual(testCase.Sampling, actualSampling)
            AhkTest.AssertEqual(testCase.SosCount, PillowTestCountJpegSos(testCase.Path))
            restart := PillowTestReadJpegProgressiveRestartStructure(testCase.Path)
            AhkTest.AssertEqual(testCase.DhtCount, restart.DhtPayloadLengths.Length)
            AhkTest.AssertEqual(testCase.Dri, restart.DriValues)
            AhkTest.AssertEqual(testCase.Restarts, restart.ScanRestartMarkers)

            loaded := Pillow.Image.Open(testCase.Path, ["JPEG"])
            handles.Push(loaded)
            AhkTest.AssertEqual("RGB", loaded.Mode)
            AhkTest.AssertEqual([48, 32], loaded.Size)
            AhkTest.AssertEqual(PillowTestTextBytes("opened-qkeep-strategy"),
                PillowTestBufferToArray(loaded.Info["comment"]))
            AhkTest.AssertEqual(explicitIcc, PillowTestBufferToArray(loaded.Info["icc_profile"]))
            AhkTest.AssertEqual(6, loaded.ExifOrientation())
        }
    } finally {
        for handle in handles {
            if IsObject(handle)
                handle.Close()
        }
        for path in outputPaths
            PillowTestDeleteFile(path)
        PillowTestDeleteFile(sourcePath)
    }
}

