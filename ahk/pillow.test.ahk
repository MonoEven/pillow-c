PillowTestImageOpenJpegMultipleXmpPacketsUsesLastAndSavePrecedence(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    source := Pillow.Image.New("RGB", [16, 8], [1, 2, 3])
    sourcePath := PillowTestTempJpegPath("multiple-xmp-source")
    qualityKeepPath := PillowTestTempJpegPath("multiple-xmp-quality-keep")
    qtablesKeepPath := PillowTestTempJpegPath("multiple-xmp-qtables-keep")
    explicitPath := PillowTestTempJpegPath("multiple-xmp-explicit")
    implicitPaths := [qualityKeepPath, qtablesKeepPath]
    outputPaths := [qualityKeepPath, qtablesKeepPath, explicitPath]
    handles := [source]
    try {
        firstXmp := PillowTestTextBytes(StrReplace(PillowTestXmpPacket(), "Hello", "First"))
        lastXmp := PillowTestTextBytes(StrReplace(PillowTestXmpPacket(), "Hello", "Second"))
        explicitXmp := PillowTestTextBytes(StrReplace(PillowTestXmpPacket(), "Hello", "Explicit"))
        source.Save(sourcePath, "JPEG", { quality: 83, subsampling: 1 })
        bytes := PillowTestInsertJpegXmpApp1(PillowTestReadFileBytes(sourcePath), lastXmp)
        bytes := PillowTestInsertJpegXmpApp1(bytes, firstXmp)
        PillowTestWriteFileBytes(sourcePath, bytes)

        header := PillowTestTextBytes("http://ns.adobe.com/xap/1.0/")
        header.Push(0)
        segments := PillowTestFindJpegSegments(bytes, 0xE1, header)
        AhkTest.AssertEqual(2, segments.Length)
        AhkTest.AssertEqual(firstXmp, PillowTestArraySlice(
            bytes, segments[1].PayloadOffset + header.Length,
            segments[1].PayloadOffset + segments[1].PayloadLength - 1))
        AhkTest.AssertEqual(lastXmp, PillowTestArraySlice(
            bytes, segments[2].PayloadOffset + header.Length,
            segments[2].PayloadOffset + segments[2].PayloadLength - 1))
        sourceDqt := PillowTestReadJpegDqtPayloads(sourcePath)

        opened := Pillow.Image.Open(sourcePath, ["JPEG"])
        handles.Push(opened)
        AhkTest.AssertEqual(lastXmp, PillowTestBufferToArray(opened.Info["xmp"]))
        parsed := opened.getxmp()
        li := parsed["xmpmeta"]["RDF"]["Description"]["title"]["Alt"]["li"]
        AhkTest.AssertEqual("Second", li["text"])

        opened.Save(qualityKeepPath, "JPEG", { quality: "keep" })
        opened.Save(qtablesKeepPath, "JPEG", { qtables: "keep" })
        opened.Save(explicitPath, "JPEG", {
            quality: "keep", xmp: PillowTestBuffer(explicitXmp)
        })

        for path in implicitPaths {
            outputBytes := PillowTestReadFileBytes(path)
            AhkTest.AssertEqual(0, PillowTestFindJpegSegments(outputBytes, 0xE1, header).Length)
            savedDqt := PillowTestReadJpegDqtPayloads(path)
            AhkTest.AssertEqual(sourceDqt[1].Values, savedDqt[1].Values)
            AhkTest.AssertEqual(sourceDqt[2].Values, savedDqt[2].Values)
            loaded := Pillow.Image.Open(path, ["JPEG"])
            handles.Push(loaded)
            AhkTest.AssertTrue(!loaded.Info.Has("xmp"))
            AhkTest.AssertEqual(0, loaded.getxmp().Count)
        }

        explicitBytes := PillowTestReadFileBytes(explicitPath)
        explicitSegments := PillowTestFindJpegSegments(explicitBytes, 0xE1, header)
        AhkTest.AssertEqual(1, explicitSegments.Length)
        AhkTest.AssertEqual(explicitXmp, PillowTestArraySlice(
            explicitBytes, explicitSegments[1].PayloadOffset + header.Length,
            explicitSegments[1].PayloadOffset + explicitSegments[1].PayloadLength - 1))
        explicitLoaded := Pillow.Image.Open(explicitPath, ["JPEG"])
        handles.Push(explicitLoaded)
        AhkTest.AssertEqual(explicitXmp, PillowTestBufferToArray(explicitLoaded.Info["xmp"]))
        explicitLi := explicitLoaded.getxmp()["xmpmeta"]["RDF"]["Description"]["title"]["Alt"]["li"]
        AhkTest.AssertEqual("Explicit", explicitLi["text"])
    } finally {
        for handle in handles {
            if IsObject(handle)
                handle.Close()
        }
        for path in outputPaths
            PillowTestDeleteFile(path)
        PillowTestDeleteFile(sourcePath)
    }
}

AhkTest.Test("Pillow Image.Open JPEG multiple XMP APP1 packets uses last marker Info getxmp quality keep qtables keep explicit save precedence", PillowTestImageOpenJpegMultipleXmpPacketsUsesLastAndSavePrecedence)

PillowTestImageOpenJpegSegmentedExifConcatenatesAndSavePrecedence(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    source := Pillow.Image.New("RGB", [16, 8], [1, 2, 3])
    sourcePath := PillowTestTempJpegPath("segmented-exif-source")
    qualityKeepPath := PillowTestTempJpegPath("segmented-exif-quality-keep")
    qtablesKeepPath := PillowTestTempJpegPath("segmented-exif-qtables-keep")
    explicitPath := PillowTestTempJpegPath("segmented-exif-explicit")
    implicitPaths := [qualityKeepPath, qtablesKeepPath]
    outputPaths := [qualityKeepPath, qtablesKeepPath, explicitPath]
    handles := [source]
    try {
        source.Save(sourcePath, "JPEG", { quality: 83, subsampling: 1 })
        firstSegment := PillowTestExifOrientationSegment(3)
        secondSegment := PillowTestExifOrientationSegment(6)
        firstPayload := PillowTestArraySlice(firstSegment, 5, firstSegment.Length)
        secondPayload := PillowTestArraySlice(secondSegment, 5, secondSegment.Length)
        combinedExif := PillowTestArraySlice(firstPayload, 1, firstPayload.Length)
        loop secondPayload.Length - 6
            combinedExif.Push(secondPayload[A_Index + 6])
        sourceBytes := PillowTestInsertJpegSegmentsBeforeDqt(
            PillowTestReadFileBytes(sourcePath), [firstSegment, secondSegment])
        PillowTestWriteFileBytes(sourcePath, sourceBytes)
        prefix := [0x45, 0x78, 0x69, 0x66, 0, 0]
        AhkTest.AssertEqual(2, PillowTestFindJpegSegments(sourceBytes, 0xE1, prefix).Length)
        sourceDqt := PillowTestReadJpegDqtPayloads(sourcePath)

        opened := Pillow.Image.Open(sourcePath, ["JPEG"])
        handles.Push(opened)
        AhkTest.AssertEqual(combinedExif, PillowTestBufferToArray(opened.Info["exif"]))
        AhkTest.AssertEqual(3, opened.ExifOrientation())
        AhkTest.AssertEqual(3, opened.getexif()[274])

        opened.Save(qualityKeepPath, "JPEG", { quality: "keep" })
        opened.Save(qtablesKeepPath, "JPEG", { qtables: "keep" })
        opened.Save(explicitPath, "JPEG", {
            quality: "keep", exif: PillowTestBuffer(combinedExif)
        })

        for path in implicitPaths {
            outputBytes := PillowTestReadFileBytes(path)
            AhkTest.AssertEqual(0, PillowTestFindJpegSegments(outputBytes, 0xE1, prefix).Length)
            savedDqt := PillowTestReadJpegDqtPayloads(path)
            AhkTest.AssertEqual(sourceDqt[1].Values, savedDqt[1].Values)
            AhkTest.AssertEqual(sourceDqt[2].Values, savedDqt[2].Values)
            loaded := Pillow.Image.Open(path, ["JPEG"])
            handles.Push(loaded)
            AhkTest.AssertTrue(!loaded.Info.Has("exif"))
            AhkTest.AssertEqual(0, loaded.getexif().Length)
        }

        explicitBytes := PillowTestReadFileBytes(explicitPath)
        explicitSegments := PillowTestFindJpegSegments(explicitBytes, 0xE1, prefix)
        AhkTest.AssertEqual(1, explicitSegments.Length)
        AhkTest.AssertEqual(combinedExif, PillowTestArraySlice(
            explicitBytes, explicitSegments[1].PayloadOffset,
            explicitSegments[1].PayloadOffset + explicitSegments[1].PayloadLength - 1))
        explicitLoaded := Pillow.Image.Open(explicitPath, ["JPEG"])
        handles.Push(explicitLoaded)
        AhkTest.AssertEqual(combinedExif, PillowTestBufferToArray(explicitLoaded.Info["exif"]))
        AhkTest.AssertEqual(3, explicitLoaded.ExifOrientation())
        AhkTest.AssertEqual(3, explicitLoaded.getexif()[274])
    } finally {
        for handle in handles {
            if IsObject(handle)
                handle.Close()
        }
        for path in outputPaths
            PillowTestDeleteFile(path)
        PillowTestDeleteFile(sourcePath)
    }
}

