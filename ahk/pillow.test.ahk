PillowTestTiffPackBitsEncodeTile(values) {
    payload := [values.Length - 1]
    for value in values
        payload.Push(value)
    return payload
}

PillowTestTiffLzwEncodeTile(values) {
    codes := [256]
    for value in values
        codes.Push(value)
    codes.Push(257)
    payload := []
    accumulator := 0
    bitCount := 0
    for code in codes {
        accumulator := (accumulator << 9) | code
        bitCount += 9
        while bitCount >= 8 {
            bitCount -= 8
            payload.Push((accumulator >> bitCount) & 255)
        }
    }
    if bitCount > 0
        payload.Push((accumulator << (8 - bitCount)) & 255)
    return payload
}

PillowTestTiffDeflateStoredEncodeTile(values) {
    sum1 := 1
    sum2 := 0
    for value in values {
        sum1 := Mod(sum1 + value, 65521)
        sum2 := Mod(sum2 + sum1, 65521)
    }
    length := values.Length
    payload := [0x78, 0x01, 0x01, length & 255, (length >> 8) & 255,
        255 ^ (length & 255), 255 ^ ((length >> 8) & 255)]
    for value in values
        payload.Push(value)
    payload.Push((sum2 >> 8) & 255, sum2 & 255, (sum1 >> 8) & 255, sum1 & 255)
    return payload
}

PillowTestTiffPlanarSeparateTiledFixture(storage, compression := "raw") {
    if storage = "L" {
        channels := 1
        photometric := 1
        publicMode := "L"
        hasExtraSamples := false
        extraSamples := 0
    } else if storage = "RGB" {
        channels := 3
        photometric := 2
        publicMode := "RGB"
        hasExtraSamples := false
        extraSamples := 0
    } else if storage = "RGBA" {
        channels := 4
        photometric := 2
        publicMode := "RGBA"
        hasExtraSamples := true
        extraSamples := 2
    } else if storage = "LA" {
        channels := 2
        photometric := 1
        publicMode := "LA"
        hasExtraSamples := true
        extraSamples := 2
    } else {
        throw Error("Unsupported planar-separate tiled TIFF storage " storage, -1)
    }

    payloads := []
    Loop channels {
        channel := A_Index - 1
        Loop 4 {
            tileIndex := A_Index - 1
            tileX := Mod(tileIndex, 2) * 2
            tileY := Floor(tileIndex / 2) * 2
            payload := []
            Loop 2 {
                y := tileY + A_Index - 1
                Loop 2 {
                    x := tileX + A_Index - 1
                    if x < 4 && y < 3
                        payload.Push((y * 4 + x) * 13 + channel + 1)
                    else
                        payload.Push(0)
                }
            }
            payloads.Push(payload)
        }
    }

    compressionTag := 1
    if compression = "packbits" {
        compressionTag := 32773
        compressedPayloads := []
        for payload in payloads
            compressedPayloads.Push(PillowTestTiffPackBitsEncodeTile(payload))
        payloads := compressedPayloads
    } else if compression = "lzw" {
        compressionTag := 5
        compressedPayloads := []
        for payload in payloads
            compressedPayloads.Push(PillowTestTiffLzwEncodeTile(payload))
        payloads := compressedPayloads
    } else if compression = "deflate" {
        compressionTag := 8
        compressedPayloads := []
        for payload in payloads
            compressedPayloads.Push(PillowTestTiffDeflateStoredEncodeTile(payload))
        payloads := compressedPayloads
    } else if compression != "raw" {
        throw Error("Unsupported planar-separate tiled TIFF compression " compression, -1)
    }

    entryCount := hasExtraSamples ? 12 : 11
    ifdEnd := 8 + 2 + entryCount * 12 + 4
    bitsOffset := ifdEnd
    tileOffsetsOffset := channels > 2 ? bitsOffset + channels * 2 : bitsOffset
    tileByteCountsOffset := tileOffsetsOffset + channels * 4 * 4
    pixelOffset := tileByteCountsOffset + channels * 4 * 4
    tileOffsets := []
    tileByteCounts := []
    nextOffset := pixelOffset
    for payload in payloads {
        tileOffsets.Push(nextOffset)
        tileByteCounts.Push(payload.Length)
        nextOffset += payload.Length
    }

    bitsValue := channels = 1 ? 8 : (channels = 2 ? 0x00080008 : bitsOffset)
    entries := [
        [256, 4, 1, 4],
        [257, 4, 1, 3],
        [258, 3, channels, bitsValue],
        [259, 3, 1, compressionTag],
        [262, 3, 1, photometric],
        [277, 3, 1, channels],
        [284, 3, 1, 2],
        [322, 4, 1, 2],
        [323, 4, 1, 2],
        [324, 4, channels * 4, tileOffsetsOffset],
        [325, 4, channels * 4, tileByteCountsOffset]
    ]
    if hasExtraSamples
        entries.Push([338, 3, 1, extraSamples])

    bytes := [73, 73, 42, 0]
    PillowTestAppendLe32(bytes, 8)
    PillowTestAppendLe16(bytes, entries.Length)
    for entry in entries {
        PillowTestAppendLe16(bytes, entry[1])
        PillowTestAppendLe16(bytes, entry[2])
        PillowTestAppendLe32(bytes, entry[3])
        PillowTestAppendLe32(bytes, entry[4])
    }
    PillowTestAppendLe32(bytes, 0)
    if channels > 2 {
        Loop channels
            PillowTestAppendLe16(bytes, 8)
    }
    for offset in tileOffsets
        PillowTestAppendLe32(bytes, offset)
    for count in tileByteCounts
        PillowTestAppendLe32(bytes, count)
    for payload in payloads {
        for value in payload
            bytes.Push(value)
    }

    expected := []
    Loop 3 {
        pixelY := A_Index - 1
        Loop 4 {
            pixelX := A_Index - 1
            Loop channels {
                channel := A_Index - 1
                expected.Push((pixelY * 4 + pixelX) * 13 + channel + 1)
            }
        }
    }
    return { Bytes: bytes, Expected: expected, PublicMode: publicMode }
}

