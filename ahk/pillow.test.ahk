                    loop 2 {
                        frameIfd := PillowTestReadTiffIfdEntriesAt(tiffBytes, nextOffset)
                        entries := frameIfd.Entries
                        AhkTest.AssertEqual(16, entries[258].Value)
                        AhkTest.AssertEqual(testCase.Compression, entries[259].Value)
                        AhkTest.AssertEqual(2, entries[278].Value)
                        AhkTest.AssertFalse(entries.Has(317))
                        AhkTest.AssertFalse(entries.Has(339))
