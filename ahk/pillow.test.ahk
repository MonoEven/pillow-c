        })
        sourceDqt := PillowTestReadJpegDqtPayloads(sourcePath)
        AhkTest.AssertEqual(2, sourceDqt.Length)
        sourceSampling := [1, 2, 1, 0, 2, 1, 1, 1, 3, 1, 1, 1]
        AhkTest.AssertEqual(sourceSampling, PillowTestReadJpegSof0Sampling(sourcePath))

        opened := Pillow.Image.Open(sourcePath, ["JPEG"])
        handles.Push(opened)
        explicitIcc := PillowTestTextBytes("ICC-EXPLICIT-RST")
        explicitExif := PillowTestArraySlice(PillowTestExifOrientationSegment(6), 5, 36)
        opened.Save(savePath, "JPEG", {
            quality: "keep",
            subsampling: "keep",
            restart_marker_rows: 1,
            icc_profile: PillowTestBuffer(explicitIcc),
            exif: PillowTestBuffer(explicitExif)
        })

        savedDqt := PillowTestReadJpegDqtPayloads(savePath)
        AhkTest.AssertEqual(sourceDqt[1].Values, savedDqt[1].Values)
        AhkTest.AssertEqual(sourceDqt[2].Values, savedDqt[2].Values)
        AhkTest.AssertEqual(sourceSampling, PillowTestReadJpegSof0Sampling(savePath))
        restart := PillowTestReadJpegProgressiveRestartStructure(savePath)
        AhkTest.AssertEqual([29, 179, 29, 179], restart.DhtPayloadLengths)
        AhkTest.AssertEqual([3], restart.DriValues)
        AhkTest.AssertEqual([[0xD0, 0xD1, 0xD2]], restart.ScanRestartMarkers)

        savedBytes := PillowTestReadFileBytes(savePath)
        exifSegment := PillowTestFindJpegSegment(savedBytes, 0xE1, [0x45, 0x78, 0x69, 0x66, 0, 0])
        iccSegment := PillowTestFindJpegSegment(savedBytes, 0xE2, [0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0])
        commentSegment := PillowTestFindJpegSegment(savedBytes, 0xFE)
        dqtSegment := PillowTestFindJpegSegment(savedBytes, 0xDB)
        for segment in [exifSegment, iccSegment, commentSegment, dqtSegment]
            AhkTest.AssertTrue(segment.Found)
        AhkTest.AssertTrue(exifSegment.MarkerOffset < iccSegment.MarkerOffset)
        AhkTest.AssertTrue(iccSegment.MarkerOffset < commentSegment.MarkerOffset)
        AhkTest.AssertTrue(commentSegment.MarkerOffset < dqtSegment.MarkerOffset)

        loaded := Pillow.Image.Open(savePath, ["JPEG"])
        handles.Push(loaded)
        AhkTest.AssertEqual("RGB", loaded.Mode)
        AhkTest.AssertEqual([48, 32], loaded.Size)
        AhkTest.AssertEqual(PillowTestTextBytes("opened-keep-restart"),
            PillowTestBufferToArray(loaded.Info["comment"]))
        AhkTest.AssertEqual(explicitIcc, PillowTestBufferToArray(loaded.Info["icc_profile"]))
        AhkTest.AssertEqual(6, loaded.ExifOrientation())
    } finally {
        for handle in handles {
            if IsObject(handle)
                handle.Close()
        }
        PillowTestDeleteFile(savePath)
        PillowTestDeleteFile(sourcePath)
    }
}

