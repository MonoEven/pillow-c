PillowTestImageLabConvertPOptionPrecedenceLikePillow(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    images := []
    try {
        for size in [[1, 1], [0, 1], [1, 0], [0, 0]] {
            source := Pillow.Image.New("LAB", size)
            images.Push(source)
            for item in [
                { Dither: 0, Palette: 0, Colors: 2 },
                { Dither: 3, Palette: 99, Colors: 0 },
                { Dither: 99, Palette: 0, Colors: 257 },
            ] {
                try {
                    output := source.Convert("P", unset, item.Dither, item.Palette, item.Colors)
                    images.Push(output)
                    AhkTest.Fail("Expected LAB WEB palette conversion to fail")
                } catch Error as err {
                    AhkTest.AssertEqual("conversion from LAB to RGB not supported", err.Message)
                }
            }
        }

        nonempty := Pillow.Image.New("LAB", [1, 1])
        images.Push(nonempty)
        for colors in [0, 257] {
            try {
                output := nonempty.Convert("P", unset, 99, 1, colors)
                images.Push(output)
                AhkTest.Fail("Expected invalid adaptive colors to fail")
            } catch Error as err {
                AhkTest.AssertEqual("bad number of colors", err.Message)
            }
        }
        for colors in [1, 256] {
            try {
                output := nonempty.Convert("P", unset, 99, 1, colors)
                images.Push(output)
                AhkTest.Fail("Expected nonempty LAB adaptive conversion to fail")
            } catch Error as err {
                AhkTest.AssertEqual("image has wrong mode", err.Message)
            }
        }

        for size in [[0, 1], [1, 0], [0, 0]] {
            source := Pillow.Image.New("LAB", size)
            images.Push(source)
            source.Info["source_only"] := 1
            for item in [
                { Dither: 99, Colors: 0 },
                { Dither: 0, Colors: 1 },
                { Dither: 3, Colors: 256 },
                { Dither: 99, Colors: 257 },
            ] {
                output := source.Convert("P", unset, item.Dither, 1, item.Colors)
                images.Push(output)
                AhkTest.AssertEqual("P", output.Mode)
                AhkTest.AssertEqual(size, output.Size)
                AhkTest.AssertEqual(0, output.ToBytes().Size)
                AhkTest.AssertEqual([], output.GetPalette())
                AhkTest.AssertEqual(1, output.Info["source_only"])
            }
        }

        AhkTest.AssertEqual(0, Pillow.Palette.WEB)
        AhkTest.AssertEqual(1, Pillow.Palette.ADAPTIVE)
    } finally {
        loop images.Length {
            image := images[images.Length - A_Index + 1]
            if IsObject(image)
                image.Close()
        }
    }
}

AhkTest.Test("Pillow LAB convert P option precedence matches Pillow", PillowTestImageLabConvertPOptionPrecedenceLikePillow)

