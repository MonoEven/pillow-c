        254, 0, 0,
        0, 128, 254,
        10, 33, 53,
        255, 255, 255,
        0, 0, 0,
    ]
    filled := 0
    raw := 0
    rgb := 0
    empty := 0
    rawToRgb := 0
    rgbToYcbcr := 0
    roundTripRgb := 0
    emptyToRgb := 0
    try {
        filled := Pillow.Image.New("YCbCr", [2, 1], [10, 20, 30])
        raw := Pillow.Image.FromBytes("YCbCr", [4, 1], PillowTestBuffer(rawBytes))
        rgb := Pillow.Image.FromBytes("RGB", [5, 1], PillowTestBuffer(rgbBytes))
