PillowTestImageOpenJpegCollatesConflictingCountIccAndSavePrecedence(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    source := Pillow.Image.New("RGB", [16, 8], [1, 2, 3])
    sourcePath := PillowTestTempJpegPath("icc-conflicting-count-source")
    qualityKeepPath := PillowTestTempJpegPath("icc-conflicting-count-quality-keep")
    qtablesKeepPath := PillowTestTempJpegPath("icc-conflicting-count-qtables-keep")
    explicitPath := PillowTestTempJpegPath("icc-conflicting-count-explicit")
    implicitPaths := [qualityKeepPath, qtablesKeepPath]
    outputPaths := [qualityKeepPath, qtablesKeepPath, explicitPath]
    handles := [source]
    try {
        expectedIcc := [65, 66]
        source.Save(sourcePath, "JPEG", { quality: 83, subsampling: 1 })
        sourceBytes := PillowTestInsertJpegSegmentsBeforeDqt(
            PillowTestReadFileBytes(sourcePath), [
                PillowTestJpegIccApp2Segment(2, 3, [66]),
                PillowTestJpegIccApp2Segment(1, 2, [65])
            ])
        PillowTestWriteFileBytes(sourcePath, sourceBytes)
        header := PillowTestTextBytes("ICC_PROFILE")
        header.Push(0)
        AhkTest.AssertEqual(2,
            PillowTestFindJpegSegments(sourceBytes, 0xE2, header).Length)
        sourceDqt := PillowTestReadJpegDqtPayloads(sourcePath)

        opened := Pillow.Image.Open(sourcePath, ["JPEG"])
        handles.Push(opened)
        AhkTest.AssertTrue(opened.Info.Has("icc_profile"))
        AhkTest.AssertEqual(expectedIcc,
            PillowTestBufferToArray(opened.Info["icc_profile"]))

        opened.Save(qualityKeepPath, "JPEG", { quality: "keep" })
        opened.Save(qtablesKeepPath, "JPEG", { qtables: "keep" })
        opened.Save(explicitPath, "JPEG", {
            quality: "keep", icc_profile: PillowTestBuffer(expectedIcc)
        })

        for path in implicitPaths {
            outputBytes := PillowTestReadFileBytes(path)
            AhkTest.AssertEqual(0,
                PillowTestFindJpegSegments(outputBytes, 0xE2, header).Length)
            savedDqt := PillowTestReadJpegDqtPayloads(path)
            AhkTest.AssertEqual(sourceDqt[1].Values, savedDqt[1].Values)
            AhkTest.AssertEqual(sourceDqt[2].Values, savedDqt[2].Values)
            loaded := Pillow.Image.Open(path, ["JPEG"])
            handles.Push(loaded)
            AhkTest.AssertTrue(!loaded.Info.Has("icc_profile"))
        }

        explicitBytes := PillowTestReadFileBytes(explicitPath)
        explicitSegments := PillowTestFindJpegSegments(explicitBytes, 0xE2, header)
        AhkTest.AssertEqual(1, explicitSegments.Length)
        AhkTest.AssertEqual([1, 1, 65, 66], PillowTestArraySlice(
            explicitBytes, explicitSegments[1].PayloadOffset + header.Length,
            explicitSegments[1].PayloadOffset + explicitSegments[1].PayloadLength - 1))
        explicitLoaded := Pillow.Image.Open(explicitPath, ["JPEG"])
        handles.Push(explicitLoaded)
        AhkTest.AssertEqual(expectedIcc,
            PillowTestBufferToArray(explicitLoaded.Info["icc_profile"]))
    } finally {
        for handle in handles {
            if IsObject(handle)
                handle.Close()
        }
        for path in outputPaths
            PillowTestDeleteFile(path)
        PillowTestDeleteFile(sourcePath)
    }
}

