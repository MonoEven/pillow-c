    Pillow.Configure({ DllPath: PillowTestDllPath() })
    sourceValues := [0, 0, 0, 255, 0, 0, 138, 81, 70, 224, 177, 81, 75, 68, 144, 32, 254, 239]
    expectedValues := [1, 0, 1, 254, 255, 254, 127, 127, 127, 127, 127, 127, 22, 7, 252, 15, 34, 56]
    source := Pillow.Image.FromBytes("LAB", [3, 2], PillowTestBuffer(sourceValues), "raw", "LAB")
    source.Info["sentinel"] := "keep"
    secondSource := Pillow.Image.FromBytes("LAB", [1, 1], PillowTestBuffer([32, 254, 239]), "raw", "LAB")
    inputLab := Pillow.ImageCms.createProfile("LAB")
    outputSrgb := Pillow.ImageCms.createProfile("sRGB")
    baseProofSrgb := Pillow.ImageCms.createProfile("sRGB")
    profileBytes := baseProofSrgb.Serialize()
    proofSrgb := Pillow.ImageCms.getOpenProfile(profileBytes)
    transform := 0
    firstResult := 0
    secondResult := 0
    try {
        transform := Pillow.ImageCms.buildProofTransform(
            inputLab,
            outputSrgb,
            proofSrgb,
            "LAB",
            "RGB",
            3,
            3,
            0x5000
        )
        profileBytes := 0
        proofSrgb.Close()
        baseProofSrgb.Close()
        outputSrgb.Close()
        inputLab.Close()

        AhkTest.AssertTrue(transform is Pillow.ImageCms.ImageCmsTransform)
        AhkTest.AssertEqual("LAB", transform.input_mode)
        AhkTest.AssertEqual("RGB", transform.output_mode)

        firstResult := Pillow.ImageCms.applyTransform(source, transform)
        secondResult := Pillow.ImageCms.applyTransform(secondSource, transform)
        AhkTest.AssertEqual(expectedValues, PillowTestBufferToArray(firstResult.ToBytes()))
        AhkTest.AssertEqual([15, 34, 56], PillowTestBufferToArray(secondResult.ToBytes()))
        AhkTest.AssertEqual(sourceValues, PillowTestBufferToArray(source.ToBytes("raw", "LAB")))
        AhkTest.AssertEqual([32, 254, 239], PillowTestBufferToArray(secondSource.ToBytes("raw", "LAB")))
        AhkTest.AssertEqual(1, source.Info.Count)
        AhkTest.AssertEqual("keep", source.Info["sentinel"])
        AhkTest.AssertEqual(0, secondSource.Info.Count)
        firstIcc := firstResult.Info["icc_profile"]
        secondIcc := secondResult.Info["icc_profile"]
        AhkTest.AssertTrue(firstIcc is Buffer)
        AhkTest.AssertTrue(secondIcc is Buffer)
        AhkTest.AssertTrue(firstIcc.Ptr != secondIcc.Ptr)
        AhkTest.AssertEqual(588, firstIcc.Size)
        AhkTest.AssertEqual(588, secondIcc.Size)
        AhkTest.AssertEqual("acsp", StrGet(firstIcc.Ptr + 36, 4, "CP0"))
        AhkTest.AssertEqual("acsp", StrGet(secondIcc.Ptr + 36, 4, "CP0"))
    } finally {
        if IsObject(secondResult)
            secondResult.Close()
        if IsObject(firstResult)
            firstResult.Close()
        if IsObject(transform)
            transform.Close()
        if proofSrgb.Handle
            proofSrgb.Close()
        if baseProofSrgb.Handle
            baseProofSrgb.Close()
        if outputSrgb.Handle
            outputSrgb.Close()
        if inputLab.Handle
            inputLab.Close()
        secondSource.Close()
        source.Close()
    }
}

AhkTest.Test("Pillow ImageCms builds reusable LAB to RGB absolute gamut check soft proof transform", PillowTestImageCmsBuildsReusableLabToRgbAbsoluteGamutCheckSoftProofTransform)

PillowTestImageSaveJpegExtraMarkerStream(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    source := Pillow.Image.New("RGB", [16, 16], [1, 2, 3])
    path := PillowTestTempJpegPath("extra-marker-stream")
    loaded := 0
    try {
        extra := PillowTestBuffer([
            0xFF, 0xED, 0x00, 0x08, 0x54, 0x45, 0x53, 0x54, 0x01, 0x02,
            0xFF, 0xFE, 0x00, 0x08, 0x45, 0x58, 0x54, 0x52, 0x41, 0x21
        ])
        source.Save(path, "JPEG", { extra: extra })

        bytes := PillowTestReadFileBytes(path)
        app13 := PillowTestFindJpegSegment(bytes, 0xED)
        comment := PillowTestFindJpegSegment(bytes, 0xFE)
        dqt := PillowTestFindJpegSegment(bytes, 0xDB)
        AhkTest.AssertTrue(app13.Found)
        AhkTest.AssertTrue(comment.Found)
        AhkTest.AssertTrue(dqt.Found)
        AhkTest.AssertEqual([0x54, 0x45, 0x53, 0x54, 0x01, 0x02],
            PillowTestArraySlice(bytes, app13.PayloadOffset,
                app13.PayloadOffset + app13.PayloadLength - 1))
        AhkTest.AssertEqual([0x45, 0x58, 0x54, 0x52, 0x41, 0x21],
            PillowTestArraySlice(bytes, comment.PayloadOffset,
                comment.PayloadOffset + comment.PayloadLength - 1))
        AhkTest.AssertTrue(app13.MarkerOffset < comment.MarkerOffset)
        AhkTest.AssertTrue(comment.MarkerOffset < dqt.MarkerOffset)

        loaded := Pillow.Image.Open(path, ["JPEG"])
        AhkTest.AssertEqual("RGB", loaded.Mode)
        AhkTest.AssertEqual([16, 16], loaded.Size)
    } finally {
        if IsObject(loaded)
            loaded.Close()
        PillowTestDeleteFile(path)
        source.Close()
    }
}

