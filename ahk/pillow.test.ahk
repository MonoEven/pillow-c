    sourcePath := PillowTestTempTiffPath("pillow-early-change-lzw-i16")
    savePath := PillowTestTempTiffPath("save-early-change-lzw-i16")
    opened := 0
    image := 0
    try {
        expected := PillowTestI16EarlyChangeLzwRawBytes()
        PillowTestWriteFileBytes(sourcePath, PillowTestTiffI16EarlyChangeLzwBytes())

        try {
            opened := Pillow.Image.Open(sourcePath, ["TIFF"])
        } catch Error as err {
            AhkTest.Fail("Expected Pillow early-change LZW TIFF to open: " err.Message)
        }
        AhkTest.AssertEqual("TIFF", opened.Format)
        AhkTest.AssertEqual("I;16", opened.Mode)
        AhkTest.AssertEqual([256, 1], opened.Size)
        AhkTest.AssertEqual(expected, PillowTestBufferToArray(opened.ToBytes()))

        savePixels := PillowTestI16DictionaryFullLzwRawBytes()
        expectedBoundarySlice := [
            193, 148, 21, 129, 242, 1, 224, 184,
            32, 13, 39, 107, 112, 110, 73, 9,
            174, 140, 229, 198, 171, 212, 196, 221,
        ]
        image := Pillow.Image.FromBytes("I;16", [2048, 1], PillowTestBuffer(savePixels))
        image.Save(savePath, "TIFF", { compression: "tiff_lzw" })
        PillowTestAssertTiffCompressionTag(savePath, 5)

        bytes := PillowTestReadFileBytes(savePath)
        entries := PillowTestReadTiffIfd0Entries(bytes)
        AhkTest.AssertEqual(5585, entries[279].Value)
        stripOffset := entries[273].Value + 1
        sliceOffset := stripOffset + 5396
        AhkTest.AssertEqual(expectedBoundarySlice, PillowTestArraySlice(bytes, sliceOffset, sliceOffset + expectedBoundarySlice.Length - 1))
    } finally {
        if IsObject(image)
            image.Close()
        if IsObject(opened)
            opened.Close()
        PillowTestDeleteFile(savePath)
        PillowTestDeleteFile(sourcePath)
    }
}

