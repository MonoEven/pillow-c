PillowTestImageSaveTiffSaveAllThreeI16BigEndianUncompressedDpiIccXmpCompose(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    pixelSets := [
        [18, 52, 171, 205],
        [1, 2, 254, 220],
        [9, 10, 11, 12]
    ]
    icc := [9, 8, 7, 6, 5, 4, 3, 2]
    xmp := []
    Loop 120
        xmp.Push(A_Index - 1)
    images := []
    for pixels in pixelSets
        images.Push(Pillow.Image.FromBytes("I;16B", [2, 1], PillowTestBuffer(pixels)))
    path := PillowTestTempTiffPath("save-all-i16b-uncompressed-three-frames-dpi-icc-xmp")
    loaded := 0
    try {
        images[1].Save(path, "TIFF", {
            SaveAll: true,
            AppendImages: [images[2], images[3]],
            Dpi: [300, 150],
            IccProfile: PillowTestBuffer(icc),
            TiffInfo: Map(700, PillowTestBuffer(xmp)),
        })

        tiffBytes := PillowTestReadFileBytes(path)
        AhkTest.AssertEqual(1008, tiffBytes.Length)
        expectedIfdOffsets := [8, 344, 680]
        expectedNextIfdOffsets := [344, 680, 0]
        expectedXmpOffsets := [198, 534, 870]
        expectedIccOffsets := [318, 654, 990]
        expectedPixelOffsets := [326, 662, 998]
        for index, ifdOffset in expectedIfdOffsets {
            frameIfd := PillowTestReadTiffIfdEntriesAtEndian(tiffBytes, ifdOffset, false)
            entries := frameIfd.Entries
            AhkTest.AssertEqual(14, entries.Count)
            AhkTest.AssertEqual(16, entries[258].Value)
            AhkTest.AssertEqual(1, entries[259].Value)
            AhkTest.AssertEqual(1, entries[278].Value)
            AhkTest.AssertEqual(182 + (index - 1) * 336, entries[282].Value)
            AhkTest.AssertEqual(190 + (index - 1) * 336, entries[283].Value)
            AhkTest.AssertEqual(expectedXmpOffsets[index], entries[700].Value)
            AhkTest.AssertEqual(expectedIccOffsets[index], entries[34675].Value)
            AhkTest.AssertEqual(expectedPixelOffsets[index], entries[273].Value)
            AhkTest.AssertEqual(4, entries[279].Value)
            AhkTest.AssertEqual(xmp, PillowTestArraySlice(
                tiffBytes, entries[700].Value + 1, entries[700].Value + entries[700].Count
            ))
            AhkTest.AssertEqual(icc, PillowTestArraySlice(
                tiffBytes, entries[34675].Value + 1, entries[34675].Value + entries[34675].Count
            ))
            AhkTest.AssertEqual(pixelSets[index], PillowTestArraySlice(
                tiffBytes, entries[273].Value + 1, entries[273].Value + entries[279].Value
            ))
            AhkTest.AssertEqual(expectedNextIfdOffsets[index], frameIfd.NextOffset)
        }

        loaded := Pillow.Image.Open(path, ["TIFF"])
        AhkTest.AssertEqual(3, loaded.NFrames)
        for index, expected in pixelSets {
            loaded.Seek(index - 1)
            AhkTest.AssertEqual("I;16B", loaded.Mode)
            AhkTest.AssertEqual(expected, PillowTestBufferToArray(loaded.ToBytes()))
            PillowTestAssertFloatArrayClose([300.0, 150.0], loaded.Info["dpi"])
            AhkTest.AssertEqual(icc, PillowTestBufferToArray(loaded.Info["icc_profile"]))
            AhkTest.AssertEqual(xmp, PillowTestBufferToArray(loaded.Info["xmp"]))
            exif := loaded.GetExif()
            AhkTest.AssertEqual([300, 1], exif[282])
            AhkTest.AssertEqual([150, 1], exif[283])
            AhkTest.AssertEqual(2, exif[296])
            AhkTest.AssertEqual(xmp, PillowTestBufferToArray(exif[700]))
            AhkTest.AssertEqual(icc, PillowTestBufferToArray(exif[34675]))
        }
    } finally {
        if IsObject(loaded)
            loaded.Close()
        for image in images
            image.Close()
        PillowTestDeleteFile(path)
    }
}

