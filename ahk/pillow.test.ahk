            rgba := 0
            loaded.Close()
            loaded := 0
        }
    } finally {
        if IsObject(rgba)
            rgba.Close()
        if IsObject(loaded)
            loaded.Close()
        image.Close()
        for caseInfo in cases
            PillowTestDeleteFile(caseInfo.Path)
    }
}

