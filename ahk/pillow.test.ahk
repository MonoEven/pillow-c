PillowTestGifLzwDecodeIndices(data, minCodeSize, expectedCount) {
    clearCode := 1 << minCodeSize
    endCode := clearCode + 1
    codeSize := minCodeSize + 1
    nextCode := endCode + 1
    table := Map()
    loop clearCode
        table[A_Index - 1] := [A_Index - 1]
    bitPos := 0
    previous := []
    hasPrevious := false
    out := []

    loop {
        code := 0
        hasCode := true
        loop codeSize {
            byteIndex := bitPos // 8 + 1
            if byteIndex > data.Length {
                hasCode := false
                break
            }
            code := code | (((data[byteIndex] >> (bitPos & 7)) & 1) << (A_Index - 1))
            bitPos += 1
        }
        if !hasCode
            break
        if code = clearCode {
            table := Map()
            loop clearCode
                table[A_Index - 1] := [A_Index - 1]
            codeSize := minCodeSize + 1
            nextCode := endCode + 1
            previous := []
            hasPrevious := false
            continue
        }
        if code = endCode
            break
        if table.Has(code) {
            entry := table[code].Clone()
        } else if hasPrevious && code = nextCode {
            entry := previous.Clone()
            entry.Push(previous[1])
        } else {
            AhkTest.Fail("Invalid GIF LZW code")
        }
        for value in entry
            out.Push(value)
        if hasPrevious {
            newEntry := previous.Clone()
            newEntry.Push(entry[1])
            table[nextCode] := newEntry
            nextCode += 1
            if (nextCode = (1 << codeSize) && codeSize < 12)
                codeSize += 1
        }
        previous := entry
        hasPrevious := true
        if out.Length >= expectedCount
            break
    }

    decoded := []
    loop Min(expectedCount, out.Length)
        decoded.Push(out[A_Index])
    return decoded
}

PillowTestGifFrameDescriptors(path) {
    bytes := PillowTestReadFileBytes(path)
    AhkTest.AssertTrue(bytes.Length >= 13)
    AhkTest.AssertEqual([71, 73, 70], PillowTestArraySlice(bytes, 1, 3))
    pos := 14
    logicalPacked := bytes[11]
    backgroundIndex := bytes[12]
    globalColorCount := 0
    globalPaletteHead := []
    if logicalPacked & 0x80 {
        globalColorCount := 1 << ((logicalPacked & 0x07) + 1)
        globalPaletteBytes := globalColorCount * 3
        headLength := Min(globalPaletteBytes, 12)
        if headLength > 0
            globalPaletteHead := PillowTestArraySlice(bytes, pos, pos + headLength - 1)
        pos += globalPaletteBytes
    }

    frames := []
    pendingGce := { Packed: 0, DurationCs: -1, Disposal: 0, Transparency: -1 }
    while pos <= bytes.Length {
        introducer := bytes[pos]
        pos += 1
        if introducer = 0x3b
            break
        if introducer = 0x21 {
            label := bytes[pos]
            pos += 1
            if label = 0xf9 {
                blockSize := bytes[pos]
                pos += 1
                packed := bytes[pos]
                durationCs := PillowTestReadLe16(bytes, pos + 1)
                transparency := (packed & 0x01) ? bytes[pos + 3] : -1
                pendingGce := {
                    Packed: packed,
                    DurationCs: durationCs,
                    Disposal: (packed >> 2) & 0x07,
                    Transparency: transparency
                }
                pos += blockSize
                AhkTest.AssertEqual(0, bytes[pos])
                pos += 1
            } else {
                blockSize := bytes[pos]
                pos += 1 + blockSize
                while pos <= bytes.Length {
                    subBlockSize := bytes[pos]
                    pos += 1
                    if subBlockSize = 0
                        break
                    pos += subBlockSize
                }
            }
            continue
        }

        AhkTest.AssertEqual(0x2c, introducer)
        left := PillowTestReadLe16(bytes, pos)
        top := PillowTestReadLe16(bytes, pos + 2)
        width := PillowTestReadLe16(bytes, pos + 4)
        height := PillowTestReadLe16(bytes, pos + 6)
        flags := bytes[pos + 8]
        pos += 9
        localColorCount := 0
        localPaletteHead := []
        if flags & 0x80 {
            localColorCount := 1 << ((flags & 0x07) + 1)
            localPaletteBytes := localColorCount * 3
            headLength := Min(localPaletteBytes, 12)
            if headLength > 0
                localPaletteHead := PillowTestArraySlice(bytes, pos, pos + headLength - 1)
            pos += localColorCount * 3
        }
        lzwMin := bytes[pos]
        pos += 1
        dataBytes := 0
        imageData := []
        while pos <= bytes.Length {
            subBlockSize := bytes[pos]
            pos += 1
            if subBlockSize = 0
                break
            dataBytes += subBlockSize
            loop subBlockSize
                imageData.Push(bytes[pos + A_Index - 1])
            pos += subBlockSize
        }
        frames.Push({
            Left: left,
            Top: top,
            Width: width,
            Height: height,
            Flags: flags,
            BackgroundIndex: backgroundIndex,
            GlobalColorCount: globalColorCount,
            GlobalPaletteHead: globalPaletteHead,
            LocalColorCount: localColorCount,
            LocalPaletteHead: localPaletteHead,
            LzwMin: lzwMin,
            DataBytes: dataBytes,
            Indices: PillowTestGifLzwDecodeIndices(imageData, lzwMin, width * height),
            Gce: pendingGce
        })
        pendingGce := { Packed: 0, DurationCs: -1, Disposal: 0, Transparency: -1 }
    }
    return frames
}

PillowTestReadBe32(values, offset) {
    return (values[offset] << 24)
        | (values[offset + 1] << 16)
        | (values[offset + 2] << 8)
        | values[offset + 3]
}

PillowTestReadBe16(values, offset) {
    return (values[offset] << 8) | values[offset + 1]
}

PillowTestAppendBe16(values, value) {
    values.Push((value >> 8) & 0xff)
    values.Push(value & 0xff)
}

PillowTestAppendBe32(values, value) {
    values.Push((value >> 24) & 0xff)
    values.Push((value >> 16) & 0xff)
    values.Push((value >> 8) & 0xff)
    values.Push(value & 0xff)
}

PillowTestDeflateWriteBits(writer, value, bitCount) {
    loop bitCount {
        bit := (value >> (A_Index - 1)) & 1
        writer.Accumulator := writer.Accumulator | (bit << writer.BitCount)
        writer.BitCount += 1
        if writer.BitCount = 8 {
            writer.Bytes.Push(writer.Accumulator)
            writer.Accumulator := 0
            writer.BitCount := 0
        }
    }
}

PillowTestReverseBits(value, bitCount) {
    out := 0
    loop bitCount
        out := (out << 1) | ((value >> (A_Index - 1)) & 1)
    return out
}

PillowTestDeflateWriteFixedSymbol(writer, symbol) {
    if symbol <= 143 {
        code := 0x30 + symbol
        bits := 8
    } else if symbol <= 255 {
        code := 0x190 + symbol - 144
        bits := 9
    } else if symbol <= 279 {
        code := symbol - 256
        bits := 7
    } else {
        code := 0xC0 + symbol - 280
        bits := 8
    }
    PillowTestDeflateWriteBits(writer, PillowTestReverseBits(code, bits), bits)
}

PillowTestDeflateFlush(writer) {
    if writer.BitCount > 0 {
        writer.Bytes.Push(writer.Accumulator)
        writer.Accumulator := 0
        writer.BitCount := 0
    }
}

PillowTestZlibFixedRepeat(value, count) {
    writer := { Bytes: [], Accumulator: 0, BitCount: 0 }
    PillowTestDeflateWriteBits(writer, 0x03, 3)
    PillowTestDeflateWriteFixedSymbol(writer, value)
    repeatCount := (count - 1) // 258
    loop repeatCount {
        PillowTestDeflateWriteFixedSymbol(writer, 285)
        PillowTestDeflateWriteBits(writer, 0, 5)
    }
    PillowTestDeflateWriteFixedSymbol(writer, 256)
    PillowTestDeflateFlush(writer)

    out := [0x78, 0x01]
    for byte in writer.Bytes
        out.Push(byte)
    adlerA := Mod(1 + count * value, 65521)
    adlerB := Mod(count + value * ((count * (count + 1)) // 2), 65521)
    PillowTestAppendBe32(out, (adlerB << 16) | adlerA)
    return out
}

