            AhkTest.AssertEqual("CMYK", loaded.Mode)
            AhkTest.AssertEqual([17, 11], loaded.Size)
            AhkTest.AssertEqual([
                152, 88, 19, 208, 152, 88, 19, 208,
                152, 88, 19, 208, 152, 88, 19, 208,
                152, 88, 19, 208, 152, 88, 19, 208
            ], PillowTestArraySlice(
                PillowTestBufferToArray(loaded.ToBytes()), 1, 24))
        }
    } finally {
        for handle in handles {
            if IsObject(handle)
                handle.Close()
        }
        for path in outputPaths
            PillowTestDeleteFile(path)
    }
