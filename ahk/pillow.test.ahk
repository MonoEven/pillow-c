PillowTestWriteFileBytes(path, values) {
    buf := PillowTestBuffer(values)
    file := FileOpen(path, "w")
    try {
        file.RawWrite(buf, buf.Size)
    } finally {
        file.Close()
    }
}

PillowTestWriteFileText(path, text) {
    buf := Buffer(StrPut(text, "UTF-8"), 0)
    StrPut(text, buf, "UTF-8")
    file := FileOpen(path, "w")
    try {
        file.RawWrite(buf, buf.Size - 1)
    } finally {
        file.Close()
    }
}

PillowTestReadFileBytes(path) {
    file := FileOpen(path, "r")
    try {
        buf := Buffer(file.Length, 0)
        file.RawRead(buf, buf.Size)
        return PillowTestBufferToArray(buf)
    } finally {
        file.Close()
    }
}

PillowTestReadLe32(values, offset) {
    return values[offset]
        | (values[offset + 1] << 8)
        | (values[offset + 2] << 16)
        | (values[offset + 3] << 24)
}

PillowTestReadLe16(values, offset) {
    return values[offset] | (values[offset + 1] << 8)
}

PillowTestAppendLe16(values, value) {
    values.Push(value & 0xff)
    values.Push((value >> 8) & 0xff)
}

PillowTestAppendLe32(values, value) {
    values.Push(value & 0xff)
    values.Push((value >> 8) & 0xff)
    values.Push((value >> 16) & 0xff)
    values.Push((value >> 24) & 0xff)
}

PillowTestAppendLe64(values, value) {
    Loop 8 {
        values.Push(value & 0xff)
        value := value >> 8
    }
}

PillowTestAppendBe64(values, value) {
    bytes := []
    Loop 8 {
        bytes.Push(value & 0xff)
        value := value >> 8
    }
    Loop 8
        values.Push(bytes[9 - A_Index])
}

PillowTestAppendBigTiffEntry(values, entry, littleEndian := true) {
    append16 := littleEndian ? PillowTestAppendLe16 : PillowTestAppendBe16
    append64 := littleEndian ? PillowTestAppendLe64 : PillowTestAppendBe64
    append16.Call(values, entry[1])
    append16.Call(values, entry[2])
    append64.Call(values, entry[3])
    if littleEndian {
        append64.Call(values, entry[4])
        return
    }
    if entry[2] = 3 {
        if entry[1] = 258 && entry[3] > 1 {
            Loop entry[3]
                PillowTestAppendBe16(values, 8)
            Loop 8 - entry[3] * 2
                values.Push(0)
        } else {
            PillowTestAppendBe16(values, entry[4])
            Loop 6
                values.Push(0)
        }
    } else if entry[2] = 4 {
        PillowTestAppendBe32(values, entry[4])
        Loop 4
            values.Push(0)
    } else {
        PillowTestAppendBe64(values, entry[4])
    }
}

PillowTestByteSwapSamples(values, sampleSize) {
    out := []
    sampleCount := values.Length // sampleSize
    Loop sampleCount {
        offset := (A_Index - 1) * sampleSize
        Loop sampleSize
            out.Push(values[offset + sampleSize - A_Index + 1])
    }
    return out
}

PillowTestAppendAsciiZ(values, text, padEven := false) {
    loop StrLen(text)
        values.Push(Ord(SubStr(text, A_Index, 1)) & 0xff)
    values.Push(0)
    if padEven && Mod(values.Length, 2)
        values.Push(0)
}

PillowTestStringCodepoints(text) {
