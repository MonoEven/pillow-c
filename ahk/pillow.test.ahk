PillowTestImageCmsBuildsReusableLabToRgbTransform(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    labValues := [0, 0, 0, 255, 0, 0, 138, 81, 70, 224, 177, 81, 75, 68, 144, 32, 254, 239]
    source := Pillow.Image.FromBytes("LAB", [3, 2], PillowTestBuffer(labValues))
    source.Info["sentinel"] := "keep"
    secondSource := Pillow.Image.FromBytes("LAB", [1, 1], PillowTestBuffer([32, 254, 239]))
    lab := Pillow.ImageCms.createProfile("LAB")
    srgb := Pillow.ImageCms.createProfile("sRGB")
    transform := 0
    firstResult := 0
    secondResult := 0
    try {
        transform := Pillow.ImageCms.buildTransform(lab, srgb, "LAB", "RGB")
        lab.Close()
        srgb.Close()

        AhkTest.AssertTrue(transform is Pillow.ImageCms.ImageCmsTransform)
        AhkTest.AssertEqual("LAB", transform.InputMode)
        AhkTest.AssertEqual("RGB", transform.OutputMode)
        AhkTest.AssertEqual("LAB", transform.input_mode)
        AhkTest.AssertEqual("RGB", transform.output_mode)

        firstResult := Pillow.ImageCms.applyTransform(source, transform)
        secondResult := Pillow.ImageCms.applyTransform(secondSource, transform)
        AhkTest.AssertEqual(
            [1, 0, 1, 254, 255, 254, 251, 5, 4, 13, 254, 14, 22, 7, 252, 15, 34, 56],
            PillowTestBufferToArray(firstResult.ToBytes())
        )
        AhkTest.AssertEqual([15, 34, 56], PillowTestBufferToArray(secondResult.ToBytes()))
        AhkTest.AssertEqual(labValues, PillowTestBufferToArray(source.ToBytes()))
        AhkTest.AssertEqual("keep", source.Info["sentinel"])
        for result in [firstResult, secondResult] {
            AhkTest.AssertEqual(1, result.Info.Count)
