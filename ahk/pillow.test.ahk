    itxtPrefix := [67, 111, 109, 109, 101, 110, 116, 0, 1, 0, 101, 110, 0, 84, 114, 97, 110, 115, 108, 97, 116, 101, 100, 0]
    image := Pillow.Image.FromBytes("RGB", [2, 1], PillowTestBuffer(pixels))
