            ChunkType: [0x7A, 0x54, 0x58, 0x74],
            Key: "Note",
            Value: "Compressed hello",
            Prefix: [78, 111, 116, 101, 0, 0],
            ExactPayload: false,
            Order: ["icc", "chrm", "text"]
        },
        {
            Name: "language-itxt-exif",
            Configure: (pngInfo) => pngInfo.add_itxt("Comment", "Bonjour UTF8", "fr", "Commentaire"),
