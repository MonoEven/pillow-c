        AhkTest.AssertEqual(PillowTestGifTransparentLocalExpectedThirdBytes(1), seenBytes[3])

        AhkTest.AssertEqual(3, heldFrames.Length)
        AhkTest.AssertEqual(2, image.Tell())
        for frame in heldFrames {
