                            entries[273].Value + entries[279].Value
                        ))
                        AhkTest.AssertEqual(300, PillowTestReadLe32(tiffBytes, entries[282].Value + 1))
                        AhkTest.AssertEqual(1, PillowTestReadLe32(tiffBytes, entries[282].Value + 5))
                        AhkTest.AssertEqual(150, PillowTestReadLe32(tiffBytes, entries[283].Value + 1))
                        AhkTest.AssertEqual(1, PillowTestReadLe32(tiffBytes, entries[283].Value + 5))
                        AhkTest.AssertEqual(2, entries[296].Value)
                        nextOffset := frameIfd.NextOffset
                    }
                    AhkTest.AssertEqual(0, nextOffset)

                    loaded := Pillow.Image.Open(path, ["TIFF"])
                    AhkTest.AssertEqual(2, loaded.NFrames)
                    loop 2 {
                        loaded.Seek(A_Index - 1)
                        AhkTest.AssertEqual("I;16", loaded.Mode)
                        AhkTest.AssertEqual(
