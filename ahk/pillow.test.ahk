    cases := [
        { Mode: "I", Bytes: PillowTestBytesFromI32([1, -2, 300, -400, 5, 6]), PutType: "Int", Mutation: 123456 },
        { Mode: "F", Bytes: PillowTestBytesFromF32([1.25, -2.5, 3.75, -4.0, 5.5, -6.25]), PutType: "Float", Mutation: 123.5 },
    ]
    for item in cases {
        source := Pillow.Image.FromBytes(item.Mode, [3, 2], PillowTestBuffer(item.Bytes))
        duplicate := 0
        try {
            sourceData := source.DataPointer()
            duplicate := Pillow.ImageChops.Duplicate(source)

            AhkTest.AssertEqual(item.Mode, duplicate.Mode)
            AhkTest.AssertEqual([3, 2], duplicate.Size)
            AhkTest.AssertEqual(item.Bytes, PillowTestBufferToArray(duplicate.ToBytes()))
            AhkTest.AssertTrue(sourceData.Ptr != duplicate.DataPointer().Ptr)

            NumPut(item.PutType, item.Mutation, sourceData.Ptr, 0)
            AhkTest.AssertEqual(item.Bytes, PillowTestBufferToArray(duplicate.ToBytes()))

            source.Close()
            source := 0
            AhkTest.AssertEqual(item.Bytes, PillowTestBufferToArray(duplicate.ToBytes()))
        } finally {
            if IsObject(duplicate)
                duplicate.Close()
            if IsObject(source)
                source.Close()
        }
    }
}

