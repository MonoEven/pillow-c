                PillowTestReadJpegSofSampling(path, 0xC0))
            restart := PillowTestReadJpegProgressiveRestartStructure(path)
            AhkTest.AssertEqual([3], restart.DriValues)
            AhkTest.AssertEqual(testCase.RstCount,
                restart.ScanRestartMarkers[1].Length)

            loaded := Pillow.Image.Open(path, ["JPEG"])
            images.Push(loaded)
            AhkTest.AssertEqual([300, 150], loaded.Info["dpi"])
            AhkTest.AssertEqual([300, 150], loaded.Info["jfif_density"])
            AhkTest.AssertEqual(testCase.First,
                PillowTestArraySlice(
                    PillowTestBufferToArray(loaded.ToBytes()), 1, 4))
            AhkTest.AssertEqual(xmp,
                PillowTestBufferToArray(loaded.Info["xmp"]))
            AhkTest.AssertEqual(6, loaded.ExifOrientation())
            AhkTest.AssertEqual(comment,
                PillowTestBufferToArray(loaded.Info["comment"]))
            AhkTest.AssertEqual(iccProfile,
                PillowTestBufferToArray(loaded.Info["icc_profile"]))
            AhkTest.AssertEqual(exif,
                PillowTestBufferToArray(loaded.Info["exif"]))
        }

        conflicts := [
            { Name: "keep-over-web-low", Kind: "keep", Quality: "keep",
              QTables: "web_low", Subsampling: "web_low" },
            { Name: "keep-over-custom", Kind: "keep", Quality: "keep",
              QTables: customQTables, Subsampling: 2 },
            { Name: "keep-shadows-invalid", Kind: "keep", Quality: "keep",
              QTables: "not-a-preset", Subsampling: "not-a-sampling" },
            { Name: "web-low-over-keep", Kind: "web-low", Quality: "web_low",
              QTables: "keep", Subsampling: "keep" },
            { Name: "web-low-over-custom", Kind: "web-low", Quality: "web_low",
              QTables: customQTables, Subsampling: 0 },
            { Name: "web-low-shadows-invalid", Kind: "web-low", Quality: "web_low",
              QTables: "not-a-preset", Subsampling: "not-a-sampling" }
        ]
        for testCase in conflicts {
            path := PillowTestTempJpegPath(
                "real-ycck-simultaneous-quality-precedence-" testCase.Name)
            paths.Push(path)
            opened.Save(path, "JPEG", {
                quality: testCase.Quality,
                qtables: testCase.QTables,
                subsampling: testCase.Subsampling,
                dpi: [300, 150],
                comment: "real-ycck-ar",
                icc_profile: PillowTestBuffer(iccProfile),
                exif: PillowTestBuffer(exif),
                xmp: PillowTestBuffer(xmp),
                restart_marker_blocks: 3
            })
            AhkTest.AssertEqual(
                baselineBytes[testCase.Kind], PillowTestReadFileBytes(path))
        }
    } finally {
        for image in images
            image.Close()
        for path in paths
            PillowTestDeleteFile(path)
    }
}

