    exifPayload := PillowTestArraySlice(exif, 7, exif.Length)
    cases := [
        {
            Name: "ztxt",
            Configure: (pngInfo) => pngInfo.add_text("Note", "Compressed hello", true),
            ChunkType: [0x7A, 0x54, 0x58, 0x74],
