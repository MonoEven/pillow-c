        1, 0, 0, 0,
        127, 0, 0, 0,
        128, 0, 0, 0,
        255, 0, 0, 0,
        0, 1, 0, 0,
        232, 3, 0, 0,
        255, 255, 255, 127,
        0, 0, 0, 128,
    ]))
    modeF := Pillow.Image.FromBytes("F", [17, 1], PillowTestBuffer([
        0, 64, 150, 195,
        0, 0, 192, 191,
        0, 0, 0, 191,
        0, 0, 0, 0,
