                    for kmeans in [-1, 0, 1] {
                        if kmeans < 0 {
                            try {
                                output := source.Quantize(colors, Pillow.Quantize.MEDIANCUT, kmeans, , dither)
                                images.Push(output)
                                AhkTest.Fail("Expected negative LAB kmeans with dither to fail")
                            } catch Error as err {
                                AhkTest.AssertEqual("kmeans must not be negative", err.Message)
                            }
                        } else if size[1] != 0 && size[2] != 0 {
                            try {
                                output := source.Quantize(colors, Pillow.Quantize.MEDIANCUT, kmeans, , dither)
                                images.Push(output)
                                AhkTest.Fail("Expected nonempty LAB quantize with dither to fail")
                            } catch Error as err {
                                expected := colors = 0 || colors = 257 ? "bad number of colors" : "image has wrong mode"
