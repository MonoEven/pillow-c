        AhkTest.AssertEqual(iccProfile, PillowTestBufferToArray(rgbLoaded.Info["icc_profile"]))
        AhkTest.AssertEqual(exif, PillowTestBufferToArray(rgbLoaded.Info["exif"]))
        AhkTest.AssertEqual(xmp, PillowTestBufferToArray(rgbLoaded.Info["xmp"]))
    } finally {
        if IsObject(rgbLoaded)
            rgbLoaded.Close()
        if IsObject(lLoaded)
            lLoaded.Close()
        PillowTestDeleteFile(rgbPath)
        PillowTestDeleteFile(lPath)
