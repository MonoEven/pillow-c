                pngInfo.add(PillowTestBuffer(chunk.Type), PillowTestBuffer(chunk.Data), chunk.AfterIdat)

            image.Save(path, "PNG", { pnginfo: pngInfo, icc_profile: PillowTestBuffer(profile), exif: PillowTestBuffer(exif) })

