        images.Push(emptyPToPa)
        AhkTest.AssertEqual(0, emptyPToPa.ToBytes().Size)
        AhkTest.AssertEqual(paletteRgba, emptyPToPa.GetPalette("RGBA"))

        emptyPa := Pillow.Image.New("PA", [0, 1])
