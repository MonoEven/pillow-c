PillowTestReadJpegRestartMarkers(path) {
    bytes := PillowTestReadFileBytes(path)
    entropyOffset := 0
    loop bytes.Length - 3 {
        pos := A_Index
        if bytes[pos] = 0xFF && bytes[pos + 1] = 0xDA {
            entropyOffset := pos + 2 + PillowTestReadBe16(bytes, pos + 2)
            break
        }
    }
    AhkTest.AssertTrue(entropyOffset > 0)

    markers := []
    pos := entropyOffset
    while pos < bytes.Length {
        if bytes[pos] != 0xFF {
            pos += 1
            continue
        }
        marker := bytes[pos + 1]
        if marker = 0x00 {
            pos += 2
            continue
        }
        if marker >= 0xD0 && marker <= 0xD7 {
            markers.Push(marker)
            pos += 2
            continue
        }
        if marker = 0xD9
            break
        pos += 2
    }
    return markers
}

