PillowTestImageSaveJpegAllMetadataAndExtraMarkerStream(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    source := Pillow.Image.New("RGB", [16, 16], [1, 2, 3])
    path := PillowTestTempJpegPath("all-metadata-extra-marker-stream")
    loaded := 0
    try {
        extra := PillowTestBuffer([
            0xFF, 0xED, 0x00, 0x08, 0x54, 0x45, 0x53, 0x54, 0x01, 0x02,
            0xFF, 0xFE, 0x00, 0x08, 0x45, 0x58, 0x54, 0x52, 0x41, 0x21
        ])
        iccProfile := PillowTestBuffer([1, 2, 3, 4, 5, 6, 7, 8])
        exif := PillowTestBuffer(PillowTestArraySlice(PillowTestExifOrientationSegment(6), 5, 36))
        xmp := PillowTestBuffer(PillowTestTextBytes(PillowTestXmpPacket()))
        source.Save(path, "JPEG", {
            comment: "COMMENT",
            icc_profile: iccProfile,
            exif: exif,
            xmp: xmp,
            extra: extra
        })

        bytes := PillowTestReadFileBytes(path)
        exifSegment := PillowTestFindJpegSegment(bytes, 0xE1, [69, 120, 105, 102, 0, 0])
        app13 := PillowTestFindJpegSegment(bytes, 0xED)
        rawComments := PillowTestFindJpegSegments(bytes, 0xFE)
        xmpHeader := PillowTestTextBytes("http://ns.adobe.com/xap/1.0/")
        xmpHeader.Push(0)
        xmpSegment := PillowTestFindJpegSegment(bytes, 0xE1, xmpHeader)
        iccHeader := PillowTestTextBytes("ICC_PROFILE")
        iccHeader.Push(0, 1, 1)
        iccSegment := PillowTestFindJpegSegment(bytes, 0xE2, iccHeader)
        dqt := PillowTestFindJpegSegment(bytes, 0xDB)
        AhkTest.AssertTrue(exifSegment.Found)
        AhkTest.AssertTrue(app13.Found)
        AhkTest.AssertEqual(2, rawComments.Length)
        AhkTest.AssertTrue(xmpSegment.Found)
        AhkTest.AssertTrue(iccSegment.Found)
        AhkTest.AssertTrue(dqt.Found)
        AhkTest.AssertTrue(exifSegment.MarkerOffset < app13.MarkerOffset)
        AhkTest.AssertTrue(app13.MarkerOffset < rawComments[1].MarkerOffset)
        AhkTest.AssertTrue(rawComments[1].MarkerOffset < xmpSegment.MarkerOffset)
        AhkTest.AssertTrue(xmpSegment.MarkerOffset < iccSegment.MarkerOffset)
        AhkTest.AssertTrue(iccSegment.MarkerOffset < rawComments[2].MarkerOffset)
        AhkTest.AssertTrue(rawComments[2].MarkerOffset < dqt.MarkerOffset)
        AhkTest.AssertEqual([0x54, 0x45, 0x53, 0x54, 0x01, 0x02],
            PillowTestArraySlice(bytes, app13.PayloadOffset,
                app13.PayloadOffset + app13.PayloadLength - 1))
        AhkTest.AssertEqual([0x45, 0x58, 0x54, 0x52, 0x41, 0x21],
            PillowTestArraySlice(bytes, rawComments[1].PayloadOffset,
                rawComments[1].PayloadOffset + rawComments[1].PayloadLength - 1))
        AhkTest.AssertEqual([0x43, 0x4F, 0x4D, 0x4D, 0x45, 0x4E, 0x54],
            PillowTestArraySlice(bytes, rawComments[2].PayloadOffset,
                rawComments[2].PayloadOffset + rawComments[2].PayloadLength - 1))

        loaded := Pillow.Image.Open(path, ["JPEG"])
        AhkTest.AssertEqual("RGB", loaded.Mode)
        AhkTest.AssertEqual([16, 16], loaded.Size)
        AhkTest.AssertEqual([0x43, 0x4F, 0x4D, 0x4D, 0x45, 0x4E, 0x54],
            PillowTestBufferToArray(loaded.Info["comment"]))
        AhkTest.AssertEqual([1, 2, 3, 4, 5, 6, 7, 8],
            PillowTestBufferToArray(loaded.Info["icc_profile"]))
        AhkTest.AssertEqual(6, loaded.ExifOrientation())
        AhkTest.AssertEqual(PillowTestBufferToArray(xmp),
            PillowTestBufferToArray(loaded.Info["xmp"]))
    } finally {
        if IsObject(loaded)
            loaded.Close()
        PillowTestDeleteFile(path)
        source.Close()
    }
}

