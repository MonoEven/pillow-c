        rgba.Save(rgbaPath)
        for path in [lPath, rgbPath, rgbaPath]
            AhkTest.AssertEqual([73, 73, 42, 0], PillowTestArraySlice(PillowTestReadFileBytes(path), 1, 4))

        loadedL := Pillow.Image.Open(lPath)
        loadedRgb := Pillow.Image.Open(rgbPath)
