            AhkTest.AssertTrue(InStr(err.Message, "mask") > 0 || InStr(err.Message, "mismatch") > 0)
        }
    } finally {
        rgbaMask.Close()
        laMask.Close()
        la.Close()
        rgbMask.Close()
        rgb.Close()
        lMask.Close()
        l.Close()
        source.Close()
    }
}

