PillowTestImageCmsOpensSrgbProfileFromAbsolutePathWithFileLifetime(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    path := A_Temp "\pillow-ahk-cms-open-profile-path-" A_TickCount "-" Random(1, 1000000) ".icc"
    builtinProfile := Pillow.ImageCms.createProfile("sRGB")
    openedProfile := 0
    try {
        profileBytes := builtinProfile.Serialize()
        file := FileOpen(path, "w")
        try {
            file.RawWrite(profileBytes, profileBytes.Size)
        } finally {
            file.Close()
        }

        openedProfile := Pillow.ImageCms.getOpenProfile(path)
        AhkTest.AssertTrue(openedProfile is Pillow.ImageCms.ImageCmsProfile)
        AhkTest.AssertEqual(path, openedProfile.filename)
        AhkTest.AssertEqual(
            "sRGB built-in`n",
            Pillow.ImageCms.getProfileDescription(openedProfile)
        )

        deleteFailed := false
        try FileDelete(path)
        catch Error {
            deleteFailed := true
        }
        AhkTest.AssertTrue(deleteFailed)

        openedProfile.Close()
        FileDelete(path)
        AhkTest.AssertTrue(!FileExist(path))
    } finally {
        if IsObject(openedProfile)
            openedProfile.Close()
        builtinProfile.Close()
        try FileDelete(path)
    }
}

