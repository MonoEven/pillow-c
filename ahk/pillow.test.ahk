        0x34, 0x36
    ]
    cases := [
        {
            Name: "l-optimized",
            Mode: "L",
            Color: 7,
            QTables: [lumaQTable],
            Subsampling: -1,
            Progressive: false,
            Sof: 0xC0,
            Components: 1,
            DqtCount: 1
        },
        {
            Name: "rgb-progressive",
            Mode: "RGB",
            Color: [1, 2, 3],
            QTables: [lumaQTable, chromaQTable],
            Subsampling: 1,
            Progressive: true,
            Sof: 0xC2,
            Components: 3,
            DqtCount: 2
        },
        {
            Name: "cmyk-optimized",
            Mode: "CMYK",
            Color: [1, 2, 3, 4],
            QTables: [lumaQTable, chromaQTable],
            Subsampling: -1,
            Progressive: false,
            Sof: 0xC0,
            Components: 4,
            DqtCount: 2
        }
    ]
    for caseInfo in cases {
        path := PillowTestTempJpegPath("qtables-extra-" caseInfo.Name)
        source := 0
        try {
            source := Pillow.Image.New(caseInfo.Mode, [16, 16], caseInfo.Color)
            options := {
                quality: 75,
