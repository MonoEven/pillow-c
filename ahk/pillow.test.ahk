        lLoaded := Pillow.Image.Open(lPath, ["JPEG"])
        AhkTest.AssertEqual("L", lLoaded.Mode)
        AhkTest.AssertEqual([24, 16], lLoaded.Size)
        AhkTest.AssertEqual(lComment, PillowTestBufferToArray(lLoaded.Info["comment"]))

        comment := PillowTestTextBytes("restart-row-meta")
        iccProfile := [1, 2, 3, 4, 5, 6, 7, 8]
        exif := PillowTestArraySlice(PillowTestExifOrientationSegment(6), 5, 36)
        xmp := PillowTestTextBytes(PillowTestXmpPacket())
        rgb.Save(rgbPath, "JPEG", {
            quality: 75,
            restart_marker_rows: 1,
