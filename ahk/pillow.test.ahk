PillowTestImageHistogramMatchesNumericModes(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    modeI := Pillow.Image.FromBytes("I", [4, 1], PillowTestBuffer([
        254, 255, 255, 255,
        255, 255, 255, 255,
