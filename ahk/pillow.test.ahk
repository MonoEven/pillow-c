PillowTestTiffBigTiffTwoFrameCompressedChunkyTiledFixture(storage, compression, littleEndian := true) {
    if storage = "L" {
        channels := 1
        photometric := 1
        extraSamples := 0
        publicMode := "L"
    } else if storage = "RGB" {
        channels := 3
        photometric := 2
        extraSamples := 0
        publicMode := "RGB"
    } else if storage = "RGBA" {
        channels := 4
        photometric := 2
        extraSamples := 2
        publicMode := "RGBA"
    } else if storage = "LA" {
        channels := 2
        photometric := 1
        extraSamples := 2
        publicMode := "LA"
    } else {
        throw Error("Unsupported two-frame BigTIFF storage " storage, -1)
    }
    if compression = "packbits"
        compressionTag := 32773
    else if compression = "lzw"
        compressionTag := 5
    else if compression = "deflate"
        compressionTag := 8
    else
        throw Error("Unsupported two-frame BigTIFF compression " compression, -1)

    tileSize := 2 * 2 * channels
    framePayloads := []
    for frameIndex in [0, 1] {
        payloads := []
        Loop 4 {
            tileValues := []
            tileBase := frameIndex * 64 + (A_Index - 1) * tileSize
            Loop tileSize
                tileValues.Push(tileBase + A_Index)
            if compression = "packbits"
                payloads.Push(PillowTestTiffPackBitsEncodeTile(tileValues))
            else if compression = "lzw"
                payloads.Push(PillowTestTiffLzwEncodeTile(tileValues))
            else
                payloads.Push(PillowTestTiffDeflateStoredEncodeTile(tileValues))
        }
        framePayloads.Push(payloads)
    }

    bitsCount := channels
    entryCount := extraSamples ? 12 : 11
    ifdSize := 8 + entryCount * 20 + 8
    ifdOffsets := [16, 16 + ifdSize]
    cursor := 16 + 2 * ifdSize
    frameLayout := []
    for payloads in framePayloads {
        offsetsOffset := cursor
        cursor += 32
        countsOffset := cursor
        cursor += 32
        offsets := []
        counts := []
        for payload in payloads {
            offsets.Push(cursor)
            counts.Push(payload.Length)
            cursor += payload.Length
        }
        frameLayout.Push({ OffsetsOffset: offsetsOffset, CountsOffset: countsOffset, Offsets: offsets, Counts: counts, Payloads: payloads })
    }

    bitsValue := 0
    Loop bitsCount
        bitsValue |= 8 << ((A_Index - 1) * 16)
    bytes := littleEndian ? [73, 73, 43, 0] : [77, 77, 0, 43]
    append16 := littleEndian ? PillowTestAppendLe16 : PillowTestAppendBe16
    append64 := littleEndian ? PillowTestAppendLe64 : PillowTestAppendBe64
    append16.Call(bytes, 8)
    append16.Call(bytes, 0)
    append64.Call(bytes, 16)
    for frameIndex, layout in frameLayout {
        entries := [
            [256, 4, 1, 4],
            [257, 4, 1, 3],
            [258, 3, bitsCount, bitsValue],
            [259, 3, 1, compressionTag],
            [262, 3, 1, photometric],
            [277, 3, 1, channels],
            [284, 3, 1, 1],
            [322, 4, 1, 2],
            [323, 4, 1, 2],
            [324, 16, 4, layout.OffsetsOffset],
            [325, 16, 4, layout.CountsOffset]
        ]
        if extraSamples
            entries.Push([338, 3, 1, extraSamples])
        append64.Call(bytes, entries.Length)
        for entry in entries
            PillowTestAppendBigTiffEntry(bytes, entry, littleEndian)
        append64.Call(bytes, frameIndex = 1 ? ifdOffsets[2] : 0)
    }
    for layout in frameLayout {
        for offset in layout.Offsets
            append64.Call(bytes, offset)
        for count in layout.Counts
            append64.Call(bytes, count)
        for payload in layout.Payloads {
            for value in payload
                bytes.Push(value)
        }
    }

    expectedFrames := []
    for frameIndex in [0, 1] {
        expected := []
        Loop 3 {
            sourceY := A_Index - 1
            Loop 4 {
                sourceX := A_Index - 1
                tileIndex := Floor(sourceY / 2) * 2 + Floor(sourceX / 2)
                localX := Mod(sourceX, 2)
                localY := Mod(sourceY, 2)
                Loop channels
                    expected.Push(frameIndex * 64 + tileIndex * tileSize + localY * 2 * channels + localX * channels + A_Index)
            }
        }
        expectedFrames.Push(expected)
    }
    return { Bytes: bytes, ExpectedFrames: expectedFrames, PublicMode: publicMode }
}

