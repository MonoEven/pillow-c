    optimizedKeepPath := PillowTestTempJpegPath("opened-qtables-keep-optimize-422")
    optimizedDefaultPath := PillowTestTempJpegPath("opened-qtables-keep-optimize-420")
    progressiveKeepPath := PillowTestTempJpegPath("opened-qtables-keep-progressive-422")
    progressiveDefaultPath := PillowTestTempJpegPath("opened-qtables-keep-progressive-420")
    outputPaths := [optimizedKeepPath, optimizedDefaultPath, progressiveKeepPath, progressiveDefaultPath]
    handles := [image]
    try {
        lumaQTable := []
        chromaQTable := []
        loop 64 {
            index := A_Index - 1
            lumaQTable.Push(3 + Mod(index * 7, 57))
            chromaQTable.Push(5 + Mod(index * 11, 61))
        }
        sourceIcc := PillowTestTextBytes("ICC-SOURCE")
        sourceExif := PillowTestArraySlice(PillowTestExifOrientationSegment(3), 5, 36)
        image.Save(sourcePath, "JPEG", {
