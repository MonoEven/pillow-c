PillowTestImageSaveJpegOpenedRgbQTablesKeepExplicitIntegerSubsamplingRestartStrategies(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    values := []
    loop 32 {
        y := A_Index - 1
        loop 48 {
            x := A_Index - 1
            values.Push(Mod(x * 17 + y * 3, 256))
            values.Push(Mod(x * 5 + y * 29, 256))
            values.Push(Mod(x * 11 + y * 7, 256))
        }
    }
    image := Pillow.Image.FromBytes("RGB", [48, 32], PillowTestBuffer(values))
    sourcePath := PillowTestTempJpegPath("opened-qkeep-integer-subsampling-source")
    baseline444Path := PillowTestTempJpegPath("opened-qkeep-integer-subsampling-444")
    optimized422Path := PillowTestTempJpegPath("opened-qkeep-integer-subsampling-422")
    progressive420Path := PillowTestTempJpegPath("opened-qkeep-integer-subsampling-420")
    outputPaths := [baseline444Path, optimized422Path, progressive420Path]
    handles := [image]
    try {
        lumaQTable := []
        chromaQTable := []
        loop 64 {
            index := A_Index - 1
            lumaQTable.Push(3 + Mod(index * 7, 57))
            chromaQTable.Push(5 + Mod(index * 11, 61))
        }
        sourceIcc := PillowTestTextBytes("ICC-SOURCE")
        sourceExif := PillowTestArraySlice(PillowTestExifOrientationSegment(3), 5, 36)
        image.Save(sourcePath, "JPEG", {
            qtables: [lumaQTable, chromaQTable],
            subsampling: 1,
            comment: "opened-qkeep-integer-subsampling",
            icc_profile: PillowTestBuffer(sourceIcc),
            exif: PillowTestBuffer(sourceExif)
        })
        sourceDqt := PillowTestReadJpegDqtPayloads(sourcePath)
        AhkTest.AssertEqual(2, sourceDqt.Length)

        opened := Pillow.Image.Open(sourcePath, ["JPEG"])
        handles.Push(opened)
        explicitIcc := PillowTestTextBytes("ICC-EXPLICIT")
        explicitExif := PillowTestArraySlice(PillowTestExifOrientationSegment(6), 5, 36)
        saveCases := [
            { Path: baseline444Path, Options: {
                qtables: "keep", subsampling: 0, restart_marker_rows: 1,
                icc_profile: PillowTestBuffer(explicitIcc), exif: PillowTestBuffer(explicitExif)
            } },
            { Path: optimized422Path, Options: {
                qtables: "keep", subsampling: 1, optimize: true, restart_marker_rows: 1,
                icc_profile: PillowTestBuffer(explicitIcc), exif: PillowTestBuffer(explicitExif)
            } },
            { Path: progressive420Path, Options: {
                qtables: "keep", subsampling: 2, progressive: true, optimize: true,
                restart_marker_rows: 1,
                icc_profile: PillowTestBuffer(explicitIcc), exif: PillowTestBuffer(explicitExif)
            } }
        ]
        for testCase in saveCases
            opened.Save(testCase.Path, "JPEG", testCase.Options)

        sampling444 := [1, 1, 1, 0, 2, 1, 1, 1, 3, 1, 1, 1]
        sampling422 := [1, 2, 1, 0, 2, 1, 1, 1, 3, 1, 1, 1]
        sampling420 := [1, 2, 2, 0, 2, 1, 1, 1, 3, 1, 1, 1]
        progressive420Restarts := [
            [0xD0],
            [0xD0, 0xD1, 0xD2],
            [0xD0],
            [0xD0],
            [0xD0, 0xD1, 0xD2],
            [0xD0, 0xD1, 0xD2],
            [0xD0],
            [0xD0],
            [0xD0],
            [0xD0, 0xD1, 0xD2]
        ]
        testCases := [
            { Path: baseline444Path, Sof: 0xC0, Sampling: sampling444,
                Dri: [6], Restarts: [[0xD0, 0xD1, 0xD2]], DhtShape: "standard", SosCount: 1 },
            { Path: optimized422Path, Sof: 0xC0, Sampling: sampling422,
                Dri: [3], Restarts: [[0xD0, 0xD1, 0xD2]], DhtShape: "compact", SosCount: 1 },
            { Path: progressive420Path, Sof: 0xC2, Sampling: sampling420,
                Dri: [3, 6, 3, 6, 3, 6], Restarts: progressive420Restarts,
                DhtShape: "progressive", SosCount: 10 }
        ]
        for testCase in testCases {
            savedDqt := PillowTestReadJpegDqtPayloads(testCase.Path)
            AhkTest.AssertEqual(sourceDqt[1].Values, savedDqt[1].Values)
            AhkTest.AssertEqual(sourceDqt[2].Values, savedDqt[2].Values)
            AhkTest.AssertEqual(testCase.Sof, PillowTestReadJpegSofMarker(testCase.Path))
            actualSampling := testCase.Sof = 0xC0
                ? PillowTestReadJpegSof0Sampling(testCase.Path)
                : PillowTestReadJpegSofSampling(testCase.Path, 0xC2)
            AhkTest.AssertEqual(testCase.Sampling, actualSampling)
            AhkTest.AssertEqual(testCase.SosCount, PillowTestCountJpegSos(testCase.Path))
            restart := PillowTestReadJpegProgressiveRestartStructure(testCase.Path)
            if testCase.DhtShape = "standard" {
                AhkTest.AssertEqual([29, 179, 29, 179], restart.DhtPayloadLengths)
            } else if testCase.DhtShape = "compact" {
                AhkTest.AssertEqual(4, restart.DhtPayloadLengths.Length)
                AhkTest.AssertTrue(restart.DhtPayloadLengths[1] < 29)
                AhkTest.AssertTrue(restart.DhtPayloadLengths[2] < 179)
                AhkTest.AssertTrue(restart.DhtPayloadLengths[3] < 29)
                AhkTest.AssertTrue(restart.DhtPayloadLengths[4] < 179)
            } else {
                AhkTest.AssertEqual(10, restart.DhtPayloadLengths.Length)
            }
            AhkTest.AssertEqual(testCase.Dri, restart.DriValues)
            AhkTest.AssertEqual(testCase.Restarts, restart.ScanRestartMarkers)

            loaded := Pillow.Image.Open(testCase.Path, ["JPEG"])
            handles.Push(loaded)
            AhkTest.AssertEqual("RGB", loaded.Mode)
            AhkTest.AssertEqual([48, 32], loaded.Size)
            AhkTest.AssertEqual(PillowTestTextBytes("opened-qkeep-integer-subsampling"),
                PillowTestBufferToArray(loaded.Info["comment"]))
            AhkTest.AssertEqual(explicitIcc, PillowTestBufferToArray(loaded.Info["icc_profile"]))
            AhkTest.AssertEqual(6, loaded.ExifOrientation())
        }
    } finally {
        for handle in handles {
            if IsObject(handle)
                handle.Close()
        }
        for path in outputPaths
            PillowTestDeleteFile(path)
        PillowTestDeleteFile(sourcePath)
    }
}

AhkTest.Test("Pillow Image.Save JPEG opened RGB qtables keep baseline optimized progressive explicit integer subsampling restart strategies", PillowTestImageSaveJpegOpenedRgbQTablesKeepExplicitIntegerSubsamplingRestartStrategies)

