        images.Push(pToPa)
        AhkTest.AssertEqual([0, 0, 1, 1, 2, 128, 3, 255], PillowTestBufferToArray(pToPa.ToBytes()))
        AhkTest.AssertEqual(expectedPaletteRgb, pToPa.GetPalette("RGB"))
        AhkTest.AssertEqual(paletteRgba, pToPa.GetPalette("RGBA"))

        pRgb := Pillow.Image.FromBytes("P", [1, 1], PillowTestBuffer([0]))
        images.Push(pRgb)
        pRgb.PutPalette(paletteRgb, "RGB")
        pRgbToPa := pRgb.Convert("PA")
        images.Push(pRgbToPa)
        AhkTest.AssertEqual([0, 255], PillowTestBufferToArray(pRgbToPa.ToBytes()))

        pa := Pillow.Image.FromBytes("PA", [4, 1], PillowTestBuffer([0, 255, 1, 128, 2, 1, 3, 0]))
        images.Push(pa)
        pa.PutPalette(paletteRgba, "RGBA")
        paToP := pa.Convert("P")
        images.Push(paToP)
        AhkTest.AssertEqual([0, 1, 2, 3], PillowTestBufferToArray(paToP.ToBytes()))
        AhkTest.AssertEqual(expectedPaletteRgb, paToP.GetPalette("RGB"))
        AhkTest.AssertEqual(paletteRgba, paToP.GetPalette("RGBA"))

        paToRgba := pa.Convert("RGBA")
        images.Push(paToRgba)
        AhkTest.AssertEqual([
            10, 20, 30, 255,
            40, 50, 60, 128,
            70, 80, 90, 1,
            100, 110, 120, 0,
