            Text: false,
            Icc: true,
            Exif: false,
            Order: ["icc"]
        },
        {
            Path: PillowTestTempPngPath("save-compress-level-exif"),
            Text: false,
            Icc: false,
            Exif: true,
            Order: ["exif"]
        },
        {
            Path: PillowTestTempPngPath("save-compress-level-icc-exif"),
            Text: false,
            Icc: true,
            Exif: true,
            Order: ["icc", "exif"]
        },
        {
