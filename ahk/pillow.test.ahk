PillowTestImageSaveTiffSaveAllDpiUsesNativePath(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    pixelSets := [
        [10, 20, 30, 10, 20, 30, 40, 50, 60, 40, 50, 60],
        [70, 80, 90, 70, 80, 90, 100, 110, 120, 100, 110, 120],
    ]
    first := Pillow.Image.FromBytes("RGB", [2, 2], PillowTestBuffer(pixelSets[1]))
    second := Pillow.Image.FromBytes("RGB", [2, 2], PillowTestBuffer(pixelSets[2]))
    path := PillowTestTempTiffPath("save-all-rgb-dpi")
    loaded := 0
    try {
        first.Save(path, "TIFF", {
            SaveAll: true,
            AppendImages: [second],
            Dpi: [300, 150],
        })

        tiffBytes := PillowTestReadFileBytes(path)
        nextOffset := PillowTestReadLe32(tiffBytes, 5)
        loop 2 {
            frameIfd := PillowTestReadTiffIfdEntriesAt(tiffBytes, nextOffset)
            AhkTest.AssertTrue(frameIfd.Entries.Has(282))
            AhkTest.AssertEqual(300, PillowTestReadLe32(tiffBytes, frameIfd.Entries[282].Value + 1))
            AhkTest.AssertEqual(1, PillowTestReadLe32(tiffBytes, frameIfd.Entries[282].Value + 5))
            AhkTest.AssertEqual(150, PillowTestReadLe32(tiffBytes, frameIfd.Entries[283].Value + 1))
            AhkTest.AssertEqual(1, PillowTestReadLe32(tiffBytes, frameIfd.Entries[283].Value + 5))
            AhkTest.AssertEqual(2, frameIfd.Entries[296].Value)
            nextOffset := frameIfd.NextOffset
        }
        AhkTest.AssertEqual(0, nextOffset)

        loaded := Pillow.Image.Open(path, ["TIFF"])
        AhkTest.AssertEqual(2, loaded.NFrames)
        loop 2 {
            loaded.Seek(A_Index - 1)
            AhkTest.AssertEqual(pixelSets[A_Index], PillowTestBufferToArray(loaded.ToBytes()))
            AhkTest.AssertTrue(loaded.Info.Has("dpi"))
            PillowTestAssertFloatArrayClose([300.0, 150.0], loaded.Info["dpi"])
            exif := loaded.GetExif()
            AhkTest.AssertEqual([300, 1], exif[282])
            AhkTest.AssertEqual([150, 1], exif[283])
            AhkTest.AssertEqual(2, exif[296])
        }
    } finally {
        if IsObject(loaded)
            loaded.Close()
        second.Close()
        first.Close()
        PillowTestDeleteFile(path)
