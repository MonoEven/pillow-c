        if IsObject(pngLoaded)
            pngLoaded.Close()
        if IsObject(plain)
            plain.Close()
        if IsObject(jpegSource)
            jpegSource.Close()
        if IsObject(pngSource)
            pngSource.Close()
        PillowTestDeleteFile(pngPath)
        PillowTestDeleteFile(jpegPath)
    }
}

