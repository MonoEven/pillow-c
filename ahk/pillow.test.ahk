        emptyPaToP := emptyPa.Convert("P")
        images.Push(emptyPaToP)
        AhkTest.AssertEqual(0, emptyPaToP.ToBytes().Size)
        AhkTest.AssertEqual(paletteRgba, emptyPaToP.GetPalette("RGBA"))
        emptyPaToRgba := emptyPa.Convert("RGBA")
        images.Push(emptyPaToRgba)
        AhkTest.AssertEqual(0, emptyPaToRgba.ToBytes().Size)
    } finally {
        loop images.Length {
            image := images[images.Length - A_Index + 1]
            if IsObject(image)
                image.Close()
        }
    }
}

