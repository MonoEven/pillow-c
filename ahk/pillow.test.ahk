PillowTestImageQuantizeAlgorithmOptionsUseNativeMethods(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    source := Pillow.Image.FromBytes("RGB", [8, 4], PillowTestBuffer(PillowTestQuantizeStressRgbBytes(8, 4)))
    rgbaSource := 0
    median := 0
    maxCoverage := 0
    fastOctree := 0
    refined := 0
    rgbaOut := 0
    try {
        median := source.Quantize(4, Pillow.Quantize.MEDIANCUT, 0, unset, Pillow.Dither.NONE)
        maxCoverage := source.Quantize(4, Pillow.Quantize.MAXCOVERAGE, 0, unset, Pillow.Dither.NONE)
        fastOctree := source.Quantize(4, Pillow.Quantize.FASTOCTREE, 0, unset, Pillow.Dither.NONE)
        refined := source.Quantize(4, Pillow.Quantize.MEDIANCUT, 2, unset, Pillow.Dither.NONE)

        for image in [median, maxCoverage, fastOctree, refined] {
            AhkTest.AssertEqual("P", image.Mode)
            AhkTest.AssertEqual(32, image.ToBytes().Size)
            AhkTest.AssertTrue(image.GetPalette().Length > 0)
            AhkTest.AssertTrue(image.GetPalette().Length <= 12)
        }

        medianPalette := median.GetPalette()
        for candidate in [maxCoverage.GetPalette(), fastOctree.GetPalette(), refined.GetPalette()] {
            differences := 0
            for index, value in medianPalette {
                if index <= candidate.Length && value != candidate[index]
                    differences += 1
            }
            AhkTest.AssertTrue(differences > 0)
        }

        rgbaSource := Pillow.Image.FromBytes("RGBA", [2, 2], PillowTestBuffer([
            255, 0, 0, 255,
            1, 2, 3, 0,
            0, 255, 0, 255,
            0, 0, 255, 128,
        ]))
        rgbaOut := rgbaSource.Quantize(4, Pillow.Quantize.FASTOCTREE, 0, unset, Pillow.Dither.NONE)
        AhkTest.AssertEqual("P", rgbaOut.Mode)
        AhkTest.AssertTrue(rgbaOut.GetPalette("RGBA").Length > 0)
        AhkTest.AssertTrue(rgbaOut.GetPalette("RGBA").Length <= 16)
    } finally {
