PillowTestScaleJpegQTable(values, quality) {
    if quality = -1
        return values.Clone()
    q := quality = -1 ? 75 : Max(1, Min(quality, 100))
    scale := q < 50 ? Floor(5000 / q) : 200 - q * 2
    out := []
    for value in values {
        scaled := Floor((value * scale + 50) / 100)
        out.Push(Max(1, Min(scaled, 255)))
    }
    return out
}

