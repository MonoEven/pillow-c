PillowTestTiffBigTiffTiledWideModeFixture(storage, compression, littleEndian := true) {
    if storage = "I;16" {
        bytesPerPixel := 2
        bitsPerSample := 16
        photometric := 1
        hasSampleFormat := false
        sampleFormat := 1
        publicMode := "I;16"
        raster := [
            1, 0, 2, 1, 255, 15, 255, 255,
            0, 128, 17, 0, 96, 234, 255, 0,
            0, 1, 0, 4, 255, 127, 80, 195
        ]
    } else if storage = "I" {
        bytesPerPixel := 4
        bitsPerSample := 32
        photometric := 1
        hasSampleFormat := true
        sampleFormat := 2
        publicMode := "I"
        raster := [
            24, 252, 255, 255, 255, 255, 255, 255, 0, 0, 0, 0, 1, 0, 0, 0,
            64, 226, 1, 0, 15, 4, 246, 255, 255, 255, 255, 127, 0, 0, 0, 128,
            42, 0, 0, 0, 0, 0, 1, 0, 0, 128, 255, 255, 63, 66, 15, 0
        ]
    } else if storage = "F" {
        bytesPerPixel := 4
        bitsPerSample := 32
        photometric := 1
        hasSampleFormat := true
        sampleFormat := 3
        publicMode := "F"
        raster := [
            0, 0, 0, 63, 0, 0, 160, 191, 0, 0, 0, 0, 0, 0, 128, 63,
            0, 0, 112, 64, 0, 0, 199, 194, 0, 36, 116, 73, 111, 18, 131, 186,
            0, 128, 40, 66, 0, 0, 128, 71, 128, 0, 0, 199, 0, 0, 20, 65
        ]
    } else if storage = "CMYK" {
        bytesPerPixel := 4
        bitsPerSample := 8
        photometric := 5
        hasSampleFormat := false
        sampleFormat := 1
        publicMode := "CMYK"
        raster := []
        Loop 12 {
            pixel := A_Index - 1
            Loop 4
                raster.Push(pixel * 17 + A_Index)
        }
    } else {
        throw Error("Unsupported BigTIFF tiled wide mode " storage, -1)
    }

    fileRaster := raster
    expectedRaster := raster
    if !littleEndian {
        if storage = "I;16" {
            fileRaster := PillowTestByteSwapSamples(raster, 2)
            expectedRaster := fileRaster
            publicMode := "I;16B"
        } else if storage = "I" || storage = "F" {
            fileRaster := PillowTestByteSwapSamples(raster, 4)
        }
    }

    payloads := []
    Loop 4 {
        tileIndex := A_Index - 1
        tileX := Mod(tileIndex, 2) * 2
        tileY := Floor(tileIndex / 2) * 2
        payload := []
        Loop 2 {
            y := tileY + A_Index - 1
            Loop 2 {
                x := tileX + A_Index - 1
                if x < 4 && y < 3 {
                    sourceOffset := (y * 4 + x) * bytesPerPixel
                    Loop bytesPerPixel
                        payload.Push(fileRaster[sourceOffset + A_Index])
                } else {
                    Loop bytesPerPixel
                        payload.Push(0)
                }
            }
        }
        if compression = "raw"
            payloads.Push(payload)
        else if compression = "packbits"
            payloads.Push(PillowTestTiffPackBitsEncodeTile(payload))
        else if compression = "lzw"
            payloads.Push(PillowTestTiffLzwEncodeTile(payload))
        else if compression = "deflate"
            payloads.Push(PillowTestTiffDeflateStoredEncodeTile(payload))
        else
            throw Error("Unsupported BigTIFF tiled wide-mode compression " compression, -1)
    }

    compressionTag := compression = "raw" ? 1 : (compression = "packbits" ? 32773 : (compression = "lzw" ? 5 : 8))
    samplesPerPixel := storage = "CMYK" ? 4 : 1
    entryCount := hasSampleFormat ? 12 : 11
    ifdEnd := 16 + 8 + entryCount * 20 + 8
    tileOffsetsOffset := ifdEnd
    tileByteCountsOffset := tileOffsetsOffset + 32
    pixelOffset := tileByteCountsOffset + 32
    tileOffsets := []
    tileByteCounts := []
    nextOffset := pixelOffset
    for payload in payloads {
        tileOffsets.Push(nextOffset)
        tileByteCounts.Push(payload.Length)
        nextOffset += payload.Length
    }
    bitsValue := storage = "CMYK" ? 0x0008000800080008 : bitsPerSample
    entries := [
        [256, 4, 1, 4],
        [257, 4, 1, 3],
        [258, 3, samplesPerPixel, bitsValue],
        [259, 3, 1, compressionTag],
        [262, 3, 1, photometric],
        [277, 3, 1, samplesPerPixel],
        [284, 3, 1, 1],
        [322, 4, 1, 2],
        [323, 4, 1, 2],
        [324, 16, 4, tileOffsetsOffset],
        [325, 16, 4, tileByteCountsOffset]
    ]
    if hasSampleFormat
        entries.Push([339, 3, 1, sampleFormat])

    bytes := littleEndian ? [73, 73, 43, 0] : [77, 77, 0, 43]
    append16 := littleEndian ? PillowTestAppendLe16 : PillowTestAppendBe16
    append64 := littleEndian ? PillowTestAppendLe64 : PillowTestAppendBe64
    append16.Call(bytes, 8)
    append16.Call(bytes, 0)
    append64.Call(bytes, 16)
    append64.Call(bytes, entries.Length)
    for entry in entries
        PillowTestAppendBigTiffEntry(bytes, entry, littleEndian)
    append64.Call(bytes, 0)
    for offset in tileOffsets
        append64.Call(bytes, offset)
    for count in tileByteCounts
        append64.Call(bytes, count)
    for payload in payloads {
        for value in payload
            bytes.Push(value)
    }
    return { Bytes: bytes, Expected: expectedRaster, PublicMode: publicMode }
}

