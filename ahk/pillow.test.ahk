        AhkTest.AssertEqual("P", lToP.Mode)
        AhkTest.AssertEqual([0, 1, 127, 128, 129, 255], PillowTestBufferToArray(lToP.ToBytes()))
        AhkTest.AssertEqual([], lToP.GetPalette())
