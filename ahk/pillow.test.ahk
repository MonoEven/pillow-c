        image := Pillow.Image.Open(sourcePath, ["JPEG"])
        handles.Push(image)
        AhkTest.AssertEqual("CMYK", image.Mode)
        AhkTest.AssertEqual([17, 11], image.Size)
        actual := PillowTestBufferToArray(image.ToBytes())
        AhkTest.AssertEqual([
            153, 88, 22, 208, 153, 88, 22, 208,
            153, 88, 22, 208, 153, 88, 22, 208,
            153, 88, 22, 208, 153, 88, 22, 208
        ], PillowTestArraySlice(actual, 1, 24))
        AhkTest.AssertEqual([
            33, 128, 3, 16, 33, 128, 1, 17,
            33, 128, 3, 16, 33, 128, 1, 17,
            33, 128, 3, 16, 33, 128, 1, 17
        ], PillowTestArraySlice(actual, 363, 386))
        AhkTest.AssertEqual([
            0, 35, 68, 16, 0, 34, 68, 16,
            0, 35, 68, 16, 0, 34, 68, 16,
            0, 35, 68, 16, 0, 34, 68, 16
        ], PillowTestArraySlice(actual, 725, 748))

        image.Save(qualityKeepPath, "JPEG", { quality: "keep" })
        image.Save(qtablesKeepPath, "JPEG", { qtables: "keep" })
        AhkTest.AssertEqual(PillowTestReadFileBytes(qualityKeepPath),
            PillowTestReadFileBytes(qtablesKeepPath))

        for path in outputPaths {
            savedBytes := PillowTestReadFileBytes(path)
            savedApp14 := PillowTestFindJpegSegment(
                savedBytes, 0xEE, [65, 100, 111, 98, 101])
            AhkTest.AssertTrue(savedApp14.Found)
            AhkTest.AssertEqual(0,
                savedBytes[savedApp14.PayloadOffset + 11])
            savedDqt := PillowTestReadJpegDqtPayloads(path)
            AhkTest.AssertEqual(sourceDqt[1].Values,
                savedDqt[1].Values)
            AhkTest.AssertEqual(sourceDqt[2].Values,
                savedDqt[2].Values)
            AhkTest.AssertEqual([
                67, 1, 1, 0,
                77, 1, 1, 1,
                89, 1, 1, 1,
                75, 1, 1, 1
            ], PillowTestReadJpegSof0Sampling(path))

            loaded := Pillow.Image.Open(path, ["JPEG"])
