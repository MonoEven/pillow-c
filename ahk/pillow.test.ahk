PillowTestImageSaveJpegRestartMarkersExtraBoundedMatrix(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    lumaQTable := []
    chromaQTable := []
    loop 64 {
        index := A_Index - 1
        lumaQTable.Push(2 + Mod(index, 8))
        chromaQTable.Push(3 + Mod(index, 7))
    }
    extra := PillowTestBuffer([0xFF, 0xED, 0x00, 0x0A, 0x45, 0x58, 0x54, 0x52, 0x41, 0x52, 0x53, 0x54])
    metadataComment := "restart-extra-meta"
    metadataIcc := [1, 2, 3, 4, 5, 6, 7, 8]
    metadataExif := PillowTestArraySlice(PillowTestExifOrientationSegment(6), 5, 36)
    metadataXmp := PillowTestTextBytes(PillowTestXmpPacket())
    cases := [
        { Name: "l-rows", Mode: "L", Color: 7, Width: 24, Height: 16, Subsampling: -1, Progressive: false, Optimize: false, Blocks: 0, Rows: 1, Dri: 3, Sof: 0xC0 },
        { Name: "rgb-progressive", Mode: "RGB", Color: [1, 2, 3], Width: 32, Height: 32, Subsampling: -1, Progressive: true, Optimize: true, Blocks: 1, Rows: 0, Dri: 1, Sof: 0xC2 },
        { Name: "cmyk-baseline", Mode: "CMYK", Color: [1, 2, 3, 4], Width: 32, Height: 16, Subsampling: -1, Progressive: false, Optimize: false, Blocks: 3, Rows: 0, Dri: 3, Sof: 0xC0 },
        { Name: "rgb-qtables", Mode: "RGB", Color: [1, 2, 3], Width: 32, Height: 32, QTables: [lumaQTable, chromaQTable], Subsampling: 0, Progressive: false, Optimize: true, Blocks: 1, Rows: 0, Dri: 1, Sof: 0xC0, Comment: metadataComment, Icc: metadataIcc, Exif: metadataExif, Xmp: metadataXmp }
    ]
    for caseInfo in cases {
        source := Pillow.Image.New(caseInfo.Mode, [caseInfo.Width, caseInfo.Height], caseInfo.Color)
        path := PillowTestTempJpegPath("restart-marker-extra-" caseInfo.Name)
        loaded := 0
        try {
            options := {
                quality: 75,
                extra: extra,
                restart_marker_blocks: caseInfo.Blocks
            }
            if caseInfo.Rows {
                options.DeleteProp("restart_marker_blocks")
                options.restart_marker_rows := caseInfo.Rows
            }
            if caseInfo.HasOwnProp("QTables")
                options.qtables := caseInfo.QTables
            if caseInfo.HasOwnProp("Comment")
                options.comment := caseInfo.Comment
            if caseInfo.HasOwnProp("Icc")
                options.icc_profile := PillowTestBuffer(caseInfo.Icc)
            if caseInfo.HasOwnProp("Exif")
                options.exif := PillowTestBuffer(caseInfo.Exif)
            if caseInfo.HasOwnProp("Xmp")
                options.xmp := PillowTestBuffer(caseInfo.Xmp)
            if caseInfo.Subsampling != -1
                options.subsampling := caseInfo.Subsampling
            if caseInfo.Progressive
                options.progressive := true
            if caseInfo.Optimize
                options.optimize := true
            source.Save(path, "JPEG", options)

            bytes := PillowTestReadFileBytes(path)
            extraSegment := PillowTestFindJpegSegment(bytes, 0xED)
            dqt := PillowTestFindJpegSegment(bytes, 0xDB)
            dri := PillowTestFindJpegSegment(bytes, 0xDD)
            AhkTest.AssertTrue(extraSegment.Found)
            AhkTest.AssertTrue(dqt.Found)
            AhkTest.AssertTrue(dri.Found)
            AhkTest.AssertTrue(extraSegment.MarkerOffset < dqt.MarkerOffset)
            AhkTest.AssertTrue(dqt.MarkerOffset < dri.MarkerOffset)
            AhkTest.AssertEqual(caseInfo.Dri, PillowTestReadBe16(bytes, dri.PayloadOffset))
            AhkTest.AssertEqual(caseInfo.Sof, PillowTestReadJpegSofMarker(path))
            if caseInfo.HasOwnProp("Comment") {
                exifSegment := PillowTestFindJpegSegment(bytes, 0xE1, [0x45, 0x78, 0x69, 0x66, 0, 0])
                xmpHeader := PillowTestTextBytes("http://ns.adobe.com/xap/1.0/")
                xmpHeader.Push(0)
                xmpSegment := PillowTestFindJpegSegment(bytes, 0xE1, xmpHeader)
                iccSegment := PillowTestFindJpegSegment(bytes, 0xE2, [0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0])
                commentSegment := PillowTestFindJpegSegment(bytes, 0xFE)
                AhkTest.AssertTrue(exifSegment.Found)
                AhkTest.AssertTrue(xmpSegment.Found)
                AhkTest.AssertTrue(iccSegment.Found)
                AhkTest.AssertTrue(commentSegment.Found)
                AhkTest.AssertTrue(exifSegment.MarkerOffset < extraSegment.MarkerOffset)
                AhkTest.AssertTrue(extraSegment.MarkerOffset < xmpSegment.MarkerOffset)
                AhkTest.AssertTrue(xmpSegment.MarkerOffset < iccSegment.MarkerOffset)
                AhkTest.AssertTrue(iccSegment.MarkerOffset < commentSegment.MarkerOffset)
                AhkTest.AssertTrue(commentSegment.MarkerOffset < dqt.MarkerOffset)
            }
            if caseInfo.Progressive
                AhkTest.AssertTrue(PillowTestCountJpegSos(path) > 1)
            loaded := Pillow.Image.Open(path, ["JPEG"])
            AhkTest.AssertEqual(caseInfo.Mode, loaded.Mode)
            AhkTest.AssertEqual([caseInfo.Width, caseInfo.Height], loaded.Size)
            if caseInfo.HasOwnProp("Comment") {
                AhkTest.AssertEqual(PillowTestTextBytes(metadataComment),
                    PillowTestBufferToArray(loaded.Info["comment"]))
                AhkTest.AssertEqual(metadataIcc,
                    PillowTestBufferToArray(loaded.Info["icc_profile"]))
                AhkTest.AssertEqual(metadataXmp,
                    PillowTestBufferToArray(loaded.Info["xmp"]))
                AhkTest.AssertEqual(6, loaded.ExifOrientation())
            }
        } finally {
            if IsObject(loaded)
                loaded.Close()
            PillowTestDeleteFile(path)
            source.Close()
        }
    }
}

