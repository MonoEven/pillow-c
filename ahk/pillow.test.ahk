PillowTestImageSaveJpegExtraMarkerStreamOptions(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    extra := PillowTestBuffer([
        0xFF, 0xED, 0x00, 0x08, 0x54, 0x45, 0x53, 0x54, 0x01, 0x02,
        0xFF, 0xFE, 0x00, 0x08, 0x45, 0x58, 0x54, 0x52, 0x41, 0x21
    ])
    cases := [
        { Mode: "L", Color: 0, Progressive: false, Optimize: false },
        { Mode: "L", Color: 0, Progressive: false, Optimize: true },
        { Mode: "L", Color: 0, Progressive: true, Optimize: false },
        { Mode: "RGB", Color: [1, 2, 3], Progressive: false, Optimize: false },
        { Mode: "RGB", Color: [1, 2, 3], Progressive: false, Optimize: true },
        { Mode: "RGB", Color: [1, 2, 3], Progressive: true, Optimize: false },
        { Mode: "RGB", Color: [1, 2, 3], Progressive: false, Optimize: false, Dpi: [300, 150] },
        { Mode: "RGB", Color: [1, 2, 3], Progressive: false, Optimize: false, Subsampling: 2 },
        { Mode: "CMYK", Color: [1, 2, 3, 4], Progressive: false, Optimize: false },
        { Mode: "CMYK", Color: [1, 2, 3, 4], Progressive: true, Optimize: false }
    ]
    for index, testCase in cases {
        source := Pillow.Image.New(testCase.Mode, [16, 16], testCase.Color)
        path := PillowTestTempJpegPath("extra-options-" index)
        loaded := 0
        try {
            options := { quality: 75, extra: extra }
            if testCase.Progressive
                options.progressive := true
            if testCase.Optimize
                options.optimize := true
            if testCase.HasOwnProp("Dpi")
                options.dpi := testCase.Dpi
            if testCase.HasOwnProp("Subsampling")
                options.subsampling := testCase.Subsampling
            source.Save(path, "JPEG", options)
            PillowTestAssertJpegExtraMarkerStream(path)
            loaded := Pillow.Image.Open(path, ["JPEG"])
            AhkTest.AssertEqual(testCase.Mode, loaded.Mode)
        } finally {
            if IsObject(loaded)
                loaded.Close()
            PillowTestDeleteFile(path)
            source.Close()
        }
    }
}

AhkTest.Test("Pillow Image.Save JPEG extra marker stream batches native modes and codec options", PillowTestImageSaveJpegExtraMarkerStreamOptions)

PillowTestImageSaveJpegCommentAndExtraMarkerStream(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    source := Pillow.Image.New("RGB", [16, 16], [1, 2, 3])
    path := PillowTestTempJpegPath("comment-extra-marker-stream")
    loaded := 0
    try {
        extra := PillowTestBuffer([
            0xFF, 0xED, 0x00, 0x08, 0x54, 0x45, 0x53, 0x54, 0x01, 0x02,
            0xFF, 0xFE, 0x00, 0x08, 0x45, 0x58, 0x54, 0x52, 0x41, 0x21
        ])
        source.Save(path, "JPEG", { comment: "COMMENT", extra: extra })

        bytes := PillowTestReadFileBytes(path)
        app13 := PillowTestFindJpegSegment(bytes, 0xED)
        comments := PillowTestFindJpegSegments(bytes, 0xFE)
        dqt := PillowTestFindJpegSegment(bytes, 0xDB)
        AhkTest.AssertTrue(app13.Found)
        AhkTest.AssertEqual(2, comments.Length)
        AhkTest.AssertTrue(dqt.Found)
        AhkTest.AssertEqual([0x54, 0x45, 0x53, 0x54, 0x01, 0x02],
            PillowTestArraySlice(bytes, app13.PayloadOffset,
                app13.PayloadOffset + app13.PayloadLength - 1))
        AhkTest.AssertEqual([0x45, 0x58, 0x54, 0x52, 0x41, 0x21],
            PillowTestArraySlice(bytes, comments[1].PayloadOffset,
                comments[1].PayloadOffset + comments[1].PayloadLength - 1))
        AhkTest.AssertEqual([0x43, 0x4F, 0x4D, 0x4D, 0x45, 0x4E, 0x54],
            PillowTestArraySlice(bytes, comments[2].PayloadOffset,
                comments[2].PayloadOffset + comments[2].PayloadLength - 1))
        AhkTest.AssertTrue(app13.MarkerOffset < comments[1].MarkerOffset)
        AhkTest.AssertTrue(comments[1].MarkerOffset < comments[2].MarkerOffset)
        AhkTest.AssertTrue(comments[2].MarkerOffset < dqt.MarkerOffset)

        loaded := Pillow.Image.Open(path, ["JPEG"])
        AhkTest.AssertEqual("RGB", loaded.Mode)
        AhkTest.AssertEqual([16, 16], loaded.Size)
    } finally {
        if IsObject(loaded)
            loaded.Close()
        PillowTestDeleteFile(path)
        source.Close()
    }
}

