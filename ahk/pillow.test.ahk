PillowTestImageSaveJpegCmykRestartMarkersComposeBlockAndRowIntervals(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    values := []
    loop 16 {
        y := A_Index - 1
        loop 32 {
            x := A_Index - 1
            blockIndex := Floor(y / 8) * 4 + Floor(x / 8)
            values.Push(Mod(blockIndex * 23 + 5, 256))
            values.Push(Mod(blockIndex * 37 + 17, 256))
            values.Push(Mod(blockIndex * 53 + 29, 256))
            values.Push(Mod(blockIndex * 71 + 43, 256))
        }
    }
    image := Pillow.Image.FromBytes("CMYK", [32, 16], PillowTestBuffer(values))
    blockPath := PillowTestTempJpegPath("restart-marker-blocks-cmyk")
    rowPath := PillowTestTempJpegPath("restart-marker-rows-cmyk")
    loadedImages := []
    try {
        image.Save(blockPath, "JPEG", { quality: 95, restart_marker_blocks: 3 })
        image.Save(rowPath, "JPEG", { quality: 95, restart_marker_rows: 1 })

        testCases := [
            { Path: blockPath, Dri: 3, RestartMarkers: [0xD0, 0xD1] },
            { Path: rowPath, Dri: 4, RestartMarkers: [0xD0] }
        ]
        for testCase in testCases {
            bytes := PillowTestReadFileBytes(testCase.Path)
            app14 := PillowTestFindJpegSegment(bytes, 0xEE, [65, 100, 111, 98, 101])
            dqt := PillowTestFindJpegSegment(bytes, 0xDB)
            sof0 := PillowTestFindJpegSegment(bytes, 0xC0)
            dht := PillowTestFindJpegSegment(bytes, 0xC4)
            dri := PillowTestFindJpegSegment(bytes, 0xDD)
            AhkTest.AssertTrue(app14.Found)
            AhkTest.AssertTrue(dqt.Found)
            AhkTest.AssertTrue(sof0.Found)
            AhkTest.AssertTrue(dht.Found)
            AhkTest.AssertTrue(dri.Found)
            AhkTest.AssertTrue(app14.MarkerOffset < dqt.MarkerOffset)
            AhkTest.AssertTrue(dqt.MarkerOffset < sof0.MarkerOffset)
            AhkTest.AssertTrue(sof0.MarkerOffset < dht.MarkerOffset)
            AhkTest.AssertTrue(dht.MarkerOffset < dri.MarkerOffset)
            AhkTest.AssertEqual(0, bytes[app14.PayloadOffset + 11])
            dqtPayloads := PillowTestReadJpegDqtPayloads(testCase.Path)
            AhkTest.AssertEqual(1, dqtPayloads.Length)
            AhkTest.AssertEqual(0, dqtPayloads[1].TableId)
            AhkTest.AssertEqual([67, 1, 1, 0, 77, 1, 1, 0, 89, 1, 1, 0, 75, 1, 1, 0],
                PillowTestReadJpegSof0Sampling(testCase.Path))
            AhkTest.AssertEqual([29, 179], PillowTestReadJpegDhtPayloadLengths(testCase.Path))
            AhkTest.AssertEqual(testCase.Dri, PillowTestReadBe16(bytes, dri.PayloadOffset))
            AhkTest.AssertEqual(testCase.RestartMarkers, PillowTestReadJpegRestartMarkers(testCase.Path))
            AhkTest.AssertEqual(1, PillowTestCountJpegSos(testCase.Path))

            loaded := Pillow.Image.Open(testCase.Path, ["JPEG"])
            loadedImages.Push(loaded)
            AhkTest.AssertEqual("CMYK", loaded.Mode)
            AhkTest.AssertEqual([32, 16], loaded.Size)
            AhkTest.AssertEqual(values, PillowTestBufferToArray(loaded.ToBytes()))
        }
    } finally {
        for loaded in loadedImages
            loaded.Close()
        PillowTestDeleteFile(rowPath)
        PillowTestDeleteFile(blockPath)
        image.Close()
    }
}

AhkTest.Test("Pillow Image.Save JPEG CMYK restart markers compose block and row intervals", PillowTestImageSaveJpegCmykRestartMarkersComposeBlockAndRowIntervals)

