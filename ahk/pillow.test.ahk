PillowTestMakeInvertLut(channelCount) {
    lut := []
    loop channelCount {
        loop 256
            lut.Push(256 - A_Index)
    }
    return lut
}

PillowTestMakeIdentityLut(channelCount) {
    lut := []
    loop channelCount {
        loop 256
            lut.Push(A_Index - 1)
    }
    return lut
}

PillowTestConstantArray(count, value) {
    items := []
    loop count
        items.Push(value)
    return items
}

