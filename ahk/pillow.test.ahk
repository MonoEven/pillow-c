        xmpBytes := PillowTestTextBytes(xmp)
        pngInfo := Pillow.PngImagePlugin.PngInfo()
        pngInfo.add_itxt("XML:com.adobe.xmp", xmp)

        pngSource := Pillow.Image.New("RGB", [1, 1], [1, 2, 3])
        jpegSource := Pillow.Image.New("RGB", [1, 1], [1, 2, 3])
