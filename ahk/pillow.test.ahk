PillowTestImagePasteMaskedMatchesPillowNumericStorageBytes(*) {
    Pillow.Configure({ DllPath: PillowTestDllPath() })
    maskBytes := [0, 64, 128, 192, 255, 32]
    mask := Pillow.Image.FromBytes("L", [3, 2], PillowTestBuffer(maskBytes))
    try {
        cases := [
            {
                Mode: "I",
                Source: PillowTestBytesFromI32([1000, -1000, 300000, -300000, 5, 123456789]),
                Target: PillowTestBytesFromI32([-2000, 2000, -100000, 100000, 6, -123456789]),
                Expected: "30f8ffffa2444040a086817f4072bdc005000000d0459bda",
            },
            {
                Mode: "F",
                Source: PillowTestBytesFromF32([1.25, -2.5, 100.0, -100.0, 5.5, -6.25]),
                Target: PillowTestBytesFromF32([-3.75, 4.5, -50.0, 50.0, -7.5, 8.25]),
                Expected: "000070c000007460000088820000a8a20000b04000001d51",
            },
        ]
        for item in cases {
            source := Pillow.Image.FromBytes(item.Mode, [3, 2], PillowTestBuffer(item.Source))
            target := Pillow.Image.FromBytes(item.Mode, [3, 2], PillowTestBuffer(item.Target))
            try {
                targetData := target.DataPointer().Ptr

                target.Paste(source, [0, 0], mask)

                AhkTest.AssertEqual(targetData, target.DataPointer().Ptr)
                AhkTest.AssertEqual(item.Mode, target.Mode)
                AhkTest.AssertEqual([3, 2], target.Size)
                AhkTest.AssertEqual(item.Expected, PillowTestBytesHex(PillowTestBufferToArray(target.ToBytes())))
                AhkTest.AssertEqual(item.Source, PillowTestBufferToArray(source.ToBytes()))
                AhkTest.AssertEqual(maskBytes, PillowTestBufferToArray(mask.ToBytes()))
            } finally {
                target.Close()
                source.Close()
            }
        }
    } finally {
        mask.Close()
    }
}

