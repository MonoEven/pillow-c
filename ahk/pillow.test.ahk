        0, 0, 0, 63,
        0, 0, 128, 63,
        205, 204, 254, 66,
        0, 0, 255, 66,
        0, 128, 0, 67,
        0, 128, 126, 67,
        0, 0, 127, 67,
        0, 128, 127, 67,
        0, 0, 122, 68,
        0, 0, 192, 127,
        0, 0, 128, 255,
        0, 0, 128, 127,
    ]))
    emptyI := Pillow.Image.New("I", [0, 1])
    emptyF := Pillow.Image.New("F", [0, 1])
    outputs := []
    try {
