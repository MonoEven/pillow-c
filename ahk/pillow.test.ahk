        AhkTest.AssertEqual([0, 10, 0, 20, 0, 30], PillowTestArraySlice(bytes, trns.DataOffset, trns.DataOffset + 5))
        AhkTest.AssertEqual([0x78, 0xDA], PillowTestArraySlice(bytes, idat.DataOffset, idat.DataOffset + 1))
