PillowTestTiffStripWithSubIfdBytes() {
    ; Classic little-endian strip TIFF 2x2 mode-L with IFD0 ExifIFD (34665)
    ; and GPSInfo (34853) sub-IFD pointers, mirroring
    ; oracle/probe_tiff_subifd.py: IFD0 at 8 (11 entries), strip at 146,
    ; Exif sub-IFD at 150, GPS sub-IFD at 192, blobs from 234.
    bytes := [73, 73, 42, 0]
    PillowTestAppendLe32(bytes, 8)
    entries := [
        [256, 4, 1, 2],
        [257, 4, 1, 2],
        [258, 3, 1, 8],
        [259, 3, 1, 1],
        [262, 3, 1, 1],
        [273, 4, 1, 146],
        [277, 3, 1, 1],
        [278, 4, 1, 2],
        [279, 4, 1, 4],
        [34665, 4, 1, 150],
        [34853, 4, 1, 192],
    ]
    PillowTestAppendLe16(bytes, entries.Length)
    for entry in entries {
        PillowTestAppendLe16(bytes, entry[1])
        PillowTestAppendLe16(bytes, entry[2])
