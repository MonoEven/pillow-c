            AhkTest.AssertTrue(preB.Found)
            AhkTest.AssertTrue(exifChunk.Found)
            AhkTest.AssertTrue(lateC.Found)
            AhkTest.AssertTrue(lateD.Found)
            AhkTest.AssertTrue(idat.Found)
            AhkTest.AssertTrue(iend.Found)
