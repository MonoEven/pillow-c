                [120, 156, 1, 8, 0, 247, 255, 1, 0, 255, 0, 0, 1, 52, 18, 6, 135, 1, 72],
                [120, 156, 1, 8, 0, 247, 255, 184, 11, 160, 15, 136, 19, 112, 23, 13, 112, 2, 149],
            ],
        },
    ]
    for order in orders {
        first := Pillow.Image.FromBytes(order.Modes[1], [2, 2], PillowTestBuffer(order.Source[1]))
        second := Pillow.Image.FromBytes(order.Modes[2], [2, 2], PillowTestBuffer(order.Source[2]))
        try {
            for testCase in cases {
                path := PillowTestTempTiffPath(
                    "save-all-mixed-i16-" order.Name "-" testCase.Name "-dpi"
                )
                loaded := 0
