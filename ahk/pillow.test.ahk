            paths.Push(path)
            pngInfo := Pillow.PngImagePlugin.PngInfo()
            pngInfo.add(PillowTestBuffer([0x63, 0x48, 0x52, 0x4D]), PillowTestBuffer(chrmPayload))
            configure := item.Configure
            configure(pngInfo)

