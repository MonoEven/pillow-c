        dqt := PillowTestFindJpegSegment(rgbBytes, 0xDB)
        dri := PillowTestFindJpegSegment(rgbBytes, 0xDD)
        segments := [
            { Name: "JFIF", Segment: jfif },
            { Name: "EXIF", Segment: exifSegment },
            { Name: "XMP", Segment: xmpSegment },
            { Name: "ICC", Segment: iccSegment },
            { Name: "COM", Segment: commentSegment },
            { Name: "DQT", Segment: dqt },
            { Name: "DRI", Segment: dri },
        ]
        for item in segments {
            if !item.Segment.Found
                AhkTest.Fail("Missing JPEG segment: " item.Name)
        }
        AhkTest.AssertTrue(jfif.MarkerOffset < exifSegment.MarkerOffset)
        AhkTest.AssertTrue(exifSegment.MarkerOffset < xmpSegment.MarkerOffset)
        AhkTest.AssertTrue(xmpSegment.MarkerOffset < iccSegment.MarkerOffset)
        AhkTest.AssertTrue(iccSegment.MarkerOffset < commentSegment.MarkerOffset)
