    Pillow.Configure({ DllPath: PillowTestDllPath() })
    sourceValues := [
        0, 0, 0,
        255, 255, 255,
        255, 0, 0,
        0, 255, 0,
        0, 0, 255,
        12, 34, 56
    ]
    source := Pillow.Image.FromBytes("RGB", [3, 2], PillowTestBuffer(sourceValues))
    source.Info["sentinel"] := "keep"
    secondSource := Pillow.Image.FromBytes("RGB", [1, 1], PillowTestBuffer([12, 34, 56]))
    srgb := Pillow.ImageCms.createProfile("sRGB")
    lab := Pillow.ImageCms.createProfile("LAB")
    transform := 0
    firstResult := 0
    secondResult := 0
    try {
        transform := Pillow.ImageCms.buildTransform(srgb, lab, "RGB", "LAB")
        srgb.Close()
        lab.Close()

        AhkTest.AssertTrue(transform is Pillow.ImageCms.ImageCmsTransform)
        AhkTest.AssertEqual("RGB", transform.InputMode)
        AhkTest.AssertEqual("LAB", transform.OutputMode)
        AhkTest.AssertEqual("RGB", transform.input_mode)
        AhkTest.AssertEqual("LAB", transform.output_mode)

        firstResult := Pillow.ImageCms.applyTransform(source, transform)
        secondResult := Pillow.ImageCms.applyTransform(secondSource, transform)
        AhkTest.AssertEqual(
            [0, 0, 0, 255, 0, 0, 138, 81, 70, 224, 177, 81, 75, 68, 144, 32, 254, 239],
            PillowTestBufferToArray(firstResult.ToBytes())
        )
        AhkTest.AssertEqual([32, 254, 239], PillowTestBufferToArray(secondResult.ToBytes()))
        AhkTest.AssertEqual(sourceValues, PillowTestBufferToArray(source.ToBytes()))
        AhkTest.AssertEqual("keep", source.Info["sentinel"])
        for result in [firstResult, secondResult] {
            AhkTest.AssertEqual(1, result.Info.Count)
            iccProfile := result.Info["icc_profile"]
            AhkTest.AssertTrue(iccProfile is Buffer)
            AhkTest.AssertEqual(572, iccProfile.Size)
            AhkTest.AssertEqual("acsp", StrGet(iccProfile.Ptr + 36, 4, "CP0"))
        }

        transform.Close()
        closedError := ""
        try {
            Pillow.ImageCms.applyTransform(source, transform)
        } catch Error as err {
            closedError := err.Message
        }
        AhkTest.AssertEqual("Pillow.ImageCms transform is closed", closedError)
        transform.Close()
    } finally {
        if IsObject(secondResult)
            secondResult.Close()
        if IsObject(firstResult)
            firstResult.Close()
        if IsObject(transform)
            transform.Close()
        if lab.Handle
            lab.Close()
        if srgb.Handle
            srgb.Close()
        secondSource.Close()
        source.Close()
    }
}

