            icc_profile: PillowTestBuffer(iccProfile),
            exif: PillowTestBuffer(exif),
            xmp: PillowTestBuffer(xmp)
        })

        rgbBytes := PillowTestReadFileBytes(rgbPath)
        jfif := PillowTestFindJpegSegment(rgbBytes, 0xE0, [0x4A, 0x46, 0x49, 0x46, 0])
        exifSegment := PillowTestFindJpegSegment(rgbBytes, 0xE1, [0x45, 0x78, 0x69, 0x66, 0, 0])
        xmpHeader := PillowTestTextBytes("http://ns.adobe.com/xap/1.0/")
        xmpHeader.Push(0)
        xmpSegment := PillowTestFindJpegSegment(rgbBytes, 0xE1, xmpHeader)
        iccSegment := PillowTestFindJpegSegment(rgbBytes, 0xE2, [0x49, 0x43, 0x43, 0x5F, 0x50, 0x52, 0x4F, 0x46, 0x49, 0x4C, 0x45, 0])
